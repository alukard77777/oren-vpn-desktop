# English interface of MULTICORE.
#
# The source language is Russian: every msgid is the exact Russian text of the app (Slint
# `@tr("…")` and Rust `tr!("…")`), every msgstr its English text. Placeholders follow Slint:
# `{}` next argument, `{0}` positional, `{n}` plural count.
msgid ""
msgstr ""
"Project-Id-Version: multicore-desktop\n"
"Language: en\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "Выбран провайдером подписки"
msgstr "Set by your subscription provider"

# Desktop messages built in Rust (daemon client, updater, log archive, troubleshooting, tray)
msgid "Проверьте настройки подключения к фоновому сервису."
msgstr "Check the background service connection settings."

msgid "Файлы приложения повреждены или отсутствуют. Распакуйте пакет заново."
msgstr "App files are damaged or missing. Unpack the package again."

msgid "Не удалось безопасно подготовить запуск фонового сервиса."
msgstr "Couldn't safely prepare the background service."

msgid "Не удалось запустить фоновый сервис."
msgstr "Couldn't start the background service."

msgid "Фоновый сервис запустился некорректно."
msgstr "The background service failed to start."

msgid "Фоновый сервис не прошёл проверку подлинности."
msgstr "The background service failed authentication."

msgid "В буфере обмена нет ссылки"
msgstr "No link in the clipboard"

msgid "Ссылка из буфера слишком длинная"
msgstr "The copied link is too long"

msgid "Не удалось прочитать буфер обмена"
msgstr "Couldn't read the clipboard"

msgid "Каталог маршрутов изменился."
msgstr "The route list has changed."

msgid "Фоновый сервис ответил ошибкой (HTTP {})."
msgstr "Background service error (HTTP {})."

msgid "Обновление подписки недоступно."
msgstr "Subscription refresh unavailable."

msgid "Диагностика недоступна."
msgstr "Diagnostics unavailable."

msgid "Журнал службы недоступен."
msgstr "Service log unavailable."

msgid "Панель Mihomo недоступна."
msgstr "Dashboard unavailable."

msgid "Данные сессии недоступны."
msgstr "Session data unavailable."

msgid "Служба MULTICORE недоступна."
msgstr "MULTICORE service unavailable."

msgid "Устранение неполадок недоступно."
msgstr "Troubleshooting is unavailable."

msgid "Проверка задержки недоступна."
msgstr "Latency check is unavailable."

msgid "Значок группы недоступен."
msgstr "Group icon unavailable."

msgid "Служба не смогла установить обновление."
msgstr "The service couldn't install the update."

msgid "Подписка не найдена. Обновите список подписок."
msgstr "Subscription not found. Refresh the list."

msgid "Сейчас подписку изменить нельзя."
msgstr "Can't change the subscription now."

msgid "Изменение могло сохраниться. Обновляем состояние подписок."
msgstr "The change may have been saved. Refreshing subscriptions."

msgid "Фоновый сервис не смог изменить подписку."
msgstr "Couldn't change the subscription."

msgid "Не удалось проверить задержку."
msgstr "Couldn't check latency."

msgid "Фоновый сервис отклонил проверку задержки."
msgstr "Latency check was rejected."

msgid "Некорректный адрес фонового сервиса."
msgstr "Invalid background service address."

msgid "Не удалось прочитать ответ фонового сервиса."
msgstr "Couldn't read the background service's response."

msgid "Фоновый сервис вернул некорректный ответ."
msgstr "Background service sent an invalid reply."

msgid "Ответ фонового сервиса превышает допустимый размер."
msgstr "The background service's response is too large."

msgid "Отключитесь перед изменением подписки."
msgstr "Disconnect before editing subscriptions."

msgid "Достигнут предел: не больше 16 подписок. Удалите ненужную и повторите."
msgstr "Limit reached: up to 16 subscriptions. Delete one and try again."

msgid "Сервер подписки недоступен. Проверьте подключение к интернету и повторите попытку."
msgstr "The subscription server is unreachable. Check your internet connection and try again."

msgid "Сервер подписки не ответил вовремя. Повторите попытку чуть позже."
msgstr "The subscription server timed out. Try again a bit later."

msgid "Сертификат сервера подписки не принят. Проверьте ссылку или обратитесь к провайдеру."
msgstr "The subscription server's certificate was rejected. Check the link or contact your provider."

msgid "Сервер подписки перенаправил запрос небезопасно или слишком много раз."
msgstr "The subscription server redirected insecurely or too many times."

msgid "Сервер подписки отказал в доступе. Проверьте ссылку и срок действия подписки."
msgstr "The subscription server denied access. Check the link and expiry date."

msgid "Подписка не найдена. Проверьте, что ссылка скопирована полностью."
msgstr "Subscription not found. Make sure the whole link was copied."

msgid "Сервер подписки временно ограничил запросы. Повторите попытку через минуту."
msgstr "The subscription server is rate-limiting requests. Try again in a minute."

msgid "Сервер подписки временно не работает. Повторите попытку позже."
msgstr "The subscription server is temporarily down. Try again later."

msgid "Сервер подписки ответил ошибкой."
msgstr "Subscription server error."

msgid "По ссылке пришла веб-страница или список ссылок, а не подписка MULTICORE. Скопируйте ссылку подписки для приложения у провайдера."
msgstr "The link returned a web page or a list of links, not a MULTICORE subscription. Copy the app subscription link from your provider."

msgid "Провайдер прислал повреждённую или неподдерживаемую конфигурацию."
msgstr "The provider sent a damaged or unsupported configuration."

msgid "Ответ сервера подписки слишком большой."
msgstr "Subscription server response too large."

msgid "Не удалось сохранить подписку на диск. Проверьте свободное место."
msgstr "Couldn't save the subscription to disk. Check free space."

msgid "Подписка загружена, но подготовить её к запуску не удалось. Проверьте сетевое подключение."
msgstr "The subscription downloaded but couldn't be prepared. Check your network connection."

msgid "Подключитесь, чтобы открыть панель Mihomo."
msgstr "Connect to open the Mihomo dashboard."

msgid "Панель Mihomo недоступна в этой сборке."
msgstr "The dashboard isn't in this build."

msgid "MULTICORE уже запущен у другого пользователя."
msgstr "MULTICORE is already running for another user."

msgid "Подключение отменено: не выдано разрешение администратора."
msgstr "Connection cancelled: administrator permission was not granted."

# Daemon messages (multicore_i18n::daemon_messages).
msgid "Запускается подключение."
msgstr "Connecting."

msgid "Запускается подключение. Подтвердите права администратора в системном окне."
msgstr "Connecting. Confirm administrator rights in the system prompt."

msgid "Включается туннель…"
msgstr "Starting tunnel…"

msgid "Подключение установлено."
msgstr "Connected."

msgid "Запуск подключения завершился ошибкой."
msgstr "Connection failed to start."

msgid "Запуск подключения был прерван."
msgstr "Connection start was interrupted."

msgid "Подключение прервано. Выполните отключение для очистки."
msgstr "Connection interrupted. Disconnect to clean up."

msgid "Не удалось полностью отменить запуск. Выполните отключение для очистки."
msgstr "Couldn't fully cancel the start. Disconnect to clean up."

msgid "Состояние процессов неизвестно. Выполните отключение для очистки."
msgstr "Process state unknown. Disconnect to clean up."

msgid "Не удалось подготовить сетевой интерфейс и адреса узлов."
msgstr "Couldn't prepare the network interface and server addresses."

msgid "Подготовка конфигурации перед подключением завершилась ошибкой."
msgstr "Preparing the configuration before connecting failed."

msgid "Прогретая конфигурация не подошла, запуск подготовлен заново."
msgstr "The warm configuration didn't fit; the start was prepared again."

msgid "Не удалось активировать конфигурацию запуска."
msgstr "Couldn't activate the startup configuration."

msgid "Активация конфигурации перед подключением завершилась ошибкой."
msgstr "Activating the configuration before connecting failed."

msgid "Подготовка к подключению отложена до подключения."
msgstr "Preparation is postponed until you connect."

msgid "Подключение остановлено."
msgstr "Disconnected."

msgid "Не удалось полностью остановить подключение. Повторите попытку."
msgstr "Couldn't fully stop the connection. Try again."

msgid "Остановка подключения завершилась ошибкой."
msgstr "Disconnecting failed."

msgid "Ядра не удалось запустить заранее. Они запустятся при подключении."
msgstr "The cores couldn't start in advance. They'll start when you connect."

msgid "Служба MULTICORE потеряла ядра — подключение разорвано. Подключитесь снова."
msgstr "The MULTICORE service lost its cores — disconnected. Connect again."

msgid "Служба MULTICORE недоступна — права администратора будут запрошены при подключении."
msgstr "MULTICORE service unavailable — admin rights will be requested on connect."

msgid "Подписка переключена."
msgstr "Subscription switched."

msgid "Не удалось сохранить изменение подписки."
msgstr "Couldn't save the subscription change."

msgid "Маршрут Mihomo изменён."
msgstr "Mihomo route changed."

msgid "Mihomo не применил выбор маршрута."
msgstr "Mihomo didn't apply the route choice."

msgid "Устранение неполадок: {0}; ошибок: {1}."
msgstr "Troubleshooting: {0}; errors: {1}."

msgid "Не удалось запустить службу подключения с правами администратора."
msgstr "Couldn't start the connection service as administrator."

msgid "Служба подключения не ответила. Повторите попытку."
msgstr "The connection service didn't respond. Try again."

msgid "Не удалось запустить ядро. Подробности — в логе на странице «Состояние»."
msgstr "Couldn't start a core. See the log on the Status page."

msgid "Не удалось запустить ядро: файл не найден или заблокирован. Проверьте карантин антивируса и переустановите MULTICORE."
msgstr "Couldn't start a core: the file is missing or blocked. Check your antivirus quarantine and reinstall MULTICORE."

msgid "Ядро завершилось сразу после запуска. Причина — в логе на странице «Состояние»."
msgstr "A core exited right after starting. See the log on the Status page."

msgid "Ядро не успело запуститься вовремя. Повторите попытку."
msgstr "A core didn't start in time. Try again."

msgid "Не удалось включить TUN-адаптер. Повторите попытку; если не поможет — перезагрузите компьютер или подключитесь без TUN."
msgstr "Couldn't enable the TUN adapter. Try again; if that fails, restart your computer or connect without TUN."

msgid "TUN-адаптер не включился вовремя. Повторите попытку; если не поможет — перезагрузите компьютер или подключитесь без TUN."
msgstr "The TUN adapter didn't come up in time. Try again; if that fails, restart your computer or connect without TUN."

msgid "Не удалось включить системный прокси. Повторите попытку."
msgstr "Couldn't enable the system proxy. Try again."

msgid "Не удалось запустить {0}. Подробности — в логе на странице «Состояние»."
msgstr "Couldn't start {0}. See the log on the Status page."

msgid "Не удалось запустить {0}: файл ядра не найден или заблокирован. Проверьте карантин антивируса и переустановите MULTICORE."
