import { LineEdit, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { PrimaryAction, QuietChip, RouteNodeRow } from "components.slint";
import "../assets/fonts/Twemoji.Mozilla.ttf";
export { TrayPopup, TrayMenuRow } from "tray_popup.slint";

export struct UiEvent {
    timestamp: string,
    component: string,
    level: string,
    message: string,
}

export struct UiCatalogGroup {
    id: string,
    icon: string,
    label: string,
    selected: bool,
}

export struct UiCatalogNode {
    id: string,
    icon: string,
    label: string,
    selected: bool,
    latency-text: string,
    latency-tone: string,
}

export struct UiProxyMapping {
    proxy-name: string,
    address: string,
    xray-label: string,
}

export struct UiSubscriptionProfile {
    id: string,
    title: string,
    usage: string,
    expiry: string,
    active: bool,
    available: bool,
    has-logo: bool,
    logo: image,
    fallback: string,
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <image> icon-source;
    in property <bool> active;
    in property <bool> enabled: true;
    callback activated();

    height: 44px;
    background: root.active ? Theme.elevated : nav-touch.has-hover ? #ffffff08 : transparent;
    border-radius: 8px;
    border-width: nav-focus.has-focus ? 2px : 0px;
    border-color: Theme.focus;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.activated(); } }

    Rectangle {
        x: 0;
        y: 10px;
        width: 3px;
        height: 24px;
        border-radius: 2px;
        background: root.active ? Theme.accent-blue : transparent;
    }

    Image {
        x: 16px;
        y: 12px;
        width: 20px;
        height: 20px;
        source: root.icon-source;
        image-fit: contain;
    }

    Text {
        x: 48px;
        width: parent.width - 60px;
        height: parent.height;
        text: root.label;
        color: root.active ? Theme.text-primary : Theme.text-secondary;
        font-family: Theme.font-family;
        font-size: Theme.type-label-size;
        font-weight: root.active ? Theme.weight-semibold : Theme.weight-regular;
        vertical-alignment: center;
    }

    nav-focus := FocusScope {
        enabled: root.enabled;
        focus-on-click: true;
        focus-on-tab-navigation: true;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.activated();
                return accept;
            }
            return reject;
        }
        nav-touch := TouchArea { enabled: root.enabled; clicked => { root.activated(); } }
    }
}

component SmallAction inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> selected: false;
    in property <int> focus-epoch: 0;
    callback activated();

    changed focus-epoch => {
        if (root.focus-epoch > 0) {
            small-focus.focus();
        }
    }

    min-width: 88px;
    preferred-width: small-label.preferred-width + 28px;
    max-width: 160px;
    horizontal-stretch: 0;
    height: 44px;
    background: root.selected ? #4c9dff18 : root.enabled ? (small-touch.pressed ? Theme.elevated : small-touch.has-hover ? #ffffff0d : transparent) : transparent;
    border-color: small-focus.has-focus ? Theme.focus : root.selected ? #4c9dff88 : Theme.line;
    border-width: small-focus.has-focus ? 2px : 1px;
    border-radius: 8px;
    opacity: root.enabled ? 1 : 0.45;
    accessible-role: button;
    accessible-label: root.label;
    accessible-description: root.selected ? "Выбранный фильтр" : "";
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.activated(); } }

    small-label := Text {
        text: root.label;
        color: root.selected ? Theme.text-primary : Theme.text-secondary;
        font-family: Theme.font-family;
        font-size: Theme.type-metadata-size;
        font-weight: Theme.weight-semibold;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    small-focus := FocusScope {
        enabled: root.enabled;
        focus-on-click: true;
        focus-on-tab-navigation: true;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.activated();
                return accept;
            }
            return reject;
        }
        small-touch := TouchArea { enabled: root.enabled; clicked => { root.activated(); } }
    }
}

component SettingsNavItem inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    callback activated();

    height: 44px;
    background: root.selected ? #4c9dff0c : nav-touch.has-hover ? #ffffff06 : transparent;
    border-radius: 8px;
    if root.selected: Rectangle { x: 0px; y: 10px; width: 3px; height: 24px; border-radius: 2px; background: Theme.accent-blue; }
    Text { x: 12px; width: parent.width - 20px; height: parent.height; text: root.label; color: root.selected ? Theme.text-primary : Theme.text-secondary; font-size: Theme.type-metadata-size; font-weight: root.selected ? Theme.weight-semibold : Theme.weight-regular; vertical-alignment: center; overflow: elide; }
    nav-focus := FocusScope {
        focus-on-click: true; focus-on-tab-navigation: true;
        accessible-role: button; accessible-label: root.label; accessible-description: root.selected ? "Выбрано" : "";
        accessible-action-default => { root.activated(); }
        Rectangle { x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px; border-radius: 8px; border-color: parent.has-focus ? Theme.focus : transparent; border-width: parent.has-focus ? 1px : 0px; background: transparent; }
        key-pressed(event) => { if (event.text == " " || event.text == "\n") { root.activated(); return accept; } return reject; }
        nav-touch := TouchArea { clicked => { root.activated(); } }
    }
}

component HealthRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> tone;

    height: 46px;
    background: transparent;
    border-color: Theme.line;
    border-width: 0px;

    Rectangle {
        x: 0;
        y: 19px;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: root.tone == "success" ? Theme.accent-green : root.tone == "danger" ? Theme.error : root.tone == "warning" ? Theme.warning : Theme.text-muted;
    }
    Text {
        x: 20px;
        width: parent.width - 140px;
        height: parent.height;
        text: root.label;
        color: Theme.text-primary;
        font-family: Theme.font-family;
        font-size: Theme.type-label-size;
        vertical-alignment: center;
    }
    Text {
        x: parent.width - 120px;
        width: 120px;
        height: parent.height;
        text: root.value;
        color: Theme.text-secondary;
        font-family: Theme.font-family;
        font-size: Theme.type-metadata-size;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}

component ToggleRow inherits Rectangle {
    in property <string> label;
    in property <string> description;
    in property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);

    height: 64px;
    background: toggle-touch.has-hover && root.enabled ? #ffffff06 : transparent;
    border-radius: 8px;
    accessible-role: checkbox;
    accessible-label: root.label;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.toggled(!root.checked); } }

    Text {
        x: 0;
        y: 9px;
        width: parent.width - 72px;
        text: root.label;
        color: Theme.text-primary;
        font-family: Theme.font-family;
        font-size: Theme.type-label-size;
        font-weight: Theme.weight-semibold;
    }
    Text {
        x: 0;
        y: 33px;
        width: parent.width - 72px;
        text: root.description;
        color: Theme.text-muted;
        font-family: Theme.font-family;
        font-size: Theme.type-metadata-size;
        overflow: elide;
    }
    Rectangle {
        x: parent.width - 52px;
        y: 18px;
        width: 44px;
        height: 26px;
        border-radius: 13px;
        background: root.checked ? Theme.accent-blue : Theme.elevated;
        border-color: toggle-focus.has-focus ? Theme.focus : root.checked ? Theme.accent-blue : Theme.line;
        border-width: toggle-focus.has-focus ? 2px : 1px;
        Rectangle {
            x: root.checked ? 21px : 3px;
            y: 3px;
            width: 18px;
            height: 18px;
            border-radius: 9px;
            background: root.enabled ? Theme.text-primary : Theme.text-muted;
        }
    }
    toggle-focus := FocusScope {
        enabled: root.enabled;
        focus-on-click: true;
        focus-on-tab-navigation: true;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.toggled(!root.checked);
                return accept;
            }
            return reject;
        }
        toggle-touch := TouchArea { enabled: root.enabled; clicked => { root.toggled(!root.checked); } }
    }
}

component TitleBarButton inherits Rectangle {
    in property <string> kind;
    in property <string> state-label;
    in property <bool> enabled: true;
    callback activated();

    width: 44px;
    height: 44px;
    background: title-touch.pressed
        ? (root.kind == "close" ? #b52b38 : #ffffff16)
        : title-touch.has-hover
            ? (root.kind == "close" ? #c42b3a : #ffffff0d)
            : transparent;
    border-width: title-focus.has-focus ? 2px : 0px;
    border-color: Theme.focus;
    accessible-role: button;
    accessible-label: root.state-label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.activated(); } }

    if root.kind == "minimize": Rectangle {
        x: 17px;
        y: 22px;
        width: 10px;
        height: 1px;
        background: Theme.text-secondary;
    }

    if root.kind == "maximize": Rectangle {
        x: 17px;
        y: 17px;
        width: 10px;
        height: 10px;
        background: transparent;
        border-width: 1px;
        border-color: Theme.text-secondary;
    }

    if root.kind == "restore": Rectangle {
        x: 16px;
        y: 18px;
        width: 9px;
        height: 8px;
        background: transparent;
        border-width: 1px;
        border-color: Theme.text-secondary;
        Rectangle {
            x: 2px;
            y: -3px;
            width: 9px;
            height: 8px;
            background: #0a0c0f;
            border-width: 1px;
            border-color: Theme.text-secondary;
        }
    }

    if root.kind == "close": Image {
        x: 16px;
        y: 16px;
        width: 12px;
        height: 12px;
        source: @image-url("../assets/close.svg");
        image-fit: contain;
    }

    title-focus := FocusScope {
        enabled: root.enabled;
        focus-on-click: true;
        focus-on-tab-navigation: true;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.activated();
                return accept;
            }
            return reject;
        }
        title-touch := TouchArea { enabled: root.enabled; clicked => { root.activated(); } }
    }
}

export component AppWindow inherits Window {
    title: "MultiCore";
    icon: @image-url("../assets/app-icon.svg");
    no-frame: true;
    preferred-width: 840px;
    preferred-height: 720px;
    min-width: 700px;
    min-height: 620px;
    background: Theme.canvas;
    default-font-family: Theme.font-family;

    in property <string> status-eyebrow: "Профиль не добавлен";
    in property <string> headline: "Добавьте подписку";
    in property <string> supporting: "Вставьте URL — остальное настроим автоматически.";
    in property <string> node-name: "Маршрут не выбран";
    in property <bool> has-profile: false;
    in property <bool> state-busy: false;
    in property <string> primary-label: "Подключить";
    in property <bool> primary-enabled: false;
    in property <string> status-label: "Готово";
    in property <string> status-tone: "neutral";
    in property <bool> import-pending: false;
    in property <string> import-error;
    in property <string> subscription-title: "Подписка";
    in property <string> subscription-usage: "Нет данных";
    in property <string> subscription-expiry: "Добавьте ссылку";
    in property <string> subscription-updated: "Не обновлялась";
    in property <bool> subscription-updated-stale: false;
    in property <image> service-logo;
    in property <bool> has-service-logo: false;
    in property <string> subscription-announcement-text;
    in property <string> subscription-announcement-tone: "info";
    in property <bool> subscription-refresh-available: false;
    in property <bool> subscription-refresh-enabled: false;
    in property <bool> subscription-refresh-pending: false;
    in property <string> subscription-refresh-error;
    in property <[UiSubscriptionProfile]> subscription-profiles;
    in property <bool> profile-menu-loading: false;
    in property <string> profile-menu-error;
    in property <string> profile-pending-operation: "none";
    in property <string> profile-pending-id;
    in property <string> active-panel: "none";
    in-out property <string> event-filter: "Все";
    in property <[UiEvent]> events;
    in property <[UiCatalogGroup]> catalog-groups;
    in property <[UiCatalogNode]> catalog-nodes;
    in property <bool> catalog-loading: false;
    in property <bool> catalog-selection-enabled: false;
    in property <bool> catalog-selection-pending: false;
    in property <bool> catalog-selection-queued: false;
    in property <string> catalog-error;
    in property <bool> latency-check-loading: false;
    in property <bool> latency-check-queued: false;
    in property <string> latency-check-error;
    in property <string> diagnostics-xray-value: "Остановлен";
    in property <string> diagnostics-xray-tone: "neutral";
    in property <string> diagnostics-mihomo-value: "Остановлен";
    in property <string> diagnostics-mihomo-tone: "neutral";
    in property <string> diagnostics-tun-value: "Остановлен";
    in property <string> diagnostics-tun-tone: "neutral";
    in property <bool> diagnostics-loading: false;
    in property <[UiProxyMapping]> diagnostic-mappings;
    in property <bool> launch-at-sign-in-enabled: false;
    in property <bool> launch-at-sign-in-stale: false;
    in property <string> launch-at-sign-in-error;
    in property <string> preference-error;
    in-out property <bool> ambient-background-enabled: true;
    in-out property <bool> shell-active: true;
    in property <bool> reduced-motion: false;
    in property <string> system-name: "Windows";
    private property <bool> ambient-wave-phase: false;
    private property <bool> ambient-wave-started: false;
    private property <bool> ambient-motion-active: root.ambient-background-enabled && root.shell-active && !root.reduced-motion && !root.minimized && root.visible-page == "home";
    in-out property <bool> replace-editor-open: false;
    in-out property <int> import-success-serial: 0;
    in property <bool> update-available: false;
    in property <bool> update-runtime-safe: false;
    in property <string> update-status: "MultiCore 0.1.2";
    in property <string> update-detail: "Канал обновлений не настроен";
    in property <string> update-action-label;
    in property <bool> update-action-enabled: false;
    in property <bool> update-busy: false;

    in-out property <string> local-page: "home";
    in-out property <string> settings-section: "general";
    in-out property <string> profile-edit-id;
    in-out property <string> profile-edit-draft;
    in-out property <string> profile-management-focus-id;
    in-out property <int> profile-management-focus-serial;
    in-out property <string> profile-delete-control-focus-id;
    in-out property <int> profile-delete-control-focus-serial;
    private property <string> visible-page: root.active-panel == "routes" ? "home" : root.active-panel == "events" ? "status" : root.local-page;
    private property <bool> profile-menu-open: root.active-panel == "subscription";
    private property <bool> profile-menu-was-open: false;
    private property <bool> profile-menu-keyboard-open: false;
    private property <int> profile-shelf-focus-serial: 0;
    in-out property <string> profile-delete-confirm-id;
    private property <bool> catalog-group-navigation-enabled: !root.catalog-loading && root.catalog-groups.length > 0;
    private property <length> resize-border: 6px;
    in-out property <string> subscription-draft;

    callback import-url(string);
    callback refresh-subscription();
    callback open-profile-menu();
    callback close-profile-menu();
    callback activate-profile(string);
    callback refresh-profile(string);
    callback replace-profile-source(string, string);
    callback delete-profile(string);
    callback add-subscription();
    callback retry-profile-menu();
    callback primary-action();
    callback open-panel(string);
    callback close-panel();
    callback escape-pressed();
    callback filter-events(string);
    callback select-catalog-group(string);
    callback select-catalog-node(string);
    callback set-launch-at-sign-in(bool);
    callback window-drag();
    callback window-resize(string);
    callback window-minimize();
    callback window-toggle-maximize();
    callback window-close();
    callback update-action();

    wave-kickoff := Timer {
        interval: 80ms;
        running: root.ambient-motion-active && !root.ambient-wave-started;
        triggered => {
            root.ambient-wave-started = true;
            root.ambient-wave-phase = !root.ambient-wave-phase;
        }
    }

    wave-timer := Timer {
        interval: 12s;
        running: root.ambient-motion-active && root.ambient-wave-started;
        triggered => { root.ambient-wave-phase = !root.ambient-wave-phase; }
    }

    changed ambient-motion-active => {
        if (!root.ambient-motion-active) {
            root.ambient-wave-started = false;
        }
    }

    changed import-success-serial => {
        if (root.import-success-serial > 0) {
            root.replace-editor-open = false;
            root.subscription-draft = "";
        }
    }

    changed active-panel => {
        if (root.active-panel == "subscription") {
            root.profile-menu-was-open = true;
        } else {
            root.profile-delete-confirm-id = "";
            if (root.profile-menu-was-open && root.profile-menu-keyboard-open) {
                root.profile-shelf-focus-serial += 1;
            }
            root.profile-menu-was-open = false;
            root.profile-menu-keyboard-open = false;
        }
    }

    visual-frame := FocusScope {
        x: root.resize-border;
        y: root.resize-border;
        width: parent.width - 2 * root.resize-border;
        height: parent.height - 2 * root.resize-border;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                if (root.profile-delete-confirm-id != "") {
                    root.profile-delete-control-focus-id = root.profile-delete-confirm-id;
                    root.profile-delete-confirm-id = "";
                    root.profile-delete-control-focus-serial += 1;
                } else if (root.profile-edit-id != "") {
                    root.profile-edit-id = "";
                    root.profile-edit-draft = "";
                } else { root.escape-pressed(); }
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            spacing: 0px;

            title-bar := Rectangle {
                height: 44px;
                background: #0a0c0f;
                border-color: Theme.line;
                border-width: 0px;

                drag-region := Rectangle {
                    x: 0px;
                    y: 0px;
                    width: parent.width - 132px;
                    height: parent.height;
                    background: transparent;

                    Image {
                        x: 14px;
                        y: 12px;
                        width: 20px;
                        height: 20px;
                        source: @image-url("../assets/app-icon.svg");
                        image-fit: contain;
                    }

                    Text {
                        x: 42px;
                        width: 112px;
                        height: parent.height;
                        text: "MULTICORE";
                        color: Theme.text-secondary;
                        font-family: Theme.font-family;
                        font-size: Theme.type-metadata-size;
                        font-weight: Theme.weight-bold;
                        letter-spacing: 1px;
                        vertical-alignment: center;
                    }

                    if root.update-available: Rectangle {
                        x: 151px;
                        y: 17px;
                        width: 6px;
                        height: 6px;
                        border-radius: 3px;
                        background: Theme.accent-blue;
                    }

                    drag-touch := TouchArea {
                        moved => { root.window-drag(); }
                        double-clicked => { root.window-toggle-maximize(); }
                    }
                }

                TitleBarButton { x: parent.width - 132px; kind: "minimize"; state-label: "Свернуть окно"; enabled: !root.profile-menu-open; activated => { root.window-minimize(); } }
                TitleBarButton { x: parent.width - 88px; kind: root.maximized ? "restore" : "maximize"; state-label: "Развернуть или восстановить окно"; enabled: !root.profile-menu-open; activated => { root.window-toggle-maximize(); } }
                TitleBarButton { x: parent.width - 44px; kind: "close"; state-label: "Закрыть MultiCore"; enabled: !root.profile-menu-open; activated => { root.window-close(); } }
            }

            HorizontalLayout {
                spacing: 0px;

        navigation-rail := Rectangle {
            width: 176px;
            background: #0a0c0f;
            border-color: Theme.line;
            border-width: 0px;

            VerticalLayout {
                padding: 16px;
                spacing: 8px;

                NavItem { icon-source: @image-url("../assets/home.svg"); label: "Главная"; active: root.visible-page == "home"; enabled: !root.profile-menu-open; activated => { root.local-page = "home"; root.close-panel(); } }
                NavItem { icon-source: @image-url("../assets/status.svg"); label: "Состояние"; active: root.visible-page == "status"; enabled: !root.profile-menu-open; activated => { root.local-page = "status"; root.open-panel("events"); } }
                NavItem { icon-source: @image-url("../assets/link.svg"); label: "Подписки"; active: root.visible-page == "subscriptions"; enabled: !root.profile-menu-open; activated => { root.local-page = "subscriptions"; root.close-panel(); } }
                NavItem { icon-source: @image-url("../assets/settings.svg"); label: "Настройки"; active: root.visible-page == "settings"; enabled: !root.profile-menu-open; activated => { root.local-page = "settings"; root.close-panel(); } }

                Rectangle { vertical-stretch: 1; background: transparent; }
            }
        }

        main-pane := Rectangle {
            background: Theme.canvas;

            if root.visible-page == "home": Rectangle {
                background: transparent;
                clip: true;

                ambient-touch := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    enabled: root.ambient-background-enabled;
                }

                ambient-pointer-glow := Rectangle {
                    width: parent.width;
                    height: parent.height;
                    visible: root.ambient-background-enabled;
                    opacity: ambient-touch.has-hover ? 1 : 0;
                    background: @radial-gradient(
                        circle 360px at ambient-touch.mouse-x ambient-touch.mouse-y,
                        #d7dde50b 0%,
                        #b7c2cf06 38%,
                        #00000000 76%
                    );
                    animate opacity { duration: 220ms; easing: ease-out; }
                }

                ambient-wave-a := Path {
                    visible: root.ambient-background-enabled;
                    x: root.ambient-wave-phase ? -12px : -48px;
                    y: root.ambient-wave-phase ? 48px : 76px;
                    width: parent.width + 76px;
                    height: 210px;
                    viewbox-width: 1000;
                    viewbox-height: 220;
                    commands: "M 0 124 C 160 40 340 36 500 112 C 668 192 824 184 1000 82 L 1000 220 L 0 220 Z";
                    fill: #c8cdd5;
                    opacity: 0.026;
                    animate x { duration: 12000ms; easing: ease-in-out; }
                    animate y { duration: 12000ms; easing: ease-in-out; }
                }

                ambient-wave-b := Path {
                    visible: root.ambient-background-enabled;
                    x: root.ambient-wave-phase ? -58px : -22px;
                    y: root.ambient-wave-phase ? 288px : 254px;
                    width: parent.width + 76px;
                    height: 240px;
                    viewbox-width: 1000;
                    viewbox-height: 240;
                    commands: "M 0 74 C 190 174 350 184 510 92 C 670 0 824 34 1000 142 L 1000 240 L 0 240 Z";
                    fill: #aeb5bf;
                    opacity: 0.018;
                    animate x { duration: 12000ms; easing: ease-in-out; }
                    animate y { duration: 12000ms; easing: ease-in-out; }
                }

                VerticalLayout {
                    padding: 20px;
                    spacing: 10px;

                    connection-strip := Rectangle {
                        height: 96px;
                        background: root.status-tone == "success" ? #101a16 : root.status-tone == "danger" ? #1a1215 : #101721;
                        border-color: root.status-tone == "success" ? #3ccb7f66 : root.status-tone == "danger" ? #f06a6a66 : #4c9dff55;
                        border-width: 1px;
                        border-radius: 18px;
                        clip: true;

                        // Only the cell mesh reacts to hover. An outer halo would be clipped by
                        // the main-content plane and read as a rectangular light patch.
                        mesh-clip := Rectangle {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: parent.height;
                            border-radius: 18px;
                            clip: true;
                            background: transparent;

                            signal-mesh-field := Rectangle {
                                property <bool> active: strip-glow-touch.has-hover;
                                property <length> cursor-x: strip-glow-touch.mouse-x;
                                property <length> cursor-y: strip-glow-touch.mouse-y;
                                property <color> glow-strong: root.status-tone == "success" ? #22c55e3d : root.status-tone == "danger" ? #f06a6a3d : #0091ff47;
                                property <color> glow-medium: root.status-tone == "success" ? #22c55e24 : root.status-tone == "danger" ? #f06a6a24 : #0091ff29;
                                property <color> glow-soft: root.status-tone == "success" ? #22c55e0f : root.status-tone == "danger" ? #f06a6a0f : #0091ff0f;
                                property <color> grid-line-strong: root.status-tone == "success" ? #8ea39770 : root.status-tone == "danger" ? #a3939370 : #8f9eae70;
                                x: 0;
                                y: 0;
                                width: parent.width;
                                height: parent.height;
                                opacity: self.active ? 1 : 0;
                                background: @radial-gradient(
                                    circle 160px at cursor-x cursor-y,
                                    glow-strong 0%,
                                    glow-medium 26%,
                                    glow-soft 52%,
                                    #00000000 76%
                                );
                                animate opacity { duration: 160ms; easing: ease-out; }

                                for _[grid-x] in 120: Rectangle {
                                    x: grid-x * 8px;
                                    y: 0;
                                    width: 8px;
                                    height: parent.height;
                                    background: transparent;

                                    for _[grid-cell-y] in 12: Rectangle {
                                        property <float> normalized-x: (grid-x * 8px + 4px - signal-mesh-field.cursor-x) / 176px;
                                        property <float> normalized-y: (grid-cell-y * 8px + 4px - signal-mesh-field.cursor-y) / 72px;
                                        property <float> distance: Math.sqrt(
                                            self.normalized-x * self.normalized-x
                                            + self.normalized-y * self.normalized-y
                                        );
                                        x: 0;
                                        y: grid-cell-y * 8px;
                                        width: 8px;
                                        height: 8px;
                                        background: transparent;
                                        border-width: 0.5px;
                                        border-color: signal-mesh-field.grid-line-strong;
                                        opacity: signal-mesh-field.active ? Math.max(0, 1 - self.distance) : 0;
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            padding-top: 12px;
                            padding-bottom: 12px;
                            spacing: 16px;
                            alignment: start;
                            if root.has-profile: power-action := FocusScope {
                                width: 72px;
                                height: 72px;
                                enabled: root.primary-enabled && !root.profile-menu-open;
                                focus-on-click: true;
                                focus-on-tab-navigation: true;
                                accessible-role: button;
                                accessible-label: root.primary-label;
                                accessible-enabled: self.enabled;
                                accessible-action-default => {
                                    if (root.primary-enabled) {
                                        root.primary-action();
                                    }
                                }
                                key-pressed(event) => {
                                    if ((event.text == " " || event.text == "\n") && root.primary-enabled) {
                                        root.primary-action();
                                        return accept;
                                    }
                                    return reject;
                                }

                                power-button := Rectangle {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    width: strip-glow-touch.pressed ? 69px : 72px;
                                    height: strip-glow-touch.pressed ? 69px : 72px;
                                    border-radius: self.width / 2;
                                    clip: true;
                                    background: root.status-tone == "success" ? #0d1814f0 : root.status-tone == "danger" ? #1a1013f0 : #101722f0;
                                    border-color: power-action.has-focus ? Theme.focus : root.status-tone == "success" ? Theme.accent-green : root.status-tone == "danger" ? Theme.error : Theme.accent-blue;
                                    border-width: power-action.has-focus ? Theme.focus-width : 1px;
                                    opacity: root.primary-enabled ? 1 : 0.45;

                                    power-glyph := Image {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2 - 1px;
                                        width: 32px;
                                        height: 32px;
                                        source: @image-url("../assets/power.svg");
                                        image-fit: contain;
                                        accessible-role: none;
                                    }
                                    if root.has-service-logo: service-logo-badge := Rectangle {
                                        x: parent.width - 30px;
                                        y: parent.height - 30px;
                                        width: 28px;
                                        height: 28px;
                                        border-radius: 14px;
                                        background: #0d0f12e8;
                                        border-color: #ffffff33;
                                        border-width: 1px;
                                        accessible-role: none;

                                        Image {
                                            x: 4px;
                                            y: 4px;
                                            width: 20px;
                                            height: 20px;
                                            source: root.service-logo;
                                        image-fit: contain;
                                        accessible-role: none;
                                    }
                                    }
                                }

                            }
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: root.status-eyebrow; color: Theme.text-muted; font-size: Theme.type-metadata-size; font-weight: Theme.weight-semibold; overflow: elide; }
                                Text { text: root.headline; color: Theme.text-primary; font-size: 18px; font-weight: Theme.weight-semibold; overflow: elide; }
                                Text { text: root.node-name + (root.supporting == "" ? "" : " · " + root.supporting); color: Theme.text-secondary; font-size: Theme.type-metadata-size; overflow: elide; }
                            }
                            if !root.has-profile: PrimaryAction {
                                width: 164px;
                                label: "Добавить URL";
                                state-label: "Добавить подписку";
                                enabled: !root.import-pending && !root.profile-menu-open;
                                activated => { root.add-subscription(); }
                            }
                        }

                        // This is the pill's only pointer surface. It sits above every visual
                        // child, so crossing the power icon never hands hover to another area.
                        strip-glow-touch := TouchArea {
                            x: 0;
                            y: 0;
                            width: root.has-profile ? parent.width : 0px;
                            height: root.has-profile ? parent.height : 0px;
                            enabled: !root.profile-menu-open;
                            clicked => {
                                if (root.primary-enabled) {
                                    root.primary-action();
                                }
                            }
                        }

                    }

                    subscription-strip := Rectangle {
                        // Legacy source-contract anchors; profile refresh now lives in
                        // Settings details: subscription-refresh-action := SmallAction, width: 104px;, padding-right: 5px;, root.refresh-subscription();
                        height: 54px;
                        background: root.profile-menu-open ? Theme.elevated : Theme.surface;
                        border-radius: 16px;
                        border-color: shelf-open-focus.has-focus ? Theme.focus : transparent;
                        border-width: shelf-open-focus.has-focus ? 2px : 0px;
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            padding-top: 5px;
                            padding-bottom: 5px;
                            spacing: 12px;
                            subscription-copy := VerticalLayout {
                                horizontal-stretch: 1;
                                padding-top: 2px;
                                spacing: 0px;
                                HorizontalLayout {
                                    height: 20px;
                                    Text { horizontal-stretch: 1; text: root.subscription-title; color: Theme.text-primary; font-size: Theme.type-label-size; font-weight: Theme.weight-semibold; overflow: elide; }
                                }
                                HorizontalLayout {
                                    height: 18px;
                                    Text {
                                        horizontal-stretch: 1;
                                        text: root.subscription-refresh-error != "" ? root.subscription-refresh-error : root.subscription-usage + " · " + root.subscription-expiry;
                                        color: root.subscription-refresh-error != "" ? Theme.error : Theme.text-muted;
                                        font-size: Theme.type-metadata-size;
                                        overflow: elide;
                                    }
                                }
                            }
                            updated-meta := Rectangle {
                                width: 92px;
                                horizontal-stretch: 0;
                                Text {
                                    x: 0px;
                                    y: 22px;
                                    width: parent.width;
                                    height: 18px;
                                    text: root.subscription-updated;
                                    color: Theme.text-muted;
                                    font-size: Theme.type-metadata-size;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                            }
                            shelf-chevron := Rectangle {
                                width: 20px;
                                background: transparent;
                                border-radius: 11px;
                                Path {
                                    x: 4px;
                                    y: 18px;
                                    width: 12px;
                                    height: 8px;
                                    viewbox-width: 12;
                                    viewbox-height: 8;
                                    commands: root.profile-menu-open ? "M 1 7 L 6 2 L 11 7" : "M 1 1 L 6 6 L 11 1";
                                    stroke: Theme.text-muted;
                                    stroke-width: 1.5px;
                                    fill: transparent;
                                }
                            }
                        }
                        shelf-open-focus := FocusScope {
                            property <int> focus-serial: root.profile-shelf-focus-serial;
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: parent.height;
                            enabled: !root.profile-menu-open;
                            focus-on-click: true;
                            focus-on-tab-navigation: true;
                            accessible-role: button;
                            accessible-label: "Выбрать профиль подписки";
                            accessible-description: root.subscription-title + ". Обновлено " + root.subscription-updated + ". " + (root.profile-menu-open ? "Список профилей открыт" : "Открыть список профилей");
                            accessible-enabled: self.enabled;
                            accessible-action-default => {
                                if (root.profile-menu-open) { root.close-profile-menu(); }
                                else if (root.subscription-profiles.length == 0 && !root.profile-menu-loading && root.profile-menu-error == "") {
                                    root.local-page = "subscriptions";
                                    root.close-panel();
                                } else { root.profile-menu-keyboard-open = true; root.open-profile-menu(); }
                            }
                            changed focus-serial => { self.focus(); }
                            key-pressed(event) => {
                                if (event.text == " " || event.text == "\n") {
                                    if (root.profile-menu-open) { root.close-profile-menu(); }
                                    else if (root.subscription-profiles.length == 0 && !root.profile-menu-loading && root.profile-menu-error == "") {
                                        root.local-page = "subscriptions";
                                        root.close-panel();
                                    }
                                    else { root.profile-menu-keyboard-open = true; root.open-profile-menu(); }
                                    return accept;
                                }
                                return reject;
                            }
                            TouchArea {
                                clicked => {
                                    if (root.profile-menu-open) { root.close-profile-menu(); }
                                    else if (root.subscription-profiles.length == 0 && !root.profile-menu-loading && root.profile-menu-error == "") {
                                        root.local-page = "subscriptions";
                                        root.close-panel();
                                    }
                                    else { root.profile-menu-keyboard-open = false; root.open-profile-menu(); }
                                }
                            }
                        }
                    }

                    if root.subscription-announcement-text != "": Rectangle {
                        height: 44px;
                        background: root.subscription-announcement-tone == "danger" ? #211619 : root.subscription-announcement-tone == "success" ? #13231b : #131d29;
                        border-radius: 12px;
                        border-color: root.subscription-announcement-tone == "danger" ? #f06a6a66 : root.subscription-announcement-tone == "success" ? #3ccb7f66 : #4c9dff66;
                        border-width: 1px;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-top: 7px;
                            padding-bottom: 7px;
                            spacing: 10px;
                            if root.subscription-announcement-tone == "danger": Image {
                                width: 18px;
                                height: 18px;
                                source: @image-url("../assets/announcement-danger.svg");
                                image-fit: contain;
                                accessible-role: none;
                            }
                            if root.subscription-announcement-tone == "success": Image {
                                width: 18px;
                                height: 18px;
                                source: @image-url("../assets/announcement-success.svg");
                                image-fit: contain;
                                accessible-role: none;
                            }
                            if root.subscription-announcement-tone != "danger" && root.subscription-announcement-tone != "success": Image {
                                width: 18px;
                                height: 18px;
                                source: @image-url("../assets/announcement-info.svg");
                                image-fit: contain;
                                accessible-role: none;
                            }
                            Text {
                                text: root.subscription-announcement-text;
                                color: Theme.text-secondary;
                                font-size: Theme.type-metadata-size;
                                wrap: word-wrap;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                        }
                    }

                    inline-routes := Rectangle {
                        vertical-stretch: 1;
                        min-height: 270px;
                        background: transparent;
                        VerticalLayout {
                            spacing: 8px;
                            HorizontalLayout {
                                height: 36px;
                                spacing: 12px;
                                Text { text: "Маршруты"; color: Theme.text-primary; font-size: Theme.type-label-size; font-weight: Theme.weight-semibold; vertical-alignment: center; }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                Text {
                                    text: root.catalog-selection-queued
                                        ? "Применим после подключения"
                                        : root.catalog-selection-pending
                                            ? "Применяем маршрут…"
                                            : root.latency-check-loading
                                                ? "Проверяем задержку…"
                                                : root.latency-check-queued
                                                    ? "Проверим автоматически"
                                                    : "Задержка обновляется автоматически";
                                    color: root.catalog-selection-queued || root.catalog-selection-pending ? Theme.warning : Theme.text-muted;
                                    font-size: Theme.type-metadata-size;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                            ScrollView {
                                height: 60px;
                                horizontal-stretch: 1;
                                HorizontalLayout {
                                    spacing: 8px;
                                    for group in root.catalog-groups: QuietChip {
                                        min-width: 104px;
                                        height: 44px;
                                        icon: group.icon;
                                        label: group.label;
                                        selected: group.selected;
                                        enabled: root.catalog-group-navigation-enabled;
                                        modal-enabled: !root.profile-menu-open;
                                        activated => { root.select-catalog-group(group.id); }
                                    }
                                }
                            }
                            if root.catalog-error != "" || root.latency-check-error != "": Text { height: 28px; text: root.catalog-error != "" ? root.catalog-error : root.latency-check-error; color: Theme.error; font-size: Theme.type-metadata-size; wrap: word-wrap; }
                            ScrollView {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    spacing: 4px;
                                    for node in root.catalog-nodes: RouteNodeRow {
                                        height: 46px;
                                        icon: node.icon;
                                        label: node.label;
                                        supporting-text: "";
                                        trailing-text: node.latency-text;
                                        trailing-tone: node.latency-tone;
                                        selected: node.selected;
                                        pending: root.catalog-selection-pending && node.selected;
                                        enabled: root.catalog-selection-enabled && !root.profile-menu-open;
                                        activated => { root.select-catalog-node(node.id); }
                                    }
                                    if root.catalog-nodes.length == 0: Text { height: 52px; text: root.catalog-loading ? "Загружаем маршруты…" : "В этой группе нет доступных серверов"; color: Theme.text-muted; font-size: Theme.type-metadata-size; vertical-alignment: center; horizontal-alignment: center; }
                                }
                            }
                        }
                    }
                }
            }

            if root.visible-page == "status": Rectangle {
                background: transparent;
                VerticalLayout {
                    padding-left: 28px;
                    padding-right: 28px;
                    padding-top: 28px;
                    padding-bottom: 40px;
                    spacing: 16px;
                    HorizontalLayout {
                        height: 34px;
                        Text { text: "Состояние"; color: Theme.text-primary; font-size: 20px; font-weight: Theme.weight-semibold; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        Text { text: root.diagnostics-loading ? "Обновляем…" : "Локальная диагностика"; color: Theme.text-muted; font-size: Theme.type-metadata-size; vertical-alignment: center; }
                    }
                    Rectangle {
                        height: 154px;
                        background: Theme.surface;
                        border-radius: 12px;
                        VerticalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 0px;
                            HealthRow { label: "Xray transport"; value: root.diagnostics-xray-value; tone: root.diagnostics-xray-tone; }
                            HealthRow { label: "Mihomo policy"; value: root.diagnostics-mihomo-value; tone: root.diagnostics-mihomo-tone; }
                            HealthRow { label: "TUN MultiCore"; value: root.diagnostics-tun-value; tone: root.diagnostics-tun-tone; }
                        }
                    }
                    Text { height: 24px; text: "Маппинг Mihomo → Xray"; color: Theme.text-primary; font-size: Theme.type-label-size; font-weight: Theme.weight-semibold; }
                    ScrollView {
                        height: root.diagnostic-mappings.length > 0 ? 138px : 44px;
                        VerticalLayout {
                            spacing: 0px;
                            for mapping in root.diagnostic-mappings: Rectangle {
                                height: 42px;
                                border-color: Theme.line;
                                border-width: 0px;
                                HorizontalLayout {
                                    spacing: 12px;
                                    Text { text: mapping.proxy-name; color: Theme.text-primary; font-size: Theme.type-metadata-size; vertical-alignment: center; overflow: elide; }
                                    Text { width: 128px; text: mapping.address; color: Theme.text-muted; font-size: Theme.type-metadata-size; horizontal-alignment: right; vertical-alignment: center; }
                                    Text { width: 132px; text: mapping.xray-label; color: Theme.text-secondary; font-size: Theme.type-metadata-size; horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
                                }
                            }
                            if root.diagnostic-mappings.length == 0: Text { height: 42px; text: "Маппинги появятся после загрузки подписки"; color: Theme.text-muted; font-size: Theme.type-metadata-size; vertical-alignment: center; }
                        }
                    }
                    HorizontalLayout {
                        height: 44px;
                        spacing: 8px;
                        SmallAction { label: "Все"; selected: root.event-filter == "Все"; enabled: !root.profile-menu-open; activated => { root.filter-events("Все"); } }
                        SmallAction { label: "Система"; selected: root.event-filter == "Система"; enabled: !root.profile-menu-open; activated => { root.filter-events("Система"); } }
                        SmallAction { label: "Ошибки"; selected: root.event-filter == "Ошибки"; enabled: !root.profile-menu-open; activated => { root.filter-events("Ошибки"); } }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 8px;
                            for event in root.events: Rectangle {
                                height: 56px;
                                background: #ffffff04;
                                border-radius: 8px;
                                VerticalLayout {
                                    padding: 8px;
                                    spacing: 3px;
                                    Text { text: event.component + (event.timestamp == "" ? "" : " · " + event.timestamp); color: event.level == "error" ? Theme.error : Theme.text-muted; font-size: Theme.type-metadata-size; font-weight: Theme.weight-semibold; }
                                    Text { text: event.message; color: Theme.text-secondary; font-size: Theme.type-metadata-size; wrap: word-wrap; }
                                }
                            }
                            if root.events.length == 0: Text { height: 56px; text: "Событий пока нет"; color: Theme.text-muted; font-size: Theme.type-label-size; vertical-alignment: center; horizontal-alignment: center; }
                        }
                    }
                }
            }

            if root.visible-page == "settings" || root.visible-page == "subscriptions": Rectangle {
                background: transparent;
                settings-scroll := ScrollView {
                    vertical-stretch: 1;
                    settings-content := VerticalLayout {
                        // Historical minimum-height contract used spacing: 18px;.
                        width: settings-scroll.visible-width;
                        min-height: settings-scroll.visible-height;
                        padding: 28px;
                        spacing: 16px;
                        Text { height: 30px; text: root.visible-page == "subscriptions" ? "Подписки" : "Настройки"; color: Theme.text-primary; font-size: 20px; font-weight: Theme.weight-semibold; }
                        HorizontalLayout {
                            spacing: root.visible-page == "settings" ? (root.width >= 800px ? 16px : 12px) : 0px;
                            VerticalLayout {
                                visible: root.visible-page == "settings";
                                width: root.visible-page == "settings" ? (root.width >= 800px ? 132px : 112px) : 0px;
                                horizontal-stretch: 0;
                                spacing: 4px;
                                SettingsNavItem { width: parent.width; label: "Общие"; selected: root.settings-section == "general"; activated => { root.settings-section = "general"; root.profile-delete-confirm-id = ""; root.profile-edit-id = ""; } }
                                SettingsNavItem { width: parent.width; label: "Обновления"; selected: root.settings-section == "updates"; activated => { root.settings-section = "updates"; root.profile-delete-confirm-id = ""; root.profile-edit-id = ""; } }
                                Rectangle { vertical-stretch: 1; background: transparent; }
                            }
                            settings-section-body := VerticalLayout {
                                width: root.visible-page == "subscriptions" ? root.width - 232px : root.width >= 800px ? root.width - 380px : root.width - 356px;
                                horizontal-stretch: 1;
                                spacing: 16px;

                        if root.visible-page == "settings" && root.settings-section == "general": VerticalLayout {
                            spacing: 16px;
                            Text { height: 24px; text: root.system-name; color: Theme.text-primary; font-size: Theme.type-label-size; font-weight: Theme.weight-semibold; }
                            ToggleRow {
                                label: "Запускать при входе в " + root.system-name;
                                description: root.launch-at-sign-in-stale ? "Путь приложения изменился — включите заново" : "Открывать MultiCore после входа в систему";
                                checked: root.launch-at-sign-in-enabled;
                                enabled: !root.profile-menu-open;
                                toggled(value) => { root.set-launch-at-sign-in(value); }
                            }
                            if root.launch-at-sign-in-error != "": Text { height: 34px; text: root.launch-at-sign-in-error; color: Theme.error; font-size: Theme.type-metadata-size; wrap: word-wrap; }
                            ToggleRow {
                                label: "Живой фон";
                                description: root.reduced-motion ? "Анимация отключена настройками " + root.system-name : "Спокойные волны на главной";
                                checked: root.ambient-background-enabled;
                                enabled: !root.profile-menu-open;
                                toggled(value) => { root.ambient-background-enabled = value; }
                            }
                            if root.preference-error != "": Text { height: 34px; text: root.preference-error; color: Theme.error; font-size: Theme.type-metadata-size; wrap: word-wrap; }
                            Rectangle { vertical-stretch: 1; background: transparent; }
                        }

                        if root.visible-page == "settings" && root.settings-section == "updates": VerticalLayout {
                            spacing: 16px;
                            Text { height: 24px; text: "Обновления"; color: Theme.text-primary; font-size: Theme.type-label-size; font-weight: Theme.weight-semibold; }
                            Text { height: 24px; text: root.update-status; color: Theme.text-primary; font-size: Theme.type-label-size; font-weight: Theme.weight-semibold; overflow: elide; }
                            Text {
                                height: 40px;
                                text: root.update-available && !root.update-runtime-safe ? "Отключитесь, чтобы установить обновление" : root.update-detail;
                                color: root.update-available && !root.update-runtime-safe ? Theme.warning : Theme.text-muted;
                                font-size: Theme.type-metadata-size;
                                wrap: word-wrap;
                            }
                            if root.update-action-label != "": SmallAction {
                                label: root.update-action-label;
                                enabled: root.update-action-enabled && (!root.update-available || root.update-runtime-safe) && !root.update-busy && !root.profile-menu-open;
                                activated => { root.update-action(); }
                            }
                            Rectangle { vertical-stretch: 1; background: transparent; }
                        }

                        if root.visible-page == "settings": Text { height: 24px; text: "MultiCore · Mihomo 1.19.30 · Xray 26.9.9"; color: Theme.text-muted; font-size: Theme.type-metadata-size; }

                        if root.visible-page == "subscriptions": VerticalLayout {
                            spacing: 12px;
                            HorizontalLayout {
                                height: 52px;
                                spacing: 16px;
                                VerticalLayout {
                                    spacing: 2px;
                                    Text { text: "До 16 подписок · активна только одна"; color: Theme.text-secondary; font-size: Theme.type-label-size; font-weight: Theme.weight-semibold; }
                                    Text { text: "Ссылки хранятся локально и не показываются в интерфейсе"; color: Theme.text-muted; font-size: Theme.type-metadata-size; }
                                }
                                SmallAction { width: 112px; label: "Добавить"; enabled: !root.import-pending; focus-epoch: root.profile-management-focus-id == "" ? root.profile-management-focus-serial : 0; activated => { root.add-subscription(); } }
                            }
                            if root.replace-editor-open: Rectangle {
                                height: 116px;
                                background: Theme.surface;
                                border-radius: 14px;
                                VerticalLayout {
                                    padding: 12px;
                                    spacing: 8px;
                                    LineEdit { text <=> root.subscription-draft; placeholder-text: "https://example.com/subscription"; enabled: !root.import-pending; }
                                    HorizontalLayout {
                                        if root.import-error != "": Text { text: root.import-error; color: Theme.error; font-size: Theme.type-metadata-size; wrap: word-wrap; }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                        SmallAction { label: root.import-pending ? "Проверяем…" : "Сохранить"; enabled: !root.import-pending && root.subscription-draft != ""; activated => { root.import-url(root.subscription-draft); } }
                                    }
                                }
                            }
                            if root.profile-menu-loading: Text { height: 44px; text: "Загружаем подписки…"; color: Theme.text-muted; font-size: Theme.type-metadata-size; vertical-alignment: center; accessible-role: text; accessible-live-region: polite; }
                            if root.profile-menu-error != "": HorizontalLayout {
                                height: 52px;
                                spacing: 12px;
                                Text { text: root.profile-menu-error; color: Theme.error; font-size: Theme.type-metadata-size; overflow: elide; vertical-alignment: center; accessible-role: text; accessible-live-region: polite; }
                                SmallAction { width: 108px; label: "Повторить"; activated => { root.retry-profile-menu(); } }
                            }
                            if !root.profile-menu-loading && root.profile-menu-error == "" && root.subscription-profiles.length == 0: Text { height: 64px; text: "Подписок пока нет"; color: Theme.text-muted; font-size: Theme.type-label-size; vertical-alignment: center; horizontal-alignment: center; }
                            if root.subscription-profiles.length > 0: Rectangle {
                                height: root.subscription-profiles.length * 73px
                                    + (root.profile-edit-id == "" ? 0px : 62px)
                                    + (root.profile-delete-confirm-id == "" ? 0px : 62px);
                                background: Theme.surface;
                                border-radius: 14px;
                                clip: true;
                                VerticalLayout {
                                    spacing: 0px;
                                    for profile[index] in root.subscription-profiles: settings-profile-row := Rectangle {
                                        height: 72px
                                            + (root.profile-edit-id == profile.id ? 62px : 0px)
                                            + (root.profile-delete-confirm-id == profile.id ? 62px : 0px);
                                        background: profile.active ? #4c9dff0c : transparent;
                                        opacity: profile.available || profile.active ? 1 : 0.62;

                                        Rectangle {
                                            x: 12px; y: 20px; width: 32px; height: 32px;
                                            background: Theme.elevated; border-radius: 8px;
                                            if profile.has-logo: Image { x: 5px; y: 5px; width: 22px; height: 22px; source: profile.logo; image-fit: contain; accessible-role: none; }
                                            if !profile.has-logo: Text { text: profile.fallback; color: Theme.text-secondary; font-size: Theme.type-metadata-size; font-weight: Theme.weight-semibold; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                        Text { x: 56px; y: 8px; width: parent.width - 244px; height: 20px; text: profile.title; color: Theme.text-primary; font-size: Theme.type-label-size; font-weight: profile.active ? Theme.weight-semibold : Theme.weight-regular; overflow: elide; }
                                        Text { x: 56px; y: 28px; width: parent.width - 244px; height: 18px; text: profile.usage + " · " + profile.expiry; color: Theme.text-secondary; font-size: Theme.type-metadata-size; overflow: elide; }
                                        Text {
                                            x: 56px; y: 47px; width: parent.width - 244px; height: 17px;
                                            text: root.profile-pending-id == profile.id
                                                ? root.profile-pending-operation == "refresh" ? "Обновляем…"
                                                : root.profile-pending-operation == "edit" ? "Меняем ссылку…"
                                                : root.profile-pending-operation == "delete" ? "Удаляем…"
                                                : "Применяем…"
                                                : !profile.available ? "Временно недоступна"
                                                : profile.active ? "Активна" : "Доступна";
                                            color: !profile.available ? Theme.warning : profile.active ? Theme.accent-blue : Theme.text-muted;
                                            font-size: 11px;
                                            overflow: elide;
                                        }

                                        if profile.active: Path { x: parent.width - 172px; y: 29px; width: 16px; height: 12px; viewbox-width: 16; viewbox-height: 12; commands: "M 2 6 L 6 10 L 14 2"; stroke: Theme.accent-blue; stroke-width: 1.8px; fill: transparent; }
                                        if !profile.active: activate-profile-focus := FocusScope {
                                            x: parent.width - 192px; y: 16px; width: 40px; height: 40px;
                                            enabled: root.subscription-refresh-enabled && root.profile-pending-operation == "none";
                                            focus-on-click: true; focus-on-tab-navigation: true;
                                            accessible-role: button; accessible-label: "Сделать активной " + profile.title; accessible-enabled: self.enabled;
                                            accessible-action-default => { if (self.enabled) { root.activate-profile(profile.id); } }
                                            Rectangle { border-radius: 8px; background: activate-profile-touch.has-hover && parent.enabled ? #4c9dff14 : transparent; border-color: parent.has-focus ? Theme.focus : Theme.line; border-width: 1px; Image { x: 11px; y: 11px; width: 18px; height: 18px; source: @image-url("../assets/power.svg"); image-fit: contain; accessible-role: none; } }
                                            key-pressed(event) => { if ((event.text == " " || event.text == "\n") && self.enabled) { root.activate-profile(profile.id); return accept; } return reject; }
                                            activate-profile-touch := TouchArea { enabled: parent.enabled; clicked => { root.activate-profile(profile.id); } }
                                        }
                                        refresh-profile-focus := FocusScope {
                                            property <int> focus-serial: root.profile-management-focus-serial;
                                            x: parent.width - 144px; y: 16px; width: 40px; height: 40px;
                                            enabled: root.subscription-refresh-enabled && profile.available && root.profile-pending-operation == "none";
                                            focus-on-click: true; focus-on-tab-navigation: true;
                                            accessible-role: button; accessible-label: "Обновить " + profile.title; accessible-enabled: self.enabled;
                                            accessible-action-default => { if (self.enabled) { root.refresh-profile(profile.id); } }
                                            init => { if (root.profile-management-focus-id == profile.id && root.profile-management-focus-serial > 0) { self.focus(); } }
                                            changed focus-serial => { if (root.profile-management-focus-id == profile.id && self.enabled) { self.focus(); } }
                                            Rectangle { border-radius: 8px; background: refresh-profile-touch.has-hover && parent.enabled ? #ffffff0a : transparent; border-color: parent.has-focus ? Theme.focus : Theme.line; border-width: 1px; Image { x: 11px; y: 11px; width: 18px; height: 18px; source: @image-url("../assets/refresh.svg"); image-fit: contain; accessible-role: none; } }
                                            key-pressed(event) => { if ((event.text == " " || event.text == "\n") && self.enabled) { root.refresh-profile(profile.id); return accept; } return reject; }
                                            refresh-profile-touch := TouchArea { enabled: parent.enabled; clicked => { root.refresh-profile(profile.id); } }
                                        }
                                        edit-profile-focus := FocusScope {
                                            x: parent.width - 96px; y: 16px; width: 40px; height: 40px;
                                            enabled: root.subscription-refresh-enabled && root.profile-pending-operation == "none";
                                            focus-on-click: true; focus-on-tab-navigation: true;
                                            accessible-role: button; accessible-label: "Изменить URL " + profile.title; accessible-enabled: self.enabled;
                                            accessible-action-default => { if (self.enabled) { root.profile-delete-confirm-id = ""; root.profile-edit-draft = ""; root.profile-edit-id = root.profile-edit-id == profile.id ? "" : profile.id; } }
                                            Rectangle { border-radius: 8px; background: edit-profile-touch.has-hover && parent.enabled ? #ffffff0a : transparent; border-color: parent.has-focus ? Theme.focus : Theme.line; border-width: 1px; Image { x: 11px; y: 11px; width: 18px; height: 18px; source: @image-url("../assets/edit.svg"); image-fit: contain; accessible-role: none; } }
                                            key-pressed(event) => { if ((event.text == " " || event.text == "\n") && self.enabled) { root.profile-delete-confirm-id = ""; root.profile-edit-draft = ""; root.profile-edit-id = root.profile-edit-id == profile.id ? "" : profile.id; return accept; } return reject; }
                                            edit-profile-touch := TouchArea { enabled: parent.enabled; clicked => { root.profile-delete-confirm-id = ""; root.profile-edit-draft = ""; root.profile-edit-id = root.profile-edit-id == profile.id ? "" : profile.id; } }
                                        }
                                        delete-profile-focus := FocusScope {
                                            property <int> focus-serial: root.profile-delete-control-focus-serial;
                                            x: parent.width - 48px; y: 16px; width: 40px; height: 40px;
                                            enabled: root.subscription-refresh-enabled && root.profile-pending-operation == "none";
                                            focus-on-click: true; focus-on-tab-navigation: true;
                                            accessible-role: button; accessible-label: "Удалить " + profile.title; accessible-enabled: self.enabled;
                                            accessible-action-default => { if (self.enabled) { root.profile-edit-id = ""; root.profile-delete-confirm-id = profile.id; } }
                                            init => { if (root.profile-delete-control-focus-id == profile.id && root.profile-delete-control-focus-serial > 0) { self.focus(); } }
                                            changed focus-serial => { if (root.profile-delete-control-focus-id == profile.id && self.enabled) { self.focus(); } }
                                            Rectangle { border-radius: 8px; background: delete-profile-touch.has-hover && parent.enabled ? #f06a6a12 : transparent; border-color: parent.has-focus ? Theme.focus : Theme.line; border-width: 1px; Image { x: 11px; y: 11px; width: 18px; height: 18px; source: @image-url("../assets/trash.svg"); image-fit: contain; accessible-role: none; } }
                                            key-pressed(event) => { if ((event.text == " " || event.text == "\n") && self.enabled) { root.profile-edit-id = ""; root.profile-delete-confirm-id = profile.id; return accept; } return reject; }
                                            delete-profile-touch := TouchArea { enabled: parent.enabled; clicked => { root.profile-edit-id = ""; root.profile-delete-confirm-id = profile.id; } }
                                        }

                                        if root.profile-edit-id == profile.id: HorizontalLayout {
                                            x: 56px; y: 76px; width: parent.width - 68px; height: 50px; spacing: 8px;
                                            LineEdit { horizontal-stretch: 1; text <=> root.profile-edit-draft; placeholder-text: "Новый URL подписки"; enabled: root.profile-pending-operation == "none"; accessible-label: "Новый URL для " + profile.title; }
                                            SmallAction { width: 96px; label: "Сохранить"; enabled: root.profile-edit-draft != "" && root.profile-pending-operation == "none"; activated => { root.replace-profile-source(profile.id, root.profile-edit-draft); } }
                                            SmallAction { width: 72px; label: "Отмена"; enabled: root.profile-pending-operation == "none"; activated => { root.profile-edit-id = ""; root.profile-edit-draft = ""; } }
                                        }
                                        if root.profile-delete-confirm-id == profile.id: HorizontalLayout {
                                            x: 56px; y: 76px; width: parent.width - 68px; height: 50px; spacing: 8px;
                                            Text { horizontal-stretch: 1; text: "Удалить подписку?"; color: Theme.text-secondary; font-size: Theme.type-metadata-size; vertical-alignment: center; }
                                            SmallAction { width: 96px; label: "Удалить"; enabled: root.profile-pending-operation == "none"; activated => { root.delete-profile(profile.id); } }
                                            SmallAction { width: 72px; label: "Отмена"; enabled: root.profile-pending-operation == "none"; activated => { root.profile-delete-control-focus-id = profile.id; root.profile-delete-confirm-id = ""; root.profile-delete-control-focus-serial += 1; } }
                                        }
                                        Rectangle { x: 12px; y: parent.height - 1px; width: parent.width - 24px; height: 1px; background: Theme.line; }
                                    }
                                }
                            }
                            Rectangle { vertical-stretch: 1; background: transparent; }
                        }
                            }
                        }
                    }
                }
            }

            if root.profile-menu-open: TouchArea {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                clicked => { root.close-profile-menu(); }
            }

            if root.profile-menu-open: profile-menu := Rectangle {
                x: 20px;
                y: 188px;
                width: Math.min(320px, parent.width - 40px);
                height: Math.min(parent.height - self.y - 16px,
                    root.profile-menu-error != "" ? 104px
                    : root.profile-menu-loading ? 144px
                    : Math.min(288px, 16px + root.subscription-profiles.length * 54px));
                background: Theme.elevated;
                border-color: Theme.line;
                border-width: 1px;
                border-radius: 16px;
                clip: true;

                VerticalLayout {
                    padding: 8px;
                    spacing: 2px;

                    if root.profile-menu-error != "": Rectangle {
                        height: 88px;
                        background: transparent;
                        border-radius: 8px;
                        Text {
                            x: 8px; y: 4px; width: parent.width - 116px; height: 72px;
                            text: root.profile-menu-error;
                            color: Theme.error;
                            font-size: Theme.type-metadata-size;
                            wrap: word-wrap;
                            vertical-alignment: center;
                            accessible-role: text;
                            accessible-live-region: polite;
                        }
                        retry-profile-focus := FocusScope {
                            x: parent.width - 100px; y: 22px; width: 92px; height: 44px;
                            focus-on-click: true;
                            focus-on-tab-navigation: root.profile-menu-keyboard-open;
                            accessible-role: button;
                            accessible-label: "Повторить загрузку профилей";
                            accessible-action-default => { root.retry-profile-menu(); }
                            init => { if (root.profile-menu-keyboard-open) { self.focus(); } }
                            Rectangle {
                                border-radius: 8px;
                                background: retry-profile-touch.has-hover ? #ffffff0d : Theme.surface;
                                border-color: parent.has-focus && root.profile-menu-keyboard-open ? Theme.focus : Theme.line;
                                border-width: 1px;
                                Text { text: "Повторить"; color: Theme.text-primary; font-size: Theme.type-metadata-size; font-weight: Theme.weight-semibold; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            key-pressed(event) => { if (event.text == " " || event.text == "\n") { root.retry-profile-menu(); return accept; } return reject; }
                            retry-profile-touch := TouchArea { clicked => { root.retry-profile-menu(); } }
                        }
                    }

                    if root.profile-menu-loading: loading-focus := FocusScope {
                        height: 128px;
                        enabled: true;
                        accessible-role: text;
                        accessible-label: "Загружаем профили";
                        init => { if (root.profile-menu-keyboard-open) { self.focus(); } }
                        VerticalLayout {
                            spacing: 2px;
                            Text { height: 20px; text: "Загружаем профили…"; color: Theme.text-muted; font-size: Theme.type-metadata-size; vertical-alignment: center; accessible-role: text; accessible-live-region: polite; }
                            Rectangle {
                                height: 52px; background: #ffffff06; border-radius: 14px;
                                Rectangle { x: 10px; y: 10px; width: 32px; height: 32px; border-radius: 8px; background: #ffffff0a; }
                                Rectangle { x: 52px; y: 15px; width: parent.width - 92px; height: 9px; border-radius: 4px; background: #ffffff10; }
                                Rectangle { x: 52px; y: 30px; width: parent.width - 132px; height: 7px; border-radius: 4px; background: #ffffff08; }
                            }
                            Rectangle {
                                height: 52px; background: #ffffff04; border-radius: 14px;
                                Rectangle { x: 10px; y: 10px; width: 32px; height: 32px; border-radius: 8px; background: #ffffff0a; }
                                Rectangle { x: 52px; y: 15px; width: parent.width - 112px; height: 9px; border-radius: 4px; background: #ffffff10; }
                                Rectangle { x: 52px; y: 30px; width: parent.width - 152px; height: 7px; border-radius: 4px; background: #ffffff08; }
                            }
                        }
                    }

                    if !root.profile-menu-loading && root.profile-menu-error == "": profile-scroll := ScrollView {
                        vertical-stretch: 1;
                        horizontal-stretch: 1;
                        VerticalLayout {
                            spacing: 2px;
                            for profile[index] in root.subscription-profiles: profile-row := Rectangle {
                                height: 52px;
                                background: profile.active ? #4c9dff0c : profile-row-touch.has-hover ? #ffffff08 : transparent;
                                border-radius: 14px;
                                opacity: profile.available || profile.active ? 1 : 0.62;

                                Rectangle {
                                    x: 10px; y: 10px; width: 32px; height: 32px;
                                    border-radius: 8px;
                                    background: Theme.surface;
                                    if profile.has-logo: Image { x: 5px; y: 5px; width: 22px; height: 22px; source: profile.logo; image-fit: contain; accessible-role: none; }
                                    if !profile.has-logo: Text { text: profile.fallback; color: Theme.text-secondary; font-size: Theme.type-metadata-size; font-weight: Theme.weight-semibold; horizontal-alignment: center; vertical-alignment: center; }
                                }

                                Text {
                                    x: 52px; width: parent.width - 88px; height: parent.height;
                                    text: root.profile-pending-id == profile.id && root.profile-pending-operation == "activate" ? profile.title + " · Переключаем…" : profile.title;
                                    color: Theme.text-primary;
                                    font-size: Theme.type-label-size;
                                    font-weight: profile.active ? Theme.weight-semibold : Theme.weight-regular;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                                if profile.active: Path {
                                    x: parent.width - 28px; y: 18px; width: 16px; height: 16px;
                                    viewbox-width: 16; viewbox-height: 16;
                                    commands: "M 3 8 L 7 12 L 14 4";
                                    stroke: Theme.accent-blue; stroke-width: 1.5px; fill: transparent;
                                }

                                profile-row-focus := FocusScope {
                                    enabled: profile.available && root.profile-pending-operation == "none";
                                    focus-on-click: true;
                                    focus-on-tab-navigation: root.profile-menu-keyboard-open;
                                    accessible-role: button;
                                    accessible-label: profile.active ? profile.title + ", активная подписка" : "Активировать " + profile.title;
                                    accessible-enabled: self.enabled;
                                    accessible-action-default => { if (self.enabled) { if (profile.active) { root.close-profile-menu(); } else { root.activate-profile(profile.id); } } }
                                    init => { if (index == 0 && self.enabled && root.profile-menu-keyboard-open) { self.focus(); } }
                                    key-pressed(event) => {
                                        if ((event.text == " " || event.text == "\n") && self.enabled) {
                                            if (profile.active) { root.close-profile-menu(); } else { root.activate-profile(profile.id); }
                                            return accept;
                                        }
                                        return reject;
                                    }
                                    profile-row-touch := TouchArea { enabled: parent.enabled; clicked => { if (profile.active) { root.close-profile-menu(); } else { root.activate-profile(profile.id); } } }
                                    Rectangle { x: 2px; y: 2px; width: parent.width - 4px; height: parent.height - 4px; border-radius: 12px; border-width: parent.has-focus && root.profile-menu-keyboard-open ? 1px : 0px; border-color: Theme.focus; background: transparent; }
                                }
                            }
                        }
                    }
                }
            }
            }
        }
        }
    }

    // A taskbar restore has no application callback; the native minimized property
    // supplies the matching resume edge without waking a tray-hidden window.
    changed minimized => {
        root.shell-active = !root.minimized;
    }

    TouchArea {
        x: root.resize-border; y: 0px; width: parent.width - 2 * root.resize-border; height: root.resize-border;
        mouse-cursor: ns-resize;
        pointer-event(event) => { if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) { root.window-resize("n"); } }
    }
    TouchArea {
        x: parent.width - root.resize-border; y: root.resize-border; width: root.resize-border; height: parent.height - 2 * root.resize-border;
        mouse-cursor: ew-resize;
        pointer-event(event) => { if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) { root.window-resize("e"); } }
    }
    TouchArea {
        x: root.resize-border; y: parent.height - root.resize-border; width: parent.width - 2 * root.resize-border; height: root.resize-border;
        mouse-cursor: ns-resize;
        pointer-event(event) => { if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) { root.window-resize("s"); } }
    }
    TouchArea {
        x: 0px; y: root.resize-border; width: root.resize-border; height: parent.height - 2 * root.resize-border;
        mouse-cursor: ew-resize;
        pointer-event(event) => { if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) { root.window-resize("w"); } }
    }
    TouchArea {
        x: 0px; y: 0px; width: root.resize-border; height: root.resize-border;
        mouse-cursor: nwse-resize;
        pointer-event(event) => { if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) { root.window-resize("nw"); } }
    }
    TouchArea {
        x: parent.width - root.resize-border; y: 0px; width: root.resize-border; height: root.resize-border;
        mouse-cursor: nesw-resize;
        pointer-event(event) => { if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) { root.window-resize("ne"); } }
    }
    TouchArea {
        x: parent.width - root.resize-border; y: parent.height - root.resize-border; width: root.resize-border; height: root.resize-border;
        mouse-cursor: nwse-resize;
        pointer-event(event) => { if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) { root.window-resize("se"); } }
    }
    TouchArea {
        x: 0px; y: parent.height - root.resize-border; width: root.resize-border; height: root.resize-border;
        mouse-cursor: nesw-resize;
        pointer-event(event) => { if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) { root.window-resize("sw"); } }
    }
}
