import { LineEdit, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { PrimaryAction, QuietChip, RouteNodeRow } from "components.slint";
import "../assets/fonts/Twemoji.Mozilla.ttf";
export { TrayPopup, TrayMenuRow } from "tray_popup.slint";

export struct UiEvent {
    timestamp: string,
    component: string,
    level: string,
    message: string,
}

export struct UiCatalogGroup {
    id: string,
    icon: string,
    icon-image: image,
    label: string,
    selected: bool,
}

export struct UiCatalogNode {
    id: string,
    icon: string,
    icon-image: image,
    label: string,
    selected: bool,
    latency-text: string,
    latency-tone: string,
}

export struct UiProxyMapping {
    // A leading emoji (usually a flag) split off the name and drawn as an image.
    icon-image: image,
    proxy-name: string,
    address: string,
    xray-label: string,
}

export struct UiSubscriptionProfile {
    id: string,
    title: string,
    usage: string,
    expiry: string,
    active: bool,
    available: bool,
    has-logo: bool,
    logo: image,
    fallback: string,
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <image> icon-source;
    in property <bool> active;
    in property <bool> enabled: true;
    in property <bool> compact: false;
    // Small trailing count in the expanded rail (e.g. number of subscriptions).
    in property <string> badge;
    callback activated();

    height: root.compact ? 44px : 40px;
    background: root.active ? Theme.elevated : nav-touch.has-hover ? #ffffff08 : transparent;
    border-radius: 8px;
    border-width: nav-focus.has-focus ? 2px : 0px;
    border-color: Theme.focus;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.activated(); } }
    animate background { duration: 140ms; easing: ease-out; }

    Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: 3px;
        height: root.active ? 20px : 8px;
        border-radius: 1.5px;
        background: Theme.accent-blue;
        opacity: root.active ? 1 : 0;
        animate opacity, height { duration: 180ms; easing: ease-out; }
    }

    Image {
        x: root.compact ? (parent.width - self.width) / 2 : 12px;
        y: (parent.height - self.height) / 2;
        width: 20px;
        height: 20px;
        source: root.icon-source;
        colorize: root.active || nav-touch.has-hover ? Theme.text-primary : Theme.text-secondary;
        image-fit: contain;
        animate x { duration: 180ms; easing: ease-in-out; }
        animate colorize { duration: 140ms; easing: ease-out; }
    }

    // Always present so the label can fade in once the rail has widened,
    // instead of popping in over a still-narrow rail.
    nav-label := Text {
        x: root.compact ? 36px : 44px;
        width: Math.max(0px, parent.width - self.x - 12px - (root.badge == "" ? 0px : 24px));
        height: parent.height;
        text: root.label;
        color: root.active || nav-touch.has-hover ? Theme.text-primary : Theme.text-secondary;
        font-family: Theme.font-family;
        font-size: Theme.type-label-size;
        font-weight: root.active ? Theme.weight-semibold : Theme.weight-medium;
        vertical-alignment: center;
        overflow: clip;
        opacity: root.compact ? 0 : 1;
        visible: self.opacity > 0;
        accessible-role: none;
        animate opacity { duration: root.compact ? 80ms : 160ms; delay: root.compact ? 0ms : 90ms; easing: ease-out; }
        animate x { duration: 180ms; easing: ease-in-out; }
        animate color { duration: 140ms; easing: ease-out; }
    }

    if root.badge != "": Text {
        x: parent.width - self.width - 12px;
        width: 20px;
        height: parent.height;
        text: root.badge;
        color: Theme.text-muted;
        font-family: Theme.font-family;
        font-size: Theme.type-metadata-size;
        horizontal-alignment: right;
        vertical-alignment: center;
        opacity: nav-label.opacity;
        visible: self.opacity > 0;
        accessible-role: none;
    }

    nav-focus := FocusScope {
        enabled: root.enabled;
        focus-on-click: true;
        focus-on-tab-navigation: true;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.activated();
                return accept;
            }
            return reject;
        }
        nav-touch := TouchArea { enabled: root.enabled; clicked => { root.activated(); } }
    }
}

component NavToggle inherits Rectangle {
    in property <bool> collapsed;
    callback activated();

    height: 40px;
    border-radius: 8px;
    background: toggle-touch.has-hover ? #ffffff08 : transparent;
    border-width: toggle-focus.has-focus ? 2px : 0px;
    border-color: Theme.focus;
    accessible-role: button;
    accessible-label: root.collapsed ? "Развернуть меню" : "Свернуть меню";
    accessible-action-default => { root.activated(); }

    Path {
        x: root.collapsed ? (parent.width - self.width) / 2 : 18px;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: root.collapsed ? "M 6 3 L 11 8 L 6 13" : "M 10 3 L 5 8 L 10 13";
        stroke: toggle-touch.has-hover ? Theme.text-primary : Theme.text-muted;
        stroke-width: 1.6px;
        fill: transparent;
        animate x { duration: 180ms; easing: ease-in-out; }
    }

    Text {
        x: 44px;
        width: Math.max(0px, parent.width - 56px);
        height: parent.height;
        text: "Свернуть";
        color: toggle-touch.has-hover ? Theme.text-secondary : Theme.text-muted;
        font-family: Theme.font-family;
        font-size: Theme.type-metadata-size;
        vertical-alignment: center;
        overflow: clip;
        opacity: root.collapsed ? 0 : 1;
        visible: self.opacity > 0;
        accessible-role: none;
        animate opacity { duration: root.collapsed ? 80ms : 160ms; delay: root.collapsed ? 0ms : 90ms; easing: ease-out; }
    }

    toggle-focus := FocusScope {
        focus-on-click: true;
        focus-on-tab-navigation: true;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.activated();
                return accept;
            }
            return reject;
        }
        toggle-touch := TouchArea { clicked => { root.activated(); } }
    }
}

component SmallAction inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> selected: false;
    in property <int> focus-epoch: 0;
    out property <bool> action-has-focus: small-focus.has-focus;
    callback activated();
    callback focus-action();

    focus-action => { small-focus.focus(); }

    changed focus-epoch => {
        if (root.focus-epoch > 0) {
            small-focus.focus();
        }
    }

    min-width: 88px;
    preferred-width: small-label.preferred-width + 28px;
    max-width: 160px;
    horizontal-stretch: 0;
    height: 44px;
    background: root.selected ? #4c9dff18 : root.enabled ? (small-touch.pressed ? Theme.elevated : small-touch.has-hover ? #ffffff0d : transparent) : transparent;
    border-color: small-focus.has-focus ? Theme.focus : root.selected ? #4c9dff88 : Theme.line;
    border-width: small-focus.has-focus ? 2px : 1px;
    border-radius: 8px;
    opacity: root.enabled ? 1 : 0.45;
    accessible-role: button;
    accessible-label: root.label;
    accessible-description: root.selected ? "Выбранный фильтр" : "";
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.activated(); } }

    small-label := Text {
        x: 8px;
        width: parent.width - 16px;
        text: root.label;
        overflow: elide;
        color: root.selected ? Theme.text-primary : Theme.text-secondary;
        font-family: Theme.font-family;
        font-size: Theme.type-metadata-size;
        font-weight: Theme.weight-semibold;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    small-focus := FocusScope {
        enabled: root.enabled;
        focus-on-click: true;
        focus-on-tab-navigation: true;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.activated();
                return accept;
            }
            return reject;
        }
        small-touch := TouchArea { enabled: root.enabled; clicked => { root.activated(); } }
    }
}

// Reduced-motion flag for components (mirrors AppWindow.reduced-motion).
global Motion {
    in-out property <bool> reduced: false;
}

component SectionCaption inherits Text {
    color: Theme.text-muted;
    font-family: Theme.font-family;
    font-size: 11px;
    font-weight: Theme.weight-semibold;
    letter-spacing: 0.6px;
    vertical-alignment: center;
    overflow: elide;
}

// Muted note under an inset grouped card.
component Footnote inherits Text {
    color: Theme.text-muted;
    font-family: Theme.font-family;
    font-size: Theme.type-metadata-size;
    wrap: word-wrap;
}

// Quiet iOS-style text button: a tinted label, no chrome; ring only on focus.
component TextAction inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <bool> enabled: true;
    // "accent" (blue), "danger" (red) or "neutral" (secondary text).
    in property <string> tone: "accent";
    // Why the action is unavailable, for assistive technology.
    in property <string> disabled-hint;
    in property <int> focus-epoch: 0;
    // Momentary feedback ("Скопировано ✓") crossfades over the label.
    in property <string> swap-label;
    in property <bool> swapped: false;
    callback activated();

    changed focus-epoch => {
        if (root.focus-epoch > 0) {
            text-focus.focus();
        }
    }

    property <color> tint: !root.enabled ? Theme.text-muted
        : root.tone == "danger" ? (text-touch.has-hover ? #ff8a8a : Theme.error)
        : root.tone == "neutral" ? (text-touch.has-hover ? Theme.text-primary : Theme.text-secondary)
        : (text-touch.has-hover ? Theme.accent-blue-hover : Theme.accent-blue);

    min-width: Math.max(text-label.preferred-width, swap-text.preferred-width) + (root.has-icon ? 22px : 0px) + 12px;
    preferred-width: self.min-width;
    horizontal-stretch: 0;
    height: 32px;
    border-radius: 6px;
    background: text-touch.pressed && root.enabled ? #ffffff0d : transparent;
    border-color: Theme.focus;
    border-width: text-focus.has-focus ? Theme.focus-width : 0px;
    opacity: root.enabled ? 1 : 0.6;
    accessible-role: button;
    accessible-label: root.swapped && root.swap-label != "" ? root.swap-label : root.label;
    accessible-description: root.enabled ? "" : root.disabled-hint;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.activated(); } }

    if root.has-icon: Image {
        x: 6px;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        source: root.icon;
        colorize: root.tint;
        image-fit: contain;
        accessible-role: none;
    }
    text-label := Text {
        x: root.has-icon ? 28px : 6px;
        width: parent.width - self.x - 6px;
        height: parent.height;
        text: root.label;
        color: root.tint;
        font-family: Theme.font-family;
        font-size: 13px;
        font-weight: root.tone == "neutral" ? Theme.weight-medium : Theme.weight-semibold;
        horizontal-alignment: root.swap-label == "" ? left : right;
        vertical-alignment: center;
        overflow: elide;
        opacity: root.swapped ? 0 : 1;
        accessible-role: none;
        animate color { duration: 160ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
        animate opacity { duration: Motion.reduced ? 0ms : 200ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
    }
    swap-text := Text {
        x: text-label.x;
        width: text-label.width;
        height: parent.height;
        text: root.swap-label;
        color: Theme.accent-green;
        font-family: Theme.font-family;
        font-size: 13px;
        font-weight: Theme.weight-semibold;
        horizontal-alignment: right;
        vertical-alignment: center;
        opacity: root.swapped ? 1 : 0;
        accessible-role: none;
        animate opacity { duration: Motion.reduced ? 0ms : 200ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
    }
    text-focus := FocusScope {
        enabled: root.enabled;
        focus-on-click: true;
        focus-on-tab-navigation: true;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.activated();
                return accept;
            }
            return reject;
        }
        text-touch := TouchArea { enabled: root.enabled; clicked => { root.activated(); } }
    }
}

// Single-line URL field with a link glyph; the focus ring is the blue border.
component UrlField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> enabled: true;
    in property <string> accessible-name;
    callback accepted();
    forward-focus: url-input;

    height: 36px;
    border-radius: 8px;
    background: Theme.elevated;
    border-width: 1px;
    border-color: url-input.has-focus ? #4c9dff99 : Theme.line;
    opacity: root.enabled ? 1 : 0.6;
    animate border-color { duration: 160ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }

    Image {
        x: 11px;
        y: (parent.height - self.height) / 2;
        width: 14px;
        height: 14px;
        source: @image-url("../assets/link.svg");
        colorize: Theme.text-muted;
        image-fit: contain;
        accessible-role: none;
    }
    if root.text == "": Text {
        x: 33px;
        width: parent.width - 43px;
        height: parent.height;
        text: root.placeholder;
        color: Theme.text-muted;
        font-family: Theme.font-family;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: none;
    }
    url-input := TextInput {
        x: 33px;
        width: parent.width - 43px;
        height: parent.height;
        text <=> root.text;
        enabled: root.enabled;
        single-line: true;
        color: Theme.text-primary;
        font-family: Theme.font-family;
        font-size: 13px;
        vertical-alignment: center;
        accessible-label: root.accessible-name;
        accepted => { root.accepted(); }
    }
}

// Tappable row of an inset grouped card (first-run actions).
component ActionRow inherits Rectangle {
    in property <string> label;
    in property <string> state-label: root.label;
    in property <image> icon;
    in property <bool> accent: false;
    in property <bool> chevron: false;
    in property <bool> expanded: false;
    in property <bool> enabled: true;
    in property <bool> show-separator: false;
    in property <int> focus-epoch: 0;
    callback activated();

    changed focus-epoch => {
        if (root.focus-epoch > 0) {
            row-focus.focus();
        }
    }

    height: 52px;
    background: row-touch.has-hover && root.enabled ? #ffffff08 : transparent;
    border-color: Theme.focus;
    border-width: row-focus.has-focus ? Theme.focus-width : 0px;
    opacity: root.enabled ? 1 : 0.6;
    animate background { duration: 160ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
    accessible-role: button;
    accessible-label: root.state-label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.activated(); } }

    Image {
        x: 16px;
        y: (parent.height - self.height) / 2;
        width: 20px;
        height: 20px;
        source: root.icon;
        colorize: root.accent ? Theme.accent-blue : Theme.text-secondary;
        image-fit: contain;
        accessible-role: none;
    }
    Text {
        x: 48px;
        width: parent.width - self.x - 40px;
        height: parent.height;
        text: root.label;
        color: root.accent ? Theme.accent-blue : Theme.text-secondary;
        font-family: Theme.font-family;
        font-size: Theme.type-label-size;
        font-weight: Theme.weight-medium;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: none;
    }
    if root.chevron: Image {
        x: parent.width - self.width - 16px;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        source: @image-url("../assets/chevron-right.svg");
        colorize: Theme.text-muted;
        transform-rotation: root.expanded ? 90deg : 0deg;
        image-fit: contain;
        accessible-role: none;
        animate transform-rotation { duration: Motion.reduced ? 0ms : 240ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
    }
    if root.show-separator: Rectangle {
        x: 48px;
        y: parent.height - 1px;
        width: parent.width - 48px;
        height: 1px;
        background: #ffffff0f;
    }
    row-focus := FocusScope {
        enabled: root.enabled;
        focus-on-click: true;
        focus-on-tab-navigation: true;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.activated();
                return accept;
            }
            return reject;
        }
        row-touch := TouchArea { enabled: root.enabled; clicked => { root.activated(); } }
    }
}

component HealthRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> tone;
    in property <bool> show-separator: false;

    height: 44px;
    background: transparent;

    Rectangle {
        x: 16px;
        y: (parent.height - self.height) / 2;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: root.tone == "success" ? Theme.accent-green : root.tone == "danger" ? Theme.error : root.tone == "warning" ? Theme.warning : Theme.text-muted;
        animate background { duration: 240ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
    }
    Text {
        x: 36px;
        width: parent.width - 196px;
        height: parent.height;
        text: root.label;
        color: Theme.text-primary;
        font-family: Theme.font-family;
        font-size: Theme.type-label-size;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        x: parent.width - self.width - 16px;
        width: 140px;
        height: parent.height;
        text: root.value;
        color: Theme.text-secondary;
        font-family: Theme.font-family;
        font-size: Theme.type-metadata-size;
        horizontal-alignment: right;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.show-separator: Rectangle {
        x: 36px;
        y: parent.height - 1px;
        width: parent.width - 36px;
        height: 1px;
        background: #ffffff0f;
    }
}

// Settings row with an iOS switch (green when on). Rows sit inside a card that
// supplies the 16px side padding; the hairline runs to the card's right edge.
component ToggleRow inherits Rectangle {
    in property <string> label;
    in property <string> description;
    in property <bool> checked;
    in property <bool> enabled: true;
    in property <bool> show-separator: false;
    callback toggled(bool);

    height: root.description == "" ? 48px : 60px;
    background: transparent;
    accessible-role: checkbox;
    accessible-label: root.label;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.toggled(!root.checked); } }

    Text {
        x: 0;
        y: root.description == "" ? 0px : 10px;
        width: parent.width - 64px;
        height: root.description == "" ? parent.height : 20px;
        text: root.label;
        color: root.enabled ? Theme.text-primary : Theme.text-secondary;
        font-family: Theme.font-family;
        font-size: Theme.type-label-size;
        font-weight: Theme.weight-medium;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.description != "": Text {
        x: 0;
        y: 31px;
        width: parent.width - 64px;
        text: root.description;
        color: Theme.text-muted;
        font-family: Theme.font-family;
        font-size: Theme.type-metadata-size;
        overflow: elide;
    }
    Rectangle {
        x: parent.width - self.width;
        y: (parent.height - self.height) / 2;
        width: 44px;
        height: 26px;
        border-radius: 13px;
        background: root.checked ? Theme.accent-green : Theme.line;
        border-color: Theme.focus;
        border-width: toggle-focus.has-focus ? 2px : 0px;
        opacity: root.enabled ? 1 : 0.45;
        animate background { duration: 220ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
        Rectangle {
            x: root.checked ? parent.width - self.width - 3px : 3px;
            y: 3px;
            width: 20px;
            height: 20px;
            border-radius: 10px;
            background: #ffffff;
            drop-shadow-blur: 4px;
            drop-shadow-offset-y: 1px;
            drop-shadow-color: #00000059;
            animate x { duration: Motion.reduced ? 0ms : 260ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
        }
    }
    if root.show-separator: Rectangle {
        x: 0;
        y: parent.height - 1px;
        width: parent.width + 16px;
        height: 1px;
        background: #ffffff0f;
    }
    toggle-focus := FocusScope {
        enabled: root.enabled;
        focus-on-click: true;
        focus-on-tab-navigation: true;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.toggled(!root.checked);
                return accept;
            }
            return reject;
        }
        toggle-touch := TouchArea { enabled: root.enabled; clicked => { root.toggled(!root.checked); } }
    }
}

component TitleBarButton inherits Rectangle {
    in property <string> kind;
    in property <string> state-label;
    in property <bool> enabled: true;
    callback activated();

    width: 44px;
    height: 44px;
    background: title-touch.pressed
        ? (root.kind == "close" ? #b52b38 : #ffffff16)
        : title-touch.has-hover
            ? (root.kind == "close" ? #c42b3a : #ffffff0d)
            : transparent;
    border-width: title-focus.has-focus ? 2px : 0px;
    border-color: Theme.focus;
    accessible-role: button;
    accessible-label: root.state-label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.activated(); } }

    if root.kind == "minimize": Rectangle {
        x: 17px;
        y: 22px;
        width: 10px;
        height: 1px;
        background: Theme.text-secondary;
    }

    if root.kind == "maximize": Rectangle {
        x: 17px;
        y: 17px;
        width: 10px;
        height: 10px;
        background: transparent;
        border-width: 1px;
        border-color: Theme.text-secondary;
    }

    if root.kind == "restore": Rectangle {
        x: 16px;
        y: 18px;
        width: 9px;
        height: 8px;
        background: transparent;
        border-width: 1px;
        border-color: Theme.text-secondary;
        Rectangle {
            x: 2px;
            y: -3px;
            width: 9px;
            height: 8px;
            background: #0a0c0f;
            border-width: 1px;
            border-color: Theme.text-secondary;
        }
    }

    if root.kind == "close": Image {
        x: 16px;
        y: 16px;
        width: 12px;
        height: 12px;
        source: @image-url("../assets/close.svg");
        image-fit: contain;
    }

    title-focus := FocusScope {
        enabled: root.enabled;
        focus-on-click: true;
        focus-on-tab-navigation: true;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.activated();
                return accept;
            }
            return reject;
        }
        title-touch := TouchArea { enabled: root.enabled; clicked => { root.activated(); } }
    }
}

export component AppWindow inherits Window {
    title: "MultiCore";
    icon: @image-url("../assets/app-icon.svg");
    no-frame: true;
    preferred-width: 840px;
    preferred-height: 720px;
    min-width: 700px;
    min-height: 620px;
    background: Theme.canvas;
    default-font-family: Theme.font-family;

    in property <string> status-eyebrow: "Профиль не добавлен";
    in property <string> headline: "Добавьте подписку";
    in property <string> supporting: "Вставьте URL — остальное настроим автоматически.";
    in property <string> node-name: "Маршрут не выбран";
    in property <string> node-icon: "";
    in property <image> node-icon-image;
    in property <bool> has-profile: false;
    in property <string> primary-label: "Подключить";
    in property <bool> primary-enabled: false;
    // The Mihomo dashboard is only meaningful while a live, authenticated controller
    // session exists, i.e. while Connected.
    in property <bool> dashboard-available: false;
    in property <string> status-tone: "neutral";
    // Connection toggle (home): see toggle_presentation in main.rs.
    in property <string> toggle-title: "Защита выключена";
    in property <bool> toggle-on: false;
    in property <bool> toggle-busy: false;
    in property <bool> toggle-detail-is-exit: true;
    in property <string> session-uptime;
    in property <string> traffic-down;
    // Latency of the exit node, when the visible route list knows it.
    in property <string> node-latency;
    in property <string> traffic-up;
    in property <bool> import-pending: false;
    in property <string> import-error;
    in property <string> subscription-title: "Подписка";
    in property <string> subscription-usage: "Нет данных";
    in property <string> subscription-expiry: "Добавьте ссылку";
    in property <string> subscription-updated: "Не обновлялась";
    in property <bool> subscription-updated-stale: false;
    in property <image> service-logo;
    in property <bool> has-service-logo: false;
    in property <string> subscription-announcement-text;
    in property <string> subscription-announcement-tone: "info";
    in property <bool> subscription-refresh-available: false;
    in property <bool> subscription-refresh-enabled: false;
    in property <bool> subscription-management-enabled: false;
    in property <bool> subscription-refresh-pending: false;
    in property <string> subscription-refresh-error;
    in property <[UiSubscriptionProfile]> subscription-profiles;
    in property <bool> profile-menu-loading: false;
    in property <string> profile-menu-error;
    in property <string> profile-mutation-error;
    in property <bool> profile-switch-locked: false;
    in property <string> active-profile-id;
    in property <string> profile-pending-operation: "none";
    in property <string> profile-pending-id;
    in property <string> active-panel: "none";
    in-out property <string> event-filter: "Все";
    in property <[UiEvent]> events;
    in property <[UiCatalogGroup]> catalog-groups;
    in property <[UiCatalogNode]> catalog-nodes;
    in property <bool> catalog-loading: false;
    in property <bool> catalog-selection-enabled: false;
    in property <bool> catalog-selection-pending: false;
    in property <string> catalog-error;
    in property <bool> latency-check-loading: false;
    in property <string> latency-check-error;
    in property <string> diagnostics-xray-value: "Остановлен";
    in property <string> diagnostics-xray-tone: "neutral";
    in property <string> diagnostics-mihomo-value: "Остановлен";
    in property <string> diagnostics-mihomo-tone: "neutral";
    in property <string> diagnostics-tun-value: "Остановлен";
    in property <string> diagnostics-tun-tone: "neutral";
    in property <bool> diagnostics-loading: false;
    in property <[UiProxyMapping]> diagnostic-mappings;
    in property <bool> launch-at-sign-in-enabled: false;
    in property <bool> launch-at-sign-in-stale: false;
    in property <string> launch-at-sign-in-error;
    in-out property <bool> auto-connect-on-startup: false;
    // TUN (all traffic) vs the system proxy without an administrator prompt; next connect.
    in-out property <bool> tun-enabled: true;
    in property <bool> tun-toggle-available: false;
    in property <string> preference-error;
    in-out property <bool> ambient-background-enabled: true;
    // Icon-only navigation rail; collapsed on first run, remembered after.
    in-out property <bool> navigation-collapsed: true;
    in-out property <bool> shell-active: true;
    in property <bool> reduced-motion: false;
    in property <string> system-name: "Windows";
    in property <string> runtime-versions: "MultiCore";
    private property <bool> ambient-wave-phase: false;
    private property <bool> ambient-wave-started: false;
    private property <bool> ambient-motion-active: root.ambient-background-enabled && root.shell-active && !root.reduced-motion && !root.minimized && root.visible-page == "home";
    in-out property <bool> replace-editor-open: false;
    in-out property <int> import-success-serial: 0;
    in-out property <bool> first-run-manual-open: false;
    private property <int> first-run-input-focus-serial: 0;
    private property <int> first-run-trigger-focus-serial: 0;
    private property <int> power-action-focus-serial: 0;
    in property <bool> update-available: false;
    in property <string> update-status: "MultiCore 0.3.0";
    in property <string> update-detail: "Канал обновлений не настроен";
    in property <string> update-action-label;
    in property <bool> update-action-enabled: false;
    in property <bool> update-busy: false;
    // A connect/disconnect/import is in flight: installing now cannot start.
    in property <bool> update-runtime-busy: false;
    in-out property <string> update-banner-dismissed-for;
    // Provider notice popover, opened from the title-bar bell.
    in-out property <bool> announcement-open: false;
    // Fingerprint of the notice last shown (persisted); see announcement_fingerprint.
    in-out property <string> announcement-seen;
    in property <bool> conflicting-apps-banner-visible: false;
    in property <string> conflicting-apps-message;
    in-out property <bool> update-confirm-open: false;
    in-out property <bool> deep-link-confirm-open: false;
    in-out property <int> update-confirm-focus-serial: 0;
    in property <string> deep-link-confirm-host;
    in-out property <string> deep-link-import-host;
    in-out property <int> deep-link-focus-serial: 0;

    in-out property <string> local-page: "home";
    in-out property <string> settings-section: "general";
    in-out property <string> profile-edit-id;
    in-out property <string> profile-edit-draft;
    in-out property <string> profile-management-focus-id;
    in-out property <int> profile-management-focus-serial;
    in-out property <string> profile-delete-control-focus-id;
    in-out property <int> profile-delete-control-focus-serial;
    private property <string> visible-page: root.active-panel == "routes" ? "home" : root.active-panel == "events" ? "status" : root.local-page;
    private property <bool> profile-menu-open: root.active-panel == "subscription";
    // True for one frame after the page changes, so the new page starts hidden and
    // eases in. Pages are created by `if`, so this is the only enter hook.
    private property <bool> page-entering: false;
    private property <bool> profile-menu-was-open: false;
    private property <bool> profile-menu-keyboard-open: false;
    private property <int> profile-shelf-focus-serial: 0;
    in-out property <string> profile-delete-confirm-id;
    private property <bool> catalog-group-navigation-enabled: !root.catalog-loading && root.catalog-groups.length > 0;
    private property <bool> update-banner-visible: root.update-available && root.update-status != root.update-banner-dismissed-for;
    private property <length> profile-menu-content-height: (root.profile-switch-locked ? 28px : 0px)
        + (root.profile-mutation-error != "" ? 40px : 0px)
        + (root.profile-menu-error != "" ? 104px
            : root.profile-menu-loading ? 144px
            : Math.min(288px, 16px + root.subscription-profiles.length * 54px));
    private property <length> resize-border: 6px;
    in-out property <string> subscription-draft;

    callback import-url(string) -> bool;
    callback paste-subscription();
    callback dismiss-first-run-import();
    callback refresh-subscription();
    callback open-profile-menu();
    callback close-profile-menu();
    callback activate-profile(string);
    callback refresh-profile(string);
    callback replace-profile-source(string, string);
    callback delete-profile(string);
    callback add-subscription();
    callback retry-profile-menu();
    callback primary-action();
    callback open-dashboard();
    callback open-panel(string);
    callback close-panel();
    callback escape-pressed();
    callback filter-events(string);
    callback copy-diagnostics();
    in-out property <bool> diagnostics-copied: false;
    callback select-catalog-group(string);
    callback select-catalog-node(string);
    callback set-launch-at-sign-in(bool);
    callback window-drag();
    callback window-resize(string);
    callback window-minimize();
    callback window-toggle-maximize();
    callback window-close();
    callback update-action();
    callback confirm-update-restart();
    callback cancel-update-restart();
    callback dismiss-conflicting-apps-banner();
    callback close-conflicting-apps();
    in property <bool> conflicting-apps-closing: false;
    callback confirm-deep-link();
    callback cancel-deep-link();

    init => { Motion.reduced = root.reduced-motion; }
    changed reduced-motion => { Motion.reduced = root.reduced-motion; }

    page-enter := Timer {
        interval: 16ms;
        running: root.page-entering;
        triggered => { root.page-entering = false; }
    }

    changed visible-page => {
        if (!root.reduced-motion) {
            root.page-entering = true;
        }
    }

    wave-kickoff := Timer {
        interval: 80ms;
        running: root.ambient-motion-active && !root.ambient-wave-started;
        triggered => {
            root.ambient-wave-started = true;
            root.ambient-wave-phase = !root.ambient-wave-phase;
        }
    }

    wave-timer := Timer {
        interval: 12s;
        running: root.ambient-motion-active && root.ambient-wave-started;
        triggered => { root.ambient-wave-phase = !root.ambient-wave-phase; }
    }

    changed ambient-motion-active => {
        if (!root.ambient-motion-active) {
            root.ambient-wave-started = false;
        }
    }

    changed import-success-serial => {
        if (root.import-success-serial > 0) {
            root.replace-editor-open = false;
            root.first-run-manual-open = false;
            root.subscription-draft = "";
            if (root.has-profile && root.visible-page == "home") {
                if (root.primary-enabled) {
                    root.power-action-focus-serial += 1;
                } else {
                    root.profile-shelf-focus-serial += 1;
                }
            }
        }
    }

    changed active-panel => {
        if (root.active-panel == "subscription") {
            root.profile-menu-was-open = true;
        } else {
            root.profile-delete-confirm-id = "";
            if (root.profile-menu-was-open && root.profile-menu-keyboard-open) {
                root.profile-shelf-focus-serial += 1;
            }
            root.profile-menu-was-open = false;
            root.profile-menu-keyboard-open = false;
        }
    }

    visual-frame := FocusScope {
        enabled: !root.deep-link-confirm-open && !root.update-confirm-open;
        x: root.resize-border;
        y: root.resize-border;
        width: parent.width - 2 * root.resize-border;
        height: parent.height - 2 * root.resize-border;
        capture-key-pressed(event) => {
            if (root.deep-link-confirm-open) {
                if (event.text == Key.Escape) { root.cancel-deep-link(); return accept; }
                // Async background work may have restored focus behind the modal.
                root.deep-link-focus-serial += 1;
                return accept;
            }
            if (root.update-confirm-open) {
                if (event.text == Key.Escape) {
                    root.update-confirm-open = false;
                    root.cancel-update-restart();
                    return accept;
                }
                root.update-confirm-focus-serial += 1;
                return accept;
            }
            return reject;
        }
        capture-key-released(event) => {
            if (root.deep-link-confirm-open || root.update-confirm-open) { return accept; }
            return reject;
        }
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                if (root.deep-link-confirm-open) {
                    root.cancel-deep-link();
                } else if (root.update-confirm-open) {
                    root.update-confirm-open = false;
                    root.cancel-update-restart();
                } else if (!root.has-profile && root.first-run-manual-open) {
                    root.first-run-manual-open = false;
                    root.subscription-draft = "";
                    root.dismiss-first-run-import();
                    root.first-run-trigger-focus-serial += 1;
                } else if (root.announcement-open) {
                    root.announcement-open = false;
                } else if (root.profile-delete-confirm-id != "") {
                    root.profile-delete-control-focus-id = root.profile-delete-confirm-id;
                    root.profile-delete-confirm-id = "";
                    root.profile-delete-control-focus-serial += 1;
                } else if (root.profile-edit-id != "") {
                    root.profile-edit-id = "";
                    root.profile-edit-draft = "";
                } else { root.escape-pressed(); }
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            spacing: 0px;

            title-bar := Rectangle {
                height: 44px;
                background: #0a0c0f;
                border-color: Theme.line;
                border-width: 0px;

                drag-region := Rectangle {
                    x: 0px;
                    y: 0px;
                    width: parent.width - 132px;
                    height: parent.height;
                    background: transparent;

                    Image {
                        x: root.navigation-collapsed ? 22px : 14px;
                        y: 12px;
                        width: 20px;
                        height: 20px;
                        source: @image-url("../assets/app-icon.svg");
                        image-fit: contain;
                        animate x { duration: 180ms; easing: ease-in-out; }
                    }

                    if !root.navigation-collapsed: Text {
                        x: 42px;
                        width: 112px;
                        height: parent.height;
                        text: "MultiCore";
                        color: Theme.text-primary;
                        font-family: Theme.font-family;
                        font-size: Theme.type-label-size;
                        font-weight: Theme.weight-semibold;
                        vertical-alignment: center;
                    }

                    drag-touch := TouchArea {
                        moved => { root.window-drag(); }
                        double-clicked => { root.window-toggle-maximize(); }
                    }
                }

                // Active subscription lives in the window title: name + expiry opens the
                // profile menu, then refresh and the provider-notice bell.
                if root.has-profile: title-subscription := Rectangle {
                    property <length> logo-space: root.has-service-logo ? 22px : 0px;
                    property <length> chip-width: Math.min(
                        self.width - 72px,
                        10px + self.logo-space + chip-title.preferred-width + 6px + chip-meta.preferred-width + 8px + 12px + 8px);
                    x: root.navigation-collapsed ? 56px : 168px;
                    y: 8px;
                    width: Math.max(0px, parent.width - self.x - 148px);
                    height: 28px;
                    animate x { duration: 180ms; easing: ease-in-out; }

                    subscription-chip := Rectangle {
                        x: 0;
                        y: 0;
                        width: parent.chip-width;
                        height: parent.height;
                        border-radius: 6px;
                        background: root.profile-menu-open ? #ffffff12 : chip-touch.has-hover ? #ffffff0a : transparent;
                        border-color: shelf-open-focus.has-focus ? Theme.focus : transparent;
                        border-width: shelf-open-focus.has-focus ? Theme.focus-width : 0px;
                        animate background { duration: 120ms; easing: ease-out; }

                        if root.has-service-logo: Image {
                            x: 8px;
                            y: 6px;
                            width: 16px;
                            height: 16px;
                            source: root.service-logo;
                            image-fit: contain;
                            accessible-role: none;
                        }
                        chip-title := Text {
                            x: 10px + title-subscription.logo-space;
                            width: Math.min(self.preferred-width, Math.max(24px, parent.width - self.x - chip-meta.preferred-width - 34px));
                            height: parent.height;
                            text: root.subscription-title;
                            color: Theme.text-primary;
                            font-size: Theme.type-metadata-size;
                            font-weight: Theme.weight-semibold;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        chip-meta := Text {
                            x: chip-title.x + chip-title.width + 6px;
                            width: Math.max(0px, Math.min(self.preferred-width, parent.width - self.x - 28px));
                            height: parent.height;
                            text: root.subscription-refresh-error != "" ? "Не удалось обновить" : "· " + root.subscription-expiry;
                            color: root.subscription-refresh-error != "" ? Theme.error : Theme.text-muted;
                            font-size: Theme.type-metadata-size;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        chip-chevron := Path {
                            x: parent.width - 20px;
                            y: 10px;
                            width: 12px;
                            height: 8px;
                            viewbox-width: 12;
                            viewbox-height: 8;
                            commands: root.profile-menu-open ? "M 1 7 L 6 2 L 11 7" : "M 1 1 L 6 6 L 11 1";
                            stroke: Theme.text-muted;
                            stroke-width: 1.5px;
                            fill: transparent;
                        }

                        shelf-open-focus := FocusScope {
                            property <int> focus-serial: root.profile-shelf-focus-serial;
                            enabled: true;
                            focus-on-click: true;
                            focus-on-tab-navigation: true;
                            accessible-role: button;
                            accessible-label: "Выбрать профиль подписки";
                            accessible-description: root.subscription-title + ". Обновлено " + root.subscription-updated + ". " + (root.profile-menu-open ? "Список профилей открыт" : "Открыть список профилей");
                            accessible-enabled: self.enabled;
                            accessible-action-default => { self.toggle-menu(true); }
                            changed focus-serial => { self.focus(); }
                            function toggle-menu(keyboard: bool) {
                                root.announcement-open = false;
                                if (root.profile-menu-open) { root.close-profile-menu(); }
                                else if (root.subscription-profiles.length == 0 && !root.profile-menu-loading && root.profile-menu-error == "") {
                                    root.local-page = "subscriptions";
                                    root.close-panel();
                                } else { root.profile-menu-keyboard-open = keyboard; root.open-profile-menu(); }
                            }
                            key-pressed(event) => {
                                if (event.text == " " || event.text == "\n") {
                                    self.toggle-menu(true);
                                    return accept;
                                }
                                return reject;
                            }
                            chip-touch := TouchArea {
                                clicked => { shelf-open-focus.toggle-menu(false); }
                            }
                        }
                    }

                    subscription-refresh-action := FocusScope {
                        // Without a refreshable remote source the same slot lets the
                        // user set the active subscription's URL instead of showing a
                        // dead button.
                        property <bool> source-mode: !root.subscription-refresh-available;
                        x: parent.chip-width + 4px;
                        y: 0;
                        width: 28px;
                        height: 28px;
                        enabled: self.source-mode
                            ? root.subscription-management-enabled && root.active-profile-id != "" && !root.profile-menu-open
                            : root.subscription-refresh-enabled && !root.subscription-refresh-pending && !root.profile-menu-open;
                        focus-on-click: true;
                        focus-on-tab-navigation: true;
                        accessible-role: button;
                        accessible-label: self.source-mode ? "Указать ссылку подписки" : root.subscription-refresh-pending ? "Подписка обновляется" : "Обновить подписку";
                        accessible-enabled: self.enabled;
                        accessible-action-default => { if (self.enabled) { self.run(); } }
                        function run() {
                            if (self.source-mode) {
                                root.local-page = "subscriptions";
                                root.close-panel();
                                root.profile-delete-confirm-id = "";
                                root.profile-edit-draft = "";
                                root.profile-edit-id = root.active-profile-id;
                            } else {
                                root.refresh-subscription();
                            }
                        }
                        key-pressed(event) => {
                            if ((event.text == " " || event.text == "\n") && self.enabled) {
                                self.run();
                                return accept;
                            }
                            return reject;
                        }
                        Rectangle {
                            border-radius: 6px;
                            background: subscription-refresh-touch.pressed && parent.enabled ? Theme.elevated : subscription-refresh-touch.has-hover && parent.enabled ? #ffffff0d : transparent;
                            border-color: parent.has-focus ? Theme.focus : transparent;
                            border-width: parent.has-focus ? Theme.focus-width : 0px;
                            animate background { duration: 120ms; easing: ease-out; }
                            Image {
                                x: 7px;
                                y: 7px;
                                width: 14px;
                                height: 14px;
                                source: subscription-refresh-action.source-mode ? @image-url("../assets/link.svg") : @image-url("../assets/refresh.svg");
                                colorize: root.subscription-refresh-pending ? Theme.accent-blue : Theme.text-secondary;
                                opacity: subscription-refresh-action.enabled || root.subscription-refresh-pending ? 1 : 0.45;
                                // Spins while the subscription is being fetched.
                                transform-rotation: root.subscription-refresh-pending && !root.reduced-motion
                                    ? Math.mod(animation-tick() / 1ms, 900) / 900 * 360deg
                                    : 0deg;
                                image-fit: contain;
                                accessible-role: none;
                            }
                        }
                        subscription-refresh-touch := TouchArea {
                            enabled: parent.enabled;
                            clicked => { subscription-refresh-action.run(); }
                        }
                    }

                    if root.subscription-announcement-text != "": announcement-bell := FocusScope {
                        x: parent.chip-width + 36px;
                        y: 0;
                        width: 28px;
                        height: 28px;
                        focus-on-click: true;
                        focus-on-tab-navigation: true;
                        accessible-role: button;
                        accessible-label: root.announcement-open ? "Скрыть сообщение провайдера" : "Сообщение провайдера";
                        accessible-action-default => { self.toggle(); }
                        function toggle() {
                            if (root.profile-menu-open) { root.close-profile-menu(); }
                            root.announcement-open = !root.announcement-open;
                        }
                        key-pressed(event) => {
                            if (event.text == " " || event.text == "\n") {
                                self.toggle();
                                return accept;
                            }
                            return reject;
                        }
                        Rectangle {
                            border-radius: 6px;
                            background: root.announcement-open ? #ffffff12 : bell-touch.has-hover ? #ffffff0d : transparent;
                            border-color: parent.has-focus ? Theme.focus : transparent;
                            border-width: parent.has-focus ? Theme.focus-width : 0px;
                            animate background { duration: 120ms; easing: ease-out; }
                            Image {
                                x: 6px;
                                y: 6px;
                                width: 16px;
                                height: 16px;
                                source: @image-url("../assets/bell.svg");
                                colorize: Theme.text-secondary;
                                image-fit: contain;
                                accessible-role: none;
                            }
                            // Unread-style dot tinted by the notice's tone.
                            Rectangle {
                                x: 17px;
                                y: 5px;
                                width: 7px;
                                height: 7px;
                                border-radius: 3.5px;
                                border-width: 1.5px;
                                border-color: #0a0c0f;
                                background: root.subscription-announcement-tone == "danger" ? Theme.error
                                    : root.subscription-announcement-tone == "success" ? Theme.accent-green
                                    : Theme.accent-blue;
                            }
                        }
                        bell-touch := TouchArea {
                            clicked => { announcement-bell.toggle(); }
                        }
                    }
                }

                TitleBarButton { x: parent.width - 132px; kind: "minimize"; state-label: "Свернуть окно"; activated => { if (root.profile-menu-open) { root.close-profile-menu(); } root.window-minimize(); } }
                TitleBarButton { x: parent.width - 88px; kind: root.maximized ? "restore" : "maximize"; state-label: "Развернуть или восстановить окно"; activated => { if (root.profile-menu-open) { root.close-profile-menu(); } root.window-toggle-maximize(); } }
                TitleBarButton { x: parent.width - 44px; kind: "close"; state-label: "Закрыть MultiCore"; activated => { if (root.profile-menu-open) { root.close-profile-menu(); } root.window-close(); } }
            }

            HorizontalLayout {
                spacing: 0px;

        navigation-rail := Rectangle {
            width: root.navigation-collapsed ? 64px : 176px;
            background: #0a0c0f;
            border-color: Theme.line;
            border-width: 0px;
            animate width { duration: 180ms; easing: ease-in-out; }

            VerticalLayout {
                padding: 10px;
                spacing: root.navigation-collapsed ? 8px : 4px;

                NavItem { compact: root.navigation-collapsed; icon-source: @image-url("../assets/home.svg"); label: "Главная"; active: root.visible-page == "home"; enabled: !root.profile-menu-open; activated => { root.local-page = "home"; root.close-panel(); } }
                NavItem { compact: root.navigation-collapsed; icon-source: @image-url("../assets/status.svg"); label: "Состояние"; active: root.visible-page == "status"; enabled: !root.profile-menu-open; activated => { root.local-page = "status"; root.open-panel("events"); } }
                NavItem { compact: root.navigation-collapsed; icon-source: @image-url("../assets/link.svg"); label: "Подписки"; badge: root.subscription-profiles.length > 1 ? "" + root.subscription-profiles.length : ""; active: root.visible-page == "subscriptions"; enabled: !root.profile-menu-open; activated => { root.local-page = "subscriptions"; root.close-panel(); } }
                NavItem { compact: root.navigation-collapsed; icon-source: @image-url("../assets/settings.svg"); label: "Настройки"; active: root.visible-page == "settings"; enabled: !root.profile-menu-open; activated => { root.local-page = "settings"; root.close-panel(); } }

                Rectangle { vertical-stretch: 1; background: transparent; }

                Rectangle {
                    height: 1px;
                    background: Theme.line;
                    opacity: root.navigation-collapsed ? 0 : 1;
                    animate opacity { duration: 160ms; easing: ease-out; }
                }

                NavToggle {
                    collapsed: root.navigation-collapsed;
                    activated => { root.navigation-collapsed = !root.navigation-collapsed; }
                }
            }
        }

        main-pane := Rectangle {
            background: Theme.canvas;

            if root.visible-page == "home": Rectangle {
                opacity: root.page-entering ? 0 : 1;
                y: root.page-entering ? 6px : 0px;
                animate opacity { duration: 180ms; easing: ease-out; }
                animate y { duration: 220ms; easing: ease-out; }
                background: transparent;
                clip: true;

                ambient-touch := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    enabled: root.ambient-background-enabled;
                }

                ambient-pointer-glow := Rectangle {
                    width: parent.width;
                    height: parent.height;
                    visible: root.ambient-background-enabled;
                    opacity: ambient-touch.has-hover ? 1 : 0;
                    background: @radial-gradient(
                        circle 360px at ambient-touch.mouse-x ambient-touch.mouse-y,
                        #d7dde50b 0%,
                        #b7c2cf06 38%,
                        #00000000 76%
                    );
                    animate opacity { duration: 220ms; easing: ease-out; }
                }

                ambient-wave-a := Path {
                    visible: root.ambient-background-enabled;
                    x: root.ambient-wave-phase ? -12px : -48px;
                    y: root.ambient-wave-phase ? 48px : 76px;
                    width: parent.width + 76px;
                    // Keep the closing edge of the filled path below the clipped home plane.
                    // Otherwise it reads as a horizontal divider when it crosses content.
                    height: parent.height + 80px;
                    viewbox-width: 1000;
                    viewbox-height: 800;
                    commands: "M 0 124 C 160 40 340 36 500 112 C 668 192 824 184 1000 82 L 1000 800 L 0 800 Z";
                    fill: #c8cdd5;
                    opacity: 0.026;
                    animate x { duration: 12000ms; easing: ease-in-out; }
                    animate y { duration: 12000ms; easing: ease-in-out; }
                }

                ambient-wave-b := Path {
                    visible: root.ambient-background-enabled;
                    x: root.ambient-wave-phase ? -58px : -22px;
                    y: root.ambient-wave-phase ? 288px : 254px;
                    width: parent.width + 76px;
                    height: parent.height + 80px;
                    viewbox-width: 1000;
                    viewbox-height: 800;
                    commands: "M 0 74 C 190 174 350 184 510 92 C 670 0 824 34 1000 142 L 1000 800 L 0 800 Z";
                    fill: #aeb5bf;
                    opacity: 0.018;
                    animate x { duration: 12000ms; easing: ease-in-out; }
                    animate y { duration: 12000ms; easing: ease-in-out; }
                }

                ambient-wave-fade := Rectangle {
                    x: 0px;
                    y: 180px;
                    width: parent.width;
                    height: parent.height - self.y;
                    visible: root.ambient-background-enabled;
                    background: @linear-gradient(180deg, #0d0f1200 0%, Theme.canvas 88%);
                }

                VerticalLayout {
                    padding: 20px;
                    spacing: 16px;

                    if root.has-profile: connection-strip := Rectangle {
                        height: root.has-profile
                            ? 88px
                            : root.first-run-manual-open
                                ? (root.import-error == "" ? 174px : 200px)
                                : (root.import-error == "" ? 124px : 150px);
                        background: root.has-profile ? Theme.surface : #101721;
                        border-color: !root.has-profile ? #4c9dff55
                            : root.status-tone == "success" ? #3ccb7f59
                            : root.status-tone == "danger" ? #f06a6a59
                            : root.status-tone == "warning" && !root.toggle-busy ? #e7aa4559
                            : #ffffff0a;
                        border-width: 1px;
                        border-radius: 14px;
                        clip: true;
                        animate border-color { duration: 180ms; easing: ease-in-out; }

                        // Only the cell mesh reacts to hover. An outer halo would be clipped by
                        // the main-content plane and read as a rectangular light patch.
                        if root.has-profile: mesh-clip := Rectangle {
                            border-radius: 14px;
                            clip: true;
                            background: transparent;

                            signal-mesh-field := Rectangle {
                                property <bool> active: strip-glow-touch.has-hover;
                                property <length> cursor-x: strip-glow-touch.mouse-x;
                                property <length> cursor-y: strip-glow-touch.mouse-y;
                                property <color> glow-strong: root.status-tone == "success" ? #22c55e3d : root.status-tone == "danger" ? #f06a6a3d : #0091ff47;
                                property <color> glow-medium: root.status-tone == "success" ? #22c55e24 : root.status-tone == "danger" ? #f06a6a24 : #0091ff29;
                                property <color> glow-soft: root.status-tone == "success" ? #22c55e0f : root.status-tone == "danger" ? #f06a6a0f : #0091ff0f;
                                property <color> grid-line-strong: root.status-tone == "success" ? #8ea39770 : root.status-tone == "danger" ? #a3939370 : #8f9eae70;
                                x: 0;
                                y: 0;
                                width: parent.width;
                                opacity: self.active ? 1 : 0;
                                background: @radial-gradient(
                                    circle 160px at cursor-x cursor-y,
                                    glow-strong 0%,
                                    glow-medium 26%,
                                    glow-soft 52%,
                                    #00000000 76%
                                );
                                animate opacity { duration: 160ms; easing: ease-out; }

                                for _[grid-x] in 120: Rectangle {
                                    x: grid-x * 8px;
                                    y: 0;
                                    width: 8px;
                                    height: parent.height;
                                    background: transparent;

                                    for _[grid-cell-y] in 11: Rectangle {
                                        property <float> normalized-x: (grid-x * 8px + 4px - signal-mesh-field.cursor-x) / 176px;
                                        property <float> normalized-y: (grid-cell-y * 8px + 4px - signal-mesh-field.cursor-y) / 72px;
                                        property <float> distance: Math.sqrt(
                                            self.normalized-x * self.normalized-x
                                            + self.normalized-y * self.normalized-y
                                        );
                                        x: 0;
                                        y: grid-cell-y * 8px;
                                        width: 8px;
                                        height: 8px;
                                        background: transparent;
                                        border-width: 0.5px;
                                        border-color: signal-mesh-field.grid-line-strong;
                                        opacity: signal-mesh-field.active ? Math.max(0, 1 - self.distance) : 0;
                                    }
                                }
                            }
                        }

                        if root.has-profile: toggle-module := Rectangle {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: parent.height;
                            background: strip-glow-touch.has-hover ? #ffffff04 : transparent;

                            shield-badge := Rectangle {
                                x: 20px;
                                y: (parent.height - self.height) / 2;
                                width: 44px;
                                height: 44px;
                                border-radius: 12px;
                                background: root.status-tone == "success" ? #3ccb7f24
                                    : root.status-tone == "danger" ? #f06a6a24
                                    : root.status-tone == "warning" && !root.toggle-busy ? #e7aa4524
                                    : Theme.elevated;
                                animate background { duration: 180ms; easing: ease-in-out; }

                                // Soft ring that breathes only while connecting/disconnecting.
                                if root.toggle-busy && !root.reduced-motion: Rectangle {
                                    property <float> phase: (1 + Math.sin(animation-tick() / 1400ms * 360deg)) / 2;
                                    x: -3px;
                                    y: -3px;
                                    width: parent.width + 6px;
                                    height: parent.height + 6px;
                                    border-radius: 15px;
                                    border-width: 1.5px;
                                    border-color: Theme.accent-blue;
                                    background: transparent;
                                    opacity: 0.15 + 0.45 * self.phase;
                                }

                                shield-glyph := Image {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    width: 22px;
                                    height: 22px;
                                    source: root.status-tone == "success" ? @image-url("../assets/shield-check.svg")
                                        : root.status-tone == "danger" || (root.status-tone == "warning" && !root.toggle-busy) ? @image-url("../assets/shield-alert.svg")
                                        : @image-url("../assets/shield-off.svg");
                                    colorize: root.status-tone == "success" ? Theme.accent-green
                                        : root.status-tone == "danger" ? Theme.error
                                        : root.toggle-busy ? Theme.accent-blue
                                        : root.status-tone == "warning" ? Theme.warning
                                        : Theme.text-muted;
                                    image-fit: contain;
                                    accessible-role: none;
                                }
                            }

                            VerticalLayout {
                                x: 78px;
                                width: parent.width - 78px - 112px;
                                height: parent.height;
                                alignment: center;
                                spacing: 5px;
                                // Title and session timer share one bottom edge, so the smaller
                                // timer sits on the title's baseline instead of floating mid-line.
                                HorizontalLayout {
                                    height: 20px;
                                    spacing: 8px;
                                    alignment: start;
                                    Text {
                                        text: root.toggle-title;
                                        color: Theme.text-primary;
                                        font-size: Theme.type-value-size;
                                        font-weight: Theme.weight-semibold;
                                        vertical-alignment: bottom;
                                        overflow: elide;
                                    }
                                    if root.session-uptime != "": Text {
                                        text: root.session-uptime;
                                        color: Theme.text-secondary;
                                        font-size: 13px;
                                        font-weight: Theme.weight-regular;
                                        vertical-alignment: bottom;
                                        accessible-label: "Время сессии " + root.session-uptime;
                                    }
                                }
                                if root.toggle-detail-is-exit: HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;
                                    Text { text: "Выход"; color: Theme.text-muted; font-size: Theme.type-metadata-size; vertical-alignment: center; }
                                    // A leading emoji is drawn as an embedded image (colour in
                                    // every renderer); other symbols use the emoji font, as the
                                    // UI font renders regional-indicator flags as letters ("SE").
                                    if root.node-icon-image.width > 0: Image { width: 14px; height: 14px; y: 1px; source: root.node-icon-image; image-fit: contain; accessible-role: none; }
                                    if root.node-icon != "" && root.node-icon-image.width == 0: Text { text: root.node-icon; color: Theme.text-secondary; font-family: Theme.emoji-font-family; font-size: Theme.type-metadata-size; accessible-role: none; }
                                    Text { horizontal-stretch: 0; max-width: 220px; text: root.node-name; color: Theme.text-secondary; font-size: Theme.type-metadata-size; overflow: elide; vertical-alignment: center; }
                                    if root.node-latency != "": Text { text: "· " + root.node-latency; color: Theme.text-muted; font-size: Theme.type-metadata-size; vertical-alignment: center; }
                                    // Live speed follows the exit inline; each arrow only shows with a value.
                                    if root.traffic-down != "": Text { text: "·  ↓"; color: Theme.accent-blue; font-size: Theme.type-metadata-size; vertical-alignment: center; accessible-role: none; }
                                    if root.traffic-down != "": Text { min-width: 56px; text: root.traffic-down; color: Theme.text-muted; font-size: Theme.type-metadata-size; vertical-alignment: center; accessible-label: "Загрузка " + root.traffic-down; }
                                    if root.traffic-up != "": Text { text: "↑"; color: Theme.accent-green; font-size: Theme.type-metadata-size; vertical-alignment: center; accessible-role: none; }
                                    if root.traffic-up != "": Text { text: root.traffic-up; color: Theme.text-muted; font-size: Theme.type-metadata-size; vertical-alignment: center; accessible-label: "Отдача " + root.traffic-up; }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                }
                                if !root.toggle-detail-is-exit: Text {
                                    text: root.supporting;
                                    color: Theme.text-secondary;
                                    font-size: Theme.type-metadata-size;
                                    overflow: elide;
                                }
                            }

                            power-action := FocusScope {
                                property <int> focus-epoch: root.power-action-focus-serial;
                                x: parent.width - self.width - 20px;
                                y: (parent.height - self.height) / 2;
                                width: 72px;
                                height: 40px;
                                enabled: root.primary-enabled && !root.profile-menu-open;
                                focus-on-click: true;
                                focus-on-tab-navigation: true;
                                accessible-role: button;
                                accessible-label: root.primary-label;
                                accessible-enabled: self.enabled;
                                changed focus-epoch => {
                                    if (self.focus-epoch > 0 && root.has-profile && root.visible-page == "home" && self.enabled) {
                                        self.focus();
                                    }
                                }
                                accessible-action-default => {
                                    if (root.primary-enabled) {
                                        root.primary-action();
                                    }
                                }
                                key-pressed(event) => {
                                    if ((event.text == " " || event.text == "\n") && root.primary-enabled) {
                                        root.primary-action();
                                        return accept;
                                    }
                                    return reject;
                                }

                                // The switch track; its knob slides between off (left) and on (right).
                                power-button := Rectangle {
                                    width: parent.width;
                                    height: parent.height;
                                    border-radius: self.height / 2;
                                    background: root.toggle-busy ? #4c9dff59
                                        : root.toggle-on ? Theme.accent-green
                                        : root.status-tone == "warning" ? #e7aa4566
                                        : Theme.line;
                                    border-color: Theme.focus;
                                    border-width: power-action.has-focus ? Theme.focus-width : 0px;
                                    opacity: root.primary-enabled || root.toggle-busy ? 1 : 0.45;
                                    animate background { duration: 180ms; easing: ease-in-out; }

                                    toggle-knob := Rectangle {
                                        x: root.toggle-on ? parent.width - self.width - 4px : 4px;
                                        y: (parent.height - self.height) / 2;
                                        width: strip-glow-touch.pressed ? 36px : 32px;
                                        height: 32px;
                                        border-radius: 16px;
                                        background: #ffffff;
                                        drop-shadow-blur: 6px;
                                        drop-shadow-offset-y: 2px;
                                        drop-shadow-color: #00000059;
                                        animate x, width { duration: 180ms; easing: ease-in-out; }
                                    }
                                }
                            }
                        }

                        // This is the pill's only pointer surface. It sits above every visual
                        // child, so crossing the power icon never hands hover to another area.
                        strip-glow-touch := TouchArea {
                            x: 0;
                            y: 0;
                            width: root.has-profile ? parent.width : 0px;
                            height: root.has-profile ? parent.height : 0px;
                            enabled: !root.profile-menu-open;
                            clicked => {
                                if (root.primary-enabled) {
                                    root.primary-action();
                                }
                            }
                        }

                    }

                    if root.update-banner-visible: update-banner := Rectangle {
                        height: 72px;
                        background: #101721;
                        border-color: #4c9dff55;
                        border-width: 1px;
                        border-radius: 14px;
                        clip: true;
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            padding-top: 14px;
                            padding-bottom: 14px;
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 32px;
                                    height: 32px;
                                    border-radius: 8px;
                                    background: #4c9dff18;
                                    Image { x: 7px; y: 7px; width: 18px; height: 18px; source: @image-url("../assets/refresh.svg"); image-fit: contain; accessible-role: none; }
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 2px;
                                Text { text: "Доступно обновление"; color: Theme.text-primary; font-size: Theme.type-label-size; font-weight: Theme.weight-semibold; }
                                Text { text: root.update-status; color: Theme.text-secondary; font-size: Theme.type-metadata-size; overflow: elide; }
                            }
                            SmallAction {
                                min-width: 96px;
                                label: root.update-action-label != "" ? root.update-action-label : "Подробнее";
                                selected: true;
                                enabled: !root.update-busy && !root.profile-menu-open && !root.update-confirm-open
                                    && (root.update-action-label == "" || !root.update-runtime-busy);
                                activated => {
                                    if (root.update-action-label != "") { root.update-action(); }
                                    else { root.local-page = "settings"; root.settings-section = "updates"; }
                                }
                            }
                            SmallAction {
                                label: "Позже";
                                enabled: !root.profile-menu-open;
                                activated => { root.update-banner-dismissed-for = root.update-status; }
                            }
                        }
                    }

                    if root.conflicting-apps-banner-visible: conflicting-apps-banner := Rectangle {
                        // Generous enough for a realistic worst case (two
                        // conflicting apps plus the appended "couldn't fully
                        // close it, it's a Windows service" note) at the
                        // app's own minimum window width.
                        height: 160px;
                        background: #1a1215;
                        border-color: #f06a6a55;
                        border-width: 1px;
                        border-radius: 14px;
                        clip: true;
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            padding-top: 14px;
                            padding-bottom: 14px;
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 32px;
                                    height: 32px;
                                    border-radius: 8px;
                                    background: #f06a6a18;
                                    Image { x: 7px; y: 7px; width: 18px; height: 18px; source: @image-url("../assets/announcement-danger.svg"); image-fit: contain; accessible-role: none; }
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                preferred-width: 0px;
                                alignment: center;
                                spacing: 2px;
                                Text { text: "Конфликт с другим VPN-приложением"; color: Theme.text-primary; font-size: Theme.type-label-size; font-weight: Theme.weight-semibold; overflow: elide; }
                                Text { text: root.conflicting-apps-message; color: Theme.text-secondary; font-size: Theme.type-metadata-size; wrap: word-wrap; overflow: elide; }
                            }
                            // Centered vertically like the icon and text: the banner is
                            // taller than the buttons, which otherwise sit at the top.
                            VerticalLayout {
                                alignment: center;
                                HorizontalLayout {
                                    spacing: 12px;
                                    SmallAction {
                                        min-width: 96px;
                                        label: root.conflicting-apps-closing ? "Закрываем…" : "Закрыть";
                                        selected: true;
                                        enabled: !root.profile-menu-open && !root.conflicting-apps-closing;
                                        activated => { root.close-conflicting-apps(); }
                                    }
                                    SmallAction {
                                        label: "Понятно";
                                        enabled: !root.profile-menu-open;
                                        activated => { root.dismiss-conflicting-apps-banner(); }
                                    }
                                }
                            }
                        }
                    }

                    // First run: logo, one grouped card of actions (paste, or type a link
                    // inline), a footnote and the three steps.
                    if !root.has-profile: first-run-stage := VerticalLayout {
                        vertical-stretch: 1;
                        alignment: center;
                        spacing: 0px;

                        HorizontalLayout {
                            alignment: center;
                            first-run-onboarding := VerticalLayout {
                                width: Math.min(420px, root.width - 200px);
                                spacing: 0px;

                                HorizontalLayout {
                                    alignment: center;
                                    Image {
                                        width: 44px;
                                        height: 44px;
                                        source: @image-url("../assets/app-icon.svg");
                                        opacity: 0.85;
                                        image-fit: contain;
                                        accessible-role: none;
                                    }
                                }
                                Rectangle { height: 22px; background: transparent; }

                                onboarding-copy := VerticalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: "Добавьте подписку";
                                        color: Theme.text-primary;
                                        font-size: 20px;
                                        font-weight: Theme.weight-semibold;
                                        horizontal-alignment: center;
                                        overflow: elide;
                                        accessible-role: text;
                                    }
                                    Text {
                                        text: "Скопируйте ссылку у провайдера — мы подхватим её из буфера обмена";
                                        color: Theme.text-secondary;
                                        font-size: Theme.type-label-size;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                        accessible-role: text;
                                    }
                                }
                                Rectangle { height: 28px; background: transparent; }

                                first-run-card := Rectangle {
                                    height: first-run-actions.preferred-height;
                                    background: Theme.surface;
                                    border-color: #ffffff0a;
                                    border-width: 1px;
                                    border-radius: 14px;
                                    clip: true;
                                    animate height { duration: Motion.reduced ? 0ms : 240ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }

                                    first-run-actions := VerticalLayout {
                                        alignment: start;
                                        spacing: 0px;
                                        ActionRow {
                                            label: root.import-pending ? "Добавляем…" : "Вставить из буфера";
                                            state-label: "Вставить подписку из буфера обмена";
                                            icon: @image-url("../assets/clipboard.svg");
                                            accent: true;
                                            show-separator: true;
                                            enabled: !root.import-pending;
                                            activated => { root.paste-subscription(); }
                                        }
                                        ActionRow {
                                            label: "Ввести ссылку вручную";
                                            icon: @image-url("../assets/plus.svg");
                                            chevron: true;
                                            expanded: root.first-run-manual-open;
                                            show-separator: root.first-run-manual-open;
                                            enabled: !root.import-pending;
                                            focus-epoch: root.first-run-trigger-focus-serial;
                                            activated => {
                                                root.first-run-manual-open = true;
                                                root.first-run-input-focus-serial += 1;
                                            }
                                        }
                                        if root.first-run-manual-open: HorizontalLayout {
                                            height: 56px;
                                            opacity: Math.max(0, Math.min(1, (first-run-card.height - 104px) / 56px));
                                            padding-left: 16px;
                                            padding-right: 12px;
                                            spacing: 8px;
                                            VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            first-run-url-input := UrlField {
                                                property <int> focus-serial: root.first-run-input-focus-serial;
                                                text <=> root.subscription-draft;
                                                placeholder: "https://…";
                                                enabled: !root.import-pending;
                                                accessible-name: "URL подписки";
                                                init => { self.focus(); }
                                                changed focus-serial => { self.focus(); }
                                                accepted => {
                                                    if (!root.import-pending && root.subscription-draft != "") {
                                                        root.import-url(root.subscription-draft);
                                                    }
                                                }
                                            }
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                TextAction {
                                                    label: "Отмена";
                                                    tone: "neutral";
                                                    enabled: !root.import-pending;
                                                    activated => {
                                                        root.first-run-manual-open = false;
                                                        root.subscription-draft = "";
                                                        root.dismiss-first-run-import();
                                                        root.first-run-trigger-focus-serial += 1;
                                                    }
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                TextAction {
                                                    label: root.import-pending ? "Добавляем…" : "Добавить";
                                                    enabled: !root.import-pending && root.subscription-draft != "";
                                                    activated => { root.import-url(root.subscription-draft); }
                                                }
                                            }
                                        }
                                    }
                                }

                                Rectangle { height: 12px; background: transparent; }
                                if root.import-error != "": Text {
                                    text: root.import-error;
                                    color: Theme.error;
                                    font-size: Theme.type-metadata-size;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                    accessible-role: text;
                                    accessible-live-region: polite;
                                }
                                if root.import-error == "": Text {
                                    text: "Ссылка хранится только на этом устройстве";
                                    color: Theme.text-muted;
                                    font-size: Theme.type-metadata-size;
                                    horizontal-alignment: center;
                                    accessible-role: text;
                                }
                                Rectangle { height: 40px; background: transparent; }

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 12px;
                                    for step[i] in ["1 СКОПИРУЙТЕ ССЫЛКУ", "2 ВСТАВЬТЕ", "3 ВКЛЮЧИТЕ ЗАЩИТУ"]: HorizontalLayout {
                                        spacing: 12px;
                                        if i > 0: Text { text: "·"; color: Theme.text-muted; opacity: 0.5; font-size: 11px; }
                                        SectionCaption { text: step; font-weight: Theme.weight-medium; }
                                    }
                                }
                            }
                        }
                    }

                    if root.has-profile: inline-routes := Rectangle {
                        vertical-stretch: 1;
                        min-height: 140px;
                        background: transparent;
                        VerticalLayout {
                            spacing: 8px;
                            routes-heading := HorizontalLayout {
                                height: 28px;
                                spacing: 8px;
                                routes-title := Text {
                                    height: 28px;
                                    horizontal-stretch: 0;
                                    text: "Маршруты";
                                    color: Theme.text-primary;
                                    font-size: Theme.type-label-size;
                                    font-weight: Theme.weight-semibold;
                                    vertical-alignment: center;
                                }
                                route-updated-meta := Text {
                                    height: 28px;
                                    horizontal-stretch: 1;
                                    text: root.latency-check-loading ? "· Замеряем задержку…" : root.subscription-updated == "Не обновлялась" ? "· " + root.subscription-updated : "· Обновлено " + root.subscription-updated;
                                    color: !root.latency-check-loading && root.subscription-updated-stale ? Theme.warning : Theme.text-muted;
                                    font-size: Theme.type-metadata-size;
                                    horizontal-alignment: left;
                                    accessible-role: text;
                                    accessible-live-region: polite;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                            // Segmented control: one dark track, the selected group is a raised pill.
                            route-group-track := Rectangle {
                                height: 38px;
                                background: #0a0c0f;
                                border-color: Theme.line;
                                border-width: 1px;
                                border-radius: 10px;
                                clip: true;
                                ScrollView {
                                HorizontalLayout {
                                    padding: 2px;
                                    spacing: 2px;
                                    for group in root.catalog-groups: QuietChip {
                                        height: 32px;
                                        icon: group.icon;
                                        icon-image: group.icon-image;
                                        label: group.label;
                                        selected: group.selected;
                                        enabled: root.catalog-group-navigation-enabled;
                                        modal-enabled: !root.profile-menu-open;
                                        activated => { root.select-catalog-group(group.id); }
                                    }
                                }
                                }
                            }
                            if root.catalog-error != "" || root.latency-check-error != "": Text { min-height: 28px; text: root.catalog-error != "" ? root.catalog-error : root.latency-check-error; color: Theme.error; font-size: Theme.type-metadata-size; wrap: word-wrap; }
                            ScrollView {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    // Full width: the card lines up with the connect module and
                                    // its latency column with the switch's right edge.
                                    alignment: start;
                                    // iOS-style inset grouped list: one card, hairlines between rows.
                                    route-list-card := Rectangle {
                                    height: route-list.preferred-height;
                                    background: Theme.surface;
                                    border-color: #ffffff0a;
                                    border-width: 1px;
                                    border-radius: 14px;
                                    clip: true;
                                    route-list := VerticalLayout {
                                    spacing: 0px;
                                    for node[index] in root.catalog-nodes: RouteNodeRow {
                                        height: 48px;
                                        show-separator: index < root.catalog-nodes.length - 1;
                                        icon: node.icon;
                                        icon-image: node.icon-image;
                                        label: node.label;
                                        supporting-text: "";
                                        trailing-text: node.latency-text;
                                        trailing-measuring: root.latency-check-loading;
                                        trailing-tone: node.latency-tone;
                                        selected: node.selected;
                                        pending: root.catalog-selection-pending && node.selected;
                                        enabled: root.catalog-selection-enabled && !root.profile-menu-open;
                                        activated => { root.select-catalog-node(node.id); }
                                    }
                                    if root.catalog-nodes.length == 0: Text { height: 52px; text: root.catalog-loading ? "Загружаем маршруты…" : "В этой группе нет доступных серверов"; color: Theme.text-muted; font-size: Theme.type-metadata-size; vertical-alignment: center; horizontal-alignment: center; }
                                    }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            if root.visible-page == "status": Rectangle {
                opacity: root.page-entering ? 0 : 1;
                y: root.page-entering ? 6px : 0px;
                animate opacity { duration: 180ms; easing: ease-out; }
                animate y { duration: 220ms; easing: ease-out; }
                background: transparent;
                VerticalLayout {
                    padding-left: 28px;
                    padding-right: 28px;
                    padding-top: 22px;
                    padding-bottom: 24px;
                    spacing: 0px;
                    HorizontalLayout {
                        height: 36px;
                        spacing: 4px;
                        Text { text: "Состояние"; color: Theme.text-primary; font-size: 20px; font-weight: Theme.weight-semibold; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        VerticalLayout {
                            alignment: center;
                            TextAction {
                                label: "Открыть дашборд";
                                enabled: root.dashboard-available && !root.profile-menu-open;
                                disabled-hint: "Подключитесь, чтобы открыть панель Mihomo.";
                                activated => { root.open-dashboard(); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            TextAction {
                                label: "Копировать лог";
                                swap-label: "Скопировано ✓";
                                swapped: root.diagnostics-copied;
                                enabled: !root.profile-menu-open;
                                activated => { root.copy-diagnostics(); }
                            }
                        }
                    }
                    Rectangle { height: 14px; background: transparent; }

                    HorizontalLayout {
                        height: 22px;
                        padding-left: 4px;
                        SectionCaption { text: "ЯДРА"; }
                        if root.diagnostics-loading: Text { text: "Обновляем…"; color: Theme.text-muted; font-size: 11px; horizontal-alignment: right; vertical-alignment: center; }
                    }
                    cores-card := Rectangle {
                        opacity: root.page-entering ? 0 : 1;
                        animate opacity { duration: 280ms; delay: 24ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
                        height: 132px;
                        background: Theme.surface;
                        border-color: #ffffff0a;
                        border-width: 1px;
                        border-radius: 14px;
                        clip: true;
                        VerticalLayout {
                            spacing: 0px;
                            HealthRow { label: "Транспорт Xray"; value: root.diagnostics-xray-value; tone: root.diagnostics-xray-tone; show-separator: true; }
                            HealthRow { label: "Политики Mihomo"; value: root.diagnostics-mihomo-value; tone: root.diagnostics-mihomo-tone; show-separator: true; }
                            HealthRow { label: "Туннель TUN"; value: root.diagnostics-tun-value; tone: root.diagnostics-tun-tone; }
                        }
                    }
                    Rectangle { height: 18px; background: transparent; }

                    HorizontalLayout { height: 22px; padding-left: 4px; SectionCaption { text: "МАППИНГ"; } }
                    mapping-card := Rectangle {
                        opacity: root.page-entering ? 0 : 1;
                        animate opacity { duration: 280ms; delay: 48ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
                        // Up to three rows show at once; more scroll inside the card.
                        height: root.diagnostic-mappings.length == 0 ? 44px : Math.min(3, root.diagnostic-mappings.length) * 44px;
                        background: Theme.surface;
                        border-color: #ffffff0a;
                        border-width: 1px;
                        border-radius: 14px;
                        clip: true;
                        ScrollView {
                            VerticalLayout {
                                spacing: 0px;
                                for mapping[index] in root.diagnostic-mappings: Rectangle {
                                    height: 44px;
                                    background: mapping-touch.has-hover ? #ffffff06 : transparent;
                                    mapping-touch := TouchArea { }
                                    HorizontalLayout {
                                        padding-left: 16px;
                                        padding-right: 16px;
                                        spacing: 12px;
                                        if mapping.icon-image.width > 0: VerticalLayout {
                                            alignment: center;
                                            Image { width: 18px; height: 18px; source: mapping.icon-image; image-fit: contain; accessible-role: none; }
                                        }
                                        Text { text: mapping.proxy-name; color: Theme.text-primary; font-size: Theme.type-label-size; vertical-alignment: center; overflow: elide; }
                                        Text { width: 128px; text: mapping.address; color: Theme.text-muted; font-size: Theme.type-metadata-size; horizontal-alignment: right; vertical-alignment: center; }
                                        Text { width: 132px; text: mapping.xray-label; color: Theme.text-secondary; font-size: Theme.type-metadata-size; horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
                                    }
                                    if index < root.diagnostic-mappings.length - 1: Rectangle { x: 46px; y: parent.height - 1px; width: parent.width - 46px; height: 1px; background: #ffffff0f; }
                                }
                                if root.diagnostic-mappings.length == 0: Text { height: 44px; text: "Маппинги появятся после загрузки подписки"; color: Theme.text-muted; font-size: Theme.type-metadata-size; vertical-alignment: center; horizontal-alignment: center; }
                            }
                        }
                    }
                    HorizontalLayout { padding-left: 4px; padding-top: 6px; Footnote { text: "Локальные прокси-адреса для сторонних приложений"; } }
                    Rectangle { height: 14px; background: transparent; }

                    HorizontalLayout { height: 22px; padding-left: 4px; SectionCaption { text: "ЖУРНАЛ"; } }
                    event-filter-track := Rectangle {
                        height: 38px;
                        background: #0a0c0f;
                        border-color: Theme.line;
                        border-width: 1px;
                        border-radius: 10px;
                        HorizontalLayout {
                            padding: 2px;
                            spacing: 2px;
                            QuietChip { min-width: 0px; label: "Все"; selected: root.event-filter == "Все"; modal-enabled: !root.profile-menu-open; activated => { root.filter-events("Все"); } }
                            QuietChip { min-width: 0px; label: "Система"; selected: root.event-filter == "Система"; modal-enabled: !root.profile-menu-open; activated => { root.filter-events("Система"); } }
                            QuietChip { min-width: 0px; label: "Ошибки"; selected: root.event-filter == "Ошибки"; modal-enabled: !root.profile-menu-open; activated => { root.filter-events("Ошибки"); } }
                            QuietChip { min-width: 0px; label: "Ядра"; selected: root.event-filter == "Ядра"; modal-enabled: !root.profile-menu-open; activated => { root.filter-events("Ядра"); } }
                        }
                    }
                    Rectangle { height: 10px; background: transparent; }
                    // One grouped card of log rows: time, a severity dot and the message.
                    event-log-card := Rectangle {
                        opacity: root.page-entering ? 0 : 1;
                        animate opacity { duration: 280ms; delay: 72ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
                        vertical-stretch: 1;
                        min-height: 88px;
                        background: Theme.surface;
                        border-color: #ffffff0a;
                        border-width: 1px;
                        border-radius: 14px;
                        clip: true;
                        ScrollView {
                            VerticalLayout {
                                alignment: start;
                                spacing: 0px;
                                for event[index] in root.events: Rectangle {
                                    height: Math.max(40px, event-row.preferred-height);
                                    background: event-touch.has-hover ? #ffffff05 : transparent;
                                    event-touch := TouchArea { }
                                    event-row := HorizontalLayout {
                                        padding-left: 16px;
                                        padding-right: 16px;
                                        padding-top: 11px;
                                        padding-bottom: 11px;
                                        spacing: 12px;
                                        alignment: start;
                                        Text { width: 58px; text: event.timestamp; color: event.level == "error" ? Theme.error : Theme.text-muted; font-size: Theme.type-metadata-size; }
                                        VerticalLayout {
                                            width: 6px;
                                            padding-top: 6px;
                                            alignment: start;
                                            Rectangle {
                                                width: 6px;
                                                height: 6px;
                                                border-radius: 3px;
                                                background: event.level == "error" ? Theme.error : event.level == "warning" ? Theme.warning : Theme.accent-green;
                                            }
                                        }
                                        Text {
                                            horizontal-stretch: 1;
                                            text: event.message;
                                            color: event.level == "error" ? #f3c5c5 : Theme.text-secondary;
                                            font-size: Theme.type-metadata-size;
                                            wrap: word-wrap;
                                            accessible-label: (event.level == "error" ? "Ошибка" : "Событие") + (event.component == "" ? "" : ", " + event.component) + (event.timestamp == "" ? "" : ", " + event.timestamp) + ": " + event.message;
                                        }
                                    }
                                    if index < root.events.length - 1: Rectangle { x: 86px; y: parent.height - 1px; width: parent.width - 86px; height: 1px; background: #ffffff0f; }
                                }
                                if root.events.length == 0: Text { height: 64px; text: "Событий пока нет"; color: Theme.text-muted; font-size: Theme.type-metadata-size; vertical-alignment: center; horizontal-alignment: center; }
                            }
                        }
                    }
                }
            }

            if root.visible-page == "settings": Rectangle {
                opacity: root.page-entering ? 0 : 1;
                y: root.page-entering ? 6px : 0px;
                animate opacity { duration: 180ms; easing: ease-out; }
                animate y { duration: 220ms; easing: ease-out; }
                background: transparent;
                settings-scroll := ScrollView {
                    vertical-stretch: 1;
                    // Arriving from the update banner lands on the updates section.
                    init => {
                        if (root.settings-section == "updates") {
                            self.viewport-y = Math.min(0px, self.visible-height - settings-content.preferred-height);
                        }
                    }
                    settings-content := VerticalLayout {
                        width: settings-scroll.visible-width;
                        min-height: settings-scroll.visible-height;
                        padding-left: 28px;
                        padding-right: 28px;
                        padding-top: 22px;
                        padding-bottom: 24px;
                        spacing: 0px;
                        Text { height: 36px; text: "Настройки"; color: Theme.text-primary; font-size: 20px; font-weight: Theme.weight-semibold; vertical-alignment: center; }
                        Rectangle { height: 14px; background: transparent; }

                        HorizontalLayout { height: 22px; padding-left: 4px; SectionCaption { text: "ПОДКЛЮЧЕНИЕ"; } }
                        connection-card := Rectangle {
                        opacity: root.page-entering ? 0 : 1;
                        animate opacity { duration: 280ms; delay: 24ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
                            height: connection-rows.preferred-height;
                            background: Theme.surface;
                            border-color: #ffffff0a;
                            border-width: 1px;
                            border-radius: 14px;
                            clip: true;
                            connection-rows := VerticalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                spacing: 0px;
                                if root.tun-toggle-available: ToggleRow {
                                    label: "Режим TUN — весь трафик";
                                    description: root.toggle-on || root.toggle-busy
                                        ? "Применится при следующем подключении"
                                        : root.tun-enabled
                                            ? "Все приложения идут через VPN"
                                            : "Только программы с системным прокси · без прав администратора";
                                    checked: root.tun-enabled;
                                    show-separator: true;
                                    // The mode is chosen at connect time, so it is locked while connected.
                                    enabled: !root.toggle-on && !root.toggle-busy && !root.profile-menu-open;
                                    toggled(value) => { root.tun-enabled = value; }
                                }
                                ToggleRow {
                                    label: "Подключаться после входа в систему";
                                    description: root.launch-at-sign-in-enabled ? "Когда появится сеть и профиль будет готов" : "Сначала включите автозапуск";
                                    checked: root.auto-connect-on-startup;
                                    enabled: root.launch-at-sign-in-enabled && !root.profile-menu-open;
                                    toggled(value) => { root.auto-connect-on-startup = value; }
                                }
                            }
                        }
                        if root.tun-toggle-available: HorizontalLayout {
                            padding-left: 4px;
                            padding-top: 6px;
                            Footnote { text: "Без TUN трафик идёт через системный прокси — без запроса прав администратора"; }
                        }
                        Rectangle { height: 18px; background: transparent; }

                        HorizontalLayout { height: 22px; padding-left: 4px; SectionCaption { text: "ПРИЛОЖЕНИЕ"; } }
                        app-card := Rectangle {
                        opacity: root.page-entering ? 0 : 1;
                        animate opacity { duration: 280ms; delay: 48ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
                            height: app-rows.preferred-height;
                            background: Theme.surface;
                            border-color: #ffffff0a;
                            border-width: 1px;
                            border-radius: 14px;
                            clip: true;
                            app-rows := VerticalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                spacing: 0px;
                                ToggleRow {
                                    label: "Запускать при входе в " + root.system-name;
                                    description: root.launch-at-sign-in-stale ? "Путь приложения изменился — включите заново" : "";
                                    checked: root.launch-at-sign-in-enabled;
                                    show-separator: true;
                                    enabled: !root.profile-menu-open;
                                    toggled(value) => { root.set-launch-at-sign-in(value); }
                                }
                                ToggleRow {
                                    label: "Живой фон";
                                    description: root.reduced-motion ? "Анимация отключена настройками " + root.system-name : "Спокойные волны на главной";
                                    // Under system reduced-motion the animation never runs, so the
                                    // switch must not look on/enabled while the text says it's off.
                                    checked: root.ambient-background-enabled && !root.reduced-motion;
                                    enabled: !root.profile-menu-open && !root.reduced-motion;
                                    toggled(value) => { root.ambient-background-enabled = value; }
                                }
                            }
                        }
                        if root.launch-at-sign-in-error != "": HorizontalLayout { padding-left: 4px; padding-top: 6px; Text { min-height: 20px; text: root.launch-at-sign-in-error; color: Theme.error; font-size: Theme.type-metadata-size; wrap: word-wrap; } }
                        Rectangle { height: 18px; background: transparent; }

                        HorizontalLayout { height: 22px; padding-left: 4px; SectionCaption { text: "ОБНОВЛЕНИЯ"; } }
                        updates-card := Rectangle {
                        opacity: root.page-entering ? 0 : 1;
                        animate opacity { duration: 280ms; delay: 72ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
                            height: Math.max(60px, updates-row.preferred-height);
                            background: Theme.surface;
                            border-color: root.update-available ? #4c9dff55 : #ffffff0a;
                            border-width: 1px;
                            border-radius: 14px;
                            updates-row := HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 10px;
                                padding-top: 11px;
                                padding-bottom: 11px;
                                spacing: 12px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 2px;
                                    Text { text: root.update-status; color: Theme.text-primary; font-size: Theme.type-label-size; font-weight: Theme.weight-medium; overflow: elide; }
                                    Text { text: root.update-detail; color: Theme.text-muted; font-size: Theme.type-metadata-size; wrap: word-wrap; }
                                }
                                if root.update-action-label != "": VerticalLayout {
                                    alignment: center;
                                    TextAction {
                                        label: root.update-action-label;
                                        enabled: root.update-action-enabled && !root.update-busy && !root.profile-menu-open && !root.update-confirm-open
                                            && !(root.update-runtime-busy && root.update-available);
                                        activated => { root.update-action(); }
                                    }
                                }
                            }
                        }
                        if root.preference-error != "": HorizontalLayout { padding-left: 4px; padding-top: 10px; Text { min-height: 20px; text: root.preference-error; color: Theme.error; font-size: Theme.type-metadata-size; wrap: word-wrap; } }
                        Rectangle { vertical-stretch: 1; min-height: 24px; background: transparent; }
                        Text { height: 24px; text: root.runtime-versions; color: Theme.text-muted; font-size: Theme.type-metadata-size; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }

            if root.visible-page == "subscriptions": Rectangle {
                opacity: root.page-entering ? 0 : 1;
                y: root.page-entering ? 6px : 0px;
                animate opacity { duration: 180ms; easing: ease-out; }
                animate y { duration: 220ms; easing: ease-out; }
                background: transparent;
                subscriptions-scroll := ScrollView {
                    vertical-stretch: 1;
                    subscriptions-content := VerticalLayout {
                        width: subscriptions-scroll.visible-width;
                        min-height: subscriptions-scroll.visible-height;
                        padding-left: 28px;
                        padding-right: 28px;
                        padding-top: 22px;
                        padding-bottom: 24px;
                        spacing: 0px;
                        HorizontalLayout {
                            height: 36px;
                            Text { text: "Подписки"; color: Theme.text-primary; font-size: 20px; font-weight: Theme.weight-semibold; vertical-alignment: center; }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            VerticalLayout {
                                alignment: center;
                                TextAction {
                                    label: root.import-pending ? "Добавляем…" : "Добавить";
                                    icon: @image-url("../assets/plus.svg");
                                    has-icon: true;
                                    enabled: !root.import-pending;
                                    focus-epoch: root.profile-management-focus-id == "" ? root.profile-management-focus-serial : 0;
                                    activated => { root.add-subscription(); }
                                }
                            }
                        }
                        Footnote { text: "До 16 подписок · активна только одна · ссылки хранятся только на этом устройстве"; }
                        Rectangle { height: 16px; background: transparent; }

                        if root.deep-link-import-host != "": Text {
                            min-height: 24px;
                            text: root.import-pending ? "Добавляем подписку с " + root.deep-link-import-host + "…" : "Подписка с " + root.deep-link-import-host + " ожидает добавления…";
                            color: Theme.text-secondary;
                            font-size: Theme.type-metadata-size;
                            overflow: elide;
                            accessible-role: text;
                            accessible-live-region: polite;
                        }
                        // A deep-link import has no editor open; its failure still has to
                        // be visible next to the pending line.
                        if root.import-error != "" && !root.replace-editor-open: Text {
                            min-height: 24px;
                            text: root.import-error;
                            color: Theme.error;
                            font-size: Theme.type-metadata-size;
                            wrap: word-wrap;
                            accessible-role: text;
                            accessible-live-region: polite;
                        }
                        // "Добавить" opens one inline row, styled like the per-subscription editor.
                        if root.replace-editor-open: VerticalLayout {
                            vertical-stretch: 0;
                            spacing: 6px;
                            padding-bottom: 16px;
                            add-subscription-card := Rectangle {
                                height: 56px;
                                background: Theme.surface;
                                border-color: #ffffff0a;
                                border-width: 1px;
                                border-radius: 14px;
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 10px;
                                    spacing: 8px;
                                    VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    UrlField {
                                        text <=> root.subscription-draft;
                                        placeholder: "Ссылка на новую подписку";
                                        enabled: !root.import-pending;
                                        accessible-name: "URL подписки";
                                        init => { self.focus(); }
                                        accepted => {
                                            if (!root.import-pending && root.subscription-draft != "") {
                                                root.import-url(root.subscription-draft);
                                            }
                                        }
                                    }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        TextAction {
                                            label: "Отмена";
                                            tone: "neutral";
                                            enabled: !root.import-pending;
                                            activated => {
                                                root.replace-editor-open = false;
                                                root.subscription-draft = "";
                                                root.dismiss-first-run-import();
                                            }
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        TextAction { label: root.import-pending ? "Добавляем…" : "Добавить"; enabled: !root.import-pending && root.subscription-draft != ""; activated => { root.import-url(root.subscription-draft); } }
                                    }
                                }
                            }
                            if root.import-error != "": Text {
                                text: root.import-error;
                                color: Theme.error;
                                font-size: Theme.type-metadata-size;
                                wrap: word-wrap;
                                accessible-role: text;
                                accessible-live-region: polite;
                            }
                        }

                        HorizontalLayout { height: 22px; padding-left: 4px; SectionCaption { text: "МОИ ПОДПИСКИ"; } }
                        if root.profile-menu-loading: Text { height: 44px; text: "Загружаем подписки…"; color: Theme.text-muted; font-size: Theme.type-metadata-size; vertical-alignment: center; accessible-role: text; accessible-live-region: polite; }
                        if root.profile-menu-error != "": HorizontalLayout {
                            min-height: 52px;
                            spacing: 12px;
                            Text { horizontal-stretch: 1; text: root.profile-menu-error; color: Theme.error; font-size: Theme.type-metadata-size; wrap: word-wrap; vertical-alignment: center; accessible-role: text; accessible-live-region: polite; }
                            VerticalLayout { alignment: center; TextAction { label: "Повторить"; activated => { root.retry-profile-menu(); } } }
                        }
                        if root.profile-mutation-error != "": Text {
                            min-height: 24px;
                            text: root.profile-mutation-error;
                            color: Theme.error;
                            font-size: Theme.type-metadata-size;
                            wrap: word-wrap;
                            accessible-role: text;
                            accessible-live-region: polite;
                        }
                        if !root.profile-menu-loading && root.profile-menu-error == "" && root.subscription-profiles.length == 0: Rectangle {
                            height: 64px;
                            background: Theme.surface;
                            border-color: #ffffff0a;
                            border-width: 1px;
                            border-radius: 14px;
                            Text { text: "Подписок пока нет"; color: Theme.text-muted; font-size: Theme.type-metadata-size; vertical-alignment: center; horizontal-alignment: center; }
                        }
                        // One inset grouped card; the active subscription is tinted with a blue bar.
                        if root.subscription-profiles.length > 0: subscriptions-card := Rectangle {
                        opacity: root.page-entering ? 0 : 1;
                        animate opacity { duration: 280ms; delay: 24ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
                            height: profile-list.preferred-height;
                            background: Theme.surface;
                            border-color: #ffffff0a;
                            border-width: 1px;
                            border-radius: 14px;
                            clip: true;
                            profile-list := VerticalLayout {
                                alignment: start;
                                spacing: 0px;
                                for profile[index] in root.subscription-profiles: settings-profile-row := Rectangle {
                                    property <bool> editing: root.profile-edit-id == profile.id;
                                    property <bool> confirming: root.profile-delete-confirm-id == profile.id;
                                    property <bool> pending: root.profile-pending-id == profile.id;
                                    height: 56px + (self.editing || self.confirming ? 52px : 0px);
                                    clip: true;
                                    background: profile.active ? Theme.elevated : transparent;
                                    animate height { duration: Motion.reduced ? 0ms : 240ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
                                    animate background { duration: 200ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }

                                    // Clicking an inactive row makes it the active subscription.
                                    if !profile.active: activate-profile-focus := FocusScope {
                                        x: 0; y: 0; width: parent.width - 132px; height: 56px;
                                        enabled: root.subscription-management-enabled && root.profile-pending-operation == "none";
                                        focus-on-click: true; focus-on-tab-navigation: true;
                                        accessible-role: button; accessible-label: "Сделать активной " + profile.title; accessible-description: root.profile-switch-locked ? "Отключитесь, чтобы сменить подписку" : ""; accessible-enabled: self.enabled;
                                        accessible-action-default => { if (self.enabled) { root.activate-profile(profile.id); } }
                                        Rectangle { background: activate-profile-touch.has-hover && parent.enabled ? #ffffff06 : transparent; border-color: Theme.focus; border-width: parent.has-focus ? Theme.focus-width : 0px; animate background { duration: 160ms; easing: cubic-bezier(0.22, 1, 0.36, 1); } }
                                        key-pressed(event) => { if ((event.text == " " || event.text == "\n") && self.enabled) { root.activate-profile(profile.id); return accept; } return reject; }
                                        activate-profile-touch := TouchArea { enabled: parent.enabled; clicked => { root.activate-profile(profile.id); } }
                                    }
                                    if profile.active: Rectangle { x: 0; y: 18px; width: 3px; height: 20px; border-radius: 1.5px; background: Theme.accent-blue; }

                                    Rectangle {
                                        x: 12px; y: 14px; width: 28px; height: 28px;
                                        border-radius: 14px;
                                        background: profile.active ? #4c9dff26 : #ffffff0d;
                                        opacity: profile.available || profile.active ? 1 : 0.62;
                                        if profile.has-logo: Image { x: 5px; y: 5px; width: 18px; height: 18px; source: profile.logo; image-fit: contain; accessible-role: none; }
                                        if !profile.has-logo: Text { text: profile.fallback; color: profile.active ? Theme.accent-blue : Theme.text-secondary; font-size: 11px; font-weight: Theme.weight-bold; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    subscription-name := Text {
                                        x: 52px; y: 9px; height: 20px;
                                        width: Math.min(self.preferred-width, parent.width - 52px - 132px - (profile.active ? 76px : 0px));
                                        text: profile.title;
                                        color: profile.available || profile.active ? Theme.text-primary : Theme.text-secondary;
                                        font-size: Theme.type-label-size;
                                        font-weight: profile.active ? Theme.weight-semibold : Theme.weight-medium;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    if profile.active: Rectangle {
                                        x: subscription-name.x + subscription-name.width + 8px; y: 11px; height: 16px;
                                        width: active-tag.preferred-width + 12px;
                                        border-radius: 4px;
                                        background: #3ccb7f1f;
                                        active-tag := Text { text: "АКТИВНА"; color: Theme.accent-green; font-size: 10px; font-weight: Theme.weight-bold; letter-spacing: 0.5px; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    Text {
                                        x: 52px; y: 29px; width: parent.width - 52px - 132px; height: 18px;
                                        text: settings-profile-row.pending
                                            ? root.profile-pending-operation == "refresh" ? "Обновляем…"
                                            : root.profile-pending-operation == "edit" ? "Меняем ссылку…"
                                            : root.profile-pending-operation == "delete" ? "Удаляем…"
                                            : "Применяем…"
                                            : !profile.available ? profile.expiry + " · " + profile.usage + " · Временно недоступна"
                                            : profile.expiry + " · " + profile.usage;
                                        color: settings-profile-row.pending ? Theme.accent-blue : !profile.available ? Theme.warning : Theme.text-muted;
                                        font-size: Theme.type-metadata-size;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        accessible-description: settings-profile-row.pending ? "" : !profile.available ? "Временно недоступна" : profile.active ? "Активна" : "Доступна";
                                    }

                                    refresh-profile-focus := FocusScope {
                                        property <int> focus-serial: root.profile-management-focus-serial;
                                        x: parent.width - 128px; y: 12px; width: 32px; height: 32px;
                                        enabled: root.subscription-refresh-enabled && profile.available && root.profile-pending-operation == "none";
                                        focus-on-click: true; focus-on-tab-navigation: true;
                                        accessible-role: button; accessible-label: "Обновить " + profile.title; accessible-enabled: self.enabled;
                                        accessible-action-default => { if (self.enabled) { root.refresh-profile(profile.id); } }
                                        init => { if (root.profile-management-focus-id == profile.id && root.profile-management-focus-serial > 0) { self.focus(); } }
                                        changed focus-serial => { if (root.profile-management-focus-id == profile.id && self.enabled) { self.focus(); } }
                                        Rectangle { border-radius: 8px; opacity: parent.enabled ? 1 : 0.45; background: refresh-profile-touch.has-hover && parent.enabled ? #ffffff0d : transparent; border-color: Theme.focus; border-width: parent.has-focus ? Theme.focus-width : 0px; Image { x: 8px; y: 8px; width: 16px; height: 16px; source: @image-url("../assets/refresh.svg"); colorize: refresh-profile-touch.has-hover ? Theme.text-primary : Theme.text-muted; image-fit: contain; accessible-role: none; transform-rotation: settings-profile-row.pending && root.profile-pending-operation == "refresh" && !root.reduced-motion ? Math.mod(animation-tick() / 1ms, 900) / 900 * 360deg : 0deg; } }
                                        key-pressed(event) => { if ((event.text == " " || event.text == "\n") && self.enabled) { root.refresh-profile(profile.id); return accept; } return reject; }
                                        refresh-profile-touch := TouchArea { enabled: parent.enabled; clicked => { root.refresh-profile(profile.id); } }
                                    }
                                    edit-profile-focus := FocusScope {
                                        x: parent.width - 92px; y: 12px; width: 32px; height: 32px;
                                        enabled: root.subscription-management-enabled && root.profile-pending-operation == "none";
                                        focus-on-click: true; focus-on-tab-navigation: true;
                                        accessible-role: button; accessible-label: "Изменить URL " + profile.title; accessible-enabled: self.enabled;
                                        accessible-action-default => { if (self.enabled) { root.profile-delete-confirm-id = ""; root.profile-edit-draft = ""; root.profile-edit-id = root.profile-edit-id == profile.id ? "" : profile.id; } }
                                        Rectangle { border-radius: 8px; opacity: parent.enabled ? 1 : 0.45; background: settings-profile-row.editing ? #4c9dff26 : edit-profile-touch.has-hover && parent.enabled ? #ffffff0d : transparent; border-color: Theme.focus; border-width: parent.has-focus ? Theme.focus-width : 0px; animate background { duration: 160ms; easing: cubic-bezier(0.22, 1, 0.36, 1); } Image { x: 8px; y: 8px; width: 16px; height: 16px; source: @image-url("../assets/edit.svg"); colorize: settings-profile-row.editing ? Theme.accent-blue : edit-profile-touch.has-hover ? Theme.text-primary : Theme.text-muted; image-fit: contain; accessible-role: none; } }
                                        key-pressed(event) => { if ((event.text == " " || event.text == "\n") && self.enabled) { root.profile-delete-confirm-id = ""; root.profile-edit-draft = ""; root.profile-edit-id = root.profile-edit-id == profile.id ? "" : profile.id; return accept; } return reject; }
                                        edit-profile-touch := TouchArea { enabled: parent.enabled; clicked => { root.profile-delete-confirm-id = ""; root.profile-edit-draft = ""; root.profile-edit-id = root.profile-edit-id == profile.id ? "" : profile.id; } }
                                    }
                                    delete-profile-focus := FocusScope {
                                        property <int> focus-serial: root.profile-delete-control-focus-serial;
                                        x: parent.width - 56px; y: 12px; width: 32px; height: 32px;
                                        enabled: root.subscription-refresh-enabled && root.profile-pending-operation == "none";
                                        focus-on-click: true; focus-on-tab-navigation: true;
                                        accessible-role: button; accessible-label: "Удалить " + profile.title; accessible-enabled: self.enabled;
                                        accessible-action-default => { if (self.enabled) { root.profile-edit-id = ""; root.profile-delete-confirm-id = profile.id; } }
                                        init => { if (root.profile-delete-control-focus-id == profile.id && root.profile-delete-control-focus-serial > 0) { self.focus(); } }
                                        changed focus-serial => { if (root.profile-delete-control-focus-id == profile.id && self.enabled) { self.focus(); } }
                                        Rectangle { border-radius: 8px; opacity: parent.enabled ? 1 : 0.45; background: settings-profile-row.confirming ? #f06a6a1f : delete-profile-touch.has-hover && parent.enabled ? #f06a6a14 : transparent; border-color: Theme.focus; border-width: parent.has-focus ? Theme.focus-width : 0px; animate background { duration: 160ms; easing: cubic-bezier(0.22, 1, 0.36, 1); } Image { x: 8px; y: 8px; width: 16px; height: 16px; source: @image-url("../assets/trash.svg"); colorize: settings-profile-row.confirming || delete-profile-touch.has-hover ? Theme.error : Theme.text-muted; image-fit: contain; accessible-role: none; } }
                                        key-pressed(event) => { if ((event.text == " " || event.text == "\n") && self.enabled) { root.profile-edit-id = ""; root.profile-delete-confirm-id = profile.id; return accept; } return reject; }
                                        delete-profile-touch := TouchArea { enabled: parent.enabled; clicked => { root.profile-edit-id = ""; root.profile-delete-confirm-id = profile.id; } }
                                    }

                                    // The editor and the delete confirmation attach under their own row.
                                    if settings-profile-row.editing: HorizontalLayout {
                                        x: 52px; y: 56px; width: parent.width - 52px - 10px; height: 52px; spacing: 8px;
                                        // Fades in with the row's own height animation — no extra timer.
                                        opacity: Math.max(0, Math.min(1, (settings-profile-row.height - 56px) / 52px));
                                        VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        UrlField {
                                            text <=> root.profile-edit-draft;
                                            placeholder: "Новый URL подписки";
                                            enabled: root.profile-pending-operation == "none";
                                            accessible-name: "Новый URL для " + profile.title;
                                            init => { self.focus(); }
                                            accepted => {
                                                if (root.profile-edit-draft != "" && root.profile-pending-operation == "none") {
                                                    root.replace-profile-source(profile.id, root.profile-edit-draft);
                                                }
                                            }
                                        }
                                        }
                                        VerticalLayout { alignment: center; TextAction { label: "Отмена"; tone: "neutral"; enabled: root.profile-pending-operation == "none"; activated => { root.profile-edit-id = ""; root.profile-edit-draft = ""; } } }
                                        VerticalLayout { alignment: center; TextAction { label: root.profile-pending-operation == "edit" ? "Сохраняем…" : "Сохранить"; enabled: root.profile-edit-draft != "" && root.profile-pending-operation == "none"; activated => { root.replace-profile-source(profile.id, root.profile-edit-draft); } } }
                                    }
                                    if settings-profile-row.confirming: HorizontalLayout {
                                        x: 52px; y: 56px; width: parent.width - 52px - 10px; height: 52px; spacing: 8px;
                                        // Fades in with the row's own height animation — no extra timer.
                                        opacity: Math.max(0, Math.min(1, (settings-profile-row.height - 56px) / 52px));
                                        Text { horizontal-stretch: 1; text: "Удалить подписку?"; color: Theme.text-secondary; font-size: Theme.type-label-size; vertical-alignment: center; }
                                        VerticalLayout { alignment: center; TextAction { label: "Отмена"; tone: "neutral"; enabled: root.profile-pending-operation == "none"; activated => { root.profile-delete-control-focus-id = profile.id; root.profile-delete-confirm-id = ""; root.profile-delete-control-focus-serial += 1; } } }
                                        VerticalLayout { alignment: center; TextAction { label: "Удалить"; tone: "danger"; enabled: root.profile-pending-operation == "none"; activated => { root.delete-profile(profile.id); } } }
                                    }
                                    if index < root.subscription-profiles.length - 1: Rectangle { x: 52px; y: parent.height - 1px; width: parent.width - 52px; height: 1px; background: #ffffff0f; }
                                }
                            }
                        }
                        HorizontalLayout {
                            padding-left: 4px;
                            padding-top: 8px;
                            Footnote {
                                text: root.profile-switch-locked && root.subscription-profiles.length > 1
                                    ? "Отключитесь, чтобы сменить подписку"
                                    : "Нажмите на подписку, чтобы сделать её активной. Обновление происходит автоматически при запуске приложения или вручную.";
                            }
                        }
                        Rectangle { vertical-stretch: 1; background: transparent; }
                    }
                }
            }

            if root.profile-menu-open: TouchArea {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                clicked => { root.close-profile-menu(); }
            }

            profile-menu := Rectangle {
                x: -8px;
                y: root.profile-menu-open ? 8px : 0px;
                width: Math.min(420px, parent.width - 16px);
                height: Math.min(parent.height - 16px, root.profile-menu-content-height);
                visible: self.opacity > 0;
                drop-shadow-blur: 24px;
                drop-shadow-offset-y: 8px;
                drop-shadow-color: #00000080;
                background: Theme.elevated;
                border-color: Theme.line;
                border-width: 1px;
                border-radius: 14px;
                clip: true;
                opacity: root.profile-menu-open ? 1 : 0;
                animate opacity { duration: 160ms; easing: ease-out; }
                animate y { duration: 160ms; easing: ease-out; }

                VerticalLayout {
                    padding: 8px;
                    spacing: 2px;

                    if root.profile-switch-locked: HorizontalLayout {
                        height: 26px;
                        padding-left: 10px;
                        padding-right: 10px;
                        Text {
                            text: "Отключитесь, чтобы сменить подписку";
                            color: Theme.text-muted;
                            font-size: Theme.type-metadata-size;
                            vertical-alignment: center;
                            overflow: elide;
                            accessible-role: text;
                        }
                    }

                    if root.profile-mutation-error != "": HorizontalLayout {
                        height: 38px;
                        padding-left: 10px;
                        padding-right: 10px;
                        Text {
                            text: root.profile-mutation-error;
                            color: Theme.error;
                            font-size: Theme.type-metadata-size;
                            wrap: word-wrap;
                            overflow: elide;
                            vertical-alignment: center;
                            accessible-role: text;
                            accessible-live-region: polite;
                        }
                    }

                    if root.profile-menu-error != "": Rectangle {
                        height: 88px;
                        background: transparent;
                        border-radius: 8px;
                        Text {
                            x: 8px; y: 4px; width: parent.width - 116px; height: 72px;
                            text: root.profile-menu-error;
                            color: Theme.error;
                            font-size: Theme.type-metadata-size;
                            wrap: word-wrap;
                            vertical-alignment: center;
                            accessible-role: text;
                            accessible-live-region: polite;
                        }
                        retry-profile-focus := FocusScope {
                            x: parent.width - 100px; y: 22px; width: 92px; height: 44px;
                            enabled: root.profile-menu-open;
                            focus-on-click: true;
                            focus-on-tab-navigation: root.profile-menu-keyboard-open;
                            accessible-role: button;
                            accessible-label: "Повторить загрузку профилей";
                            accessible-action-default => { root.retry-profile-menu(); }
                            init => { if (root.profile-menu-keyboard-open) { self.focus(); } }
                            Rectangle {
                                border-radius: 8px;
                                background: retry-profile-touch.has-hover ? #ffffff0d : Theme.surface;
                                border-color: parent.has-focus && root.profile-menu-keyboard-open ? Theme.focus : Theme.line;
                                border-width: 1px;
                                Text { text: "Повторить"; color: Theme.text-primary; font-size: Theme.type-metadata-size; font-weight: Theme.weight-semibold; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            key-pressed(event) => { if (event.text == " " || event.text == "\n") { root.retry-profile-menu(); return accept; } return reject; }
                            retry-profile-touch := TouchArea { clicked => { root.retry-profile-menu(); } }
                        }
                    }

                    if root.profile-menu-loading: loading-focus := FocusScope {
                        height: 128px;
                        enabled: true;
                        accessible-role: text;
                        accessible-label: "Загружаем профили";
                        init => { if (root.profile-menu-keyboard-open) { self.focus(); } }
                        VerticalLayout {
                            spacing: 2px;
                            Text { height: 20px; text: "Загружаем профили…"; color: Theme.text-muted; font-size: Theme.type-metadata-size; vertical-alignment: center; accessible-role: text; accessible-live-region: polite; }
                            Rectangle {
                                height: 52px; background: #ffffff06; border-radius: 14px;
                                Rectangle { x: 10px; y: 10px; width: 32px; height: 32px; border-radius: 8px; background: #ffffff0a; }
                                Rectangle { x: 52px; y: 15px; width: parent.width - 92px; height: 9px; border-radius: 4px; background: #ffffff10; }
                                Rectangle { x: 52px; y: 30px; width: parent.width - 132px; height: 7px; border-radius: 4px; background: #ffffff08; }
                            }
                            Rectangle {
                                height: 52px; background: #ffffff04; border-radius: 14px;
                                Rectangle { x: 10px; y: 10px; width: 32px; height: 32px; border-radius: 8px; background: #ffffff0a; }
                                Rectangle { x: 52px; y: 15px; width: parent.width - 112px; height: 9px; border-radius: 4px; background: #ffffff10; }
                                Rectangle { x: 52px; y: 30px; width: parent.width - 152px; height: 7px; border-radius: 4px; background: #ffffff08; }
                            }
                        }
                    }

                    if !root.profile-menu-loading && root.profile-menu-error == "": profile-scroll := ScrollView {
                        vertical-stretch: 1;
                        horizontal-stretch: 1;
                        VerticalLayout {
                            spacing: 2px;
                            for profile[index] in root.subscription-profiles: profile-row := Rectangle {
                                height: 52px;
                                property <bool> switchable: profile.active || (profile.available && !root.profile-switch-locked);
                                background: profile-row-touch.has-hover && self.switchable ? #ffffff08 : transparent;
                                border-radius: 14px;
                                opacity: self.switchable ? 1 : 0.62;

                                Rectangle {
                                    x: 10px; y: 10px; width: 32px; height: 32px;
                                    border-radius: 8px;
                                    background: Theme.surface;
                                    if profile.has-logo: Image { x: 5px; y: 5px; width: 22px; height: 22px; source: profile.logo; image-fit: contain; accessible-role: none; }
                                    if !profile.has-logo: Text { text: profile.fallback; color: Theme.text-secondary; font-size: Theme.type-metadata-size; font-weight: Theme.weight-semibold; horizontal-alignment: center; vertical-alignment: center; }
                                }

                                Text {
                                    x: 52px; width: parent.width - 88px; height: parent.height;
                                    text: root.profile-pending-id == profile.id && root.profile-pending-operation == "activate" ? profile.title + " · Переключаем…" : profile.title;
                                    color: Theme.text-primary;
                                    font-size: Theme.type-label-size;
                                    font-weight: profile.active ? Theme.weight-semibold : Theme.weight-regular;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                                if profile.active: Path {
                                    x: parent.width - 28px; y: 18px; width: 16px; height: 16px;
                                    viewbox-width: 16; viewbox-height: 16;
                                    commands: "M 3 8 L 7 12 L 14 4";
                                    stroke: Theme.accent-blue; stroke-width: 1.5px; fill: transparent;
                                }

                                profile-row-focus := FocusScope {
                                    enabled: root.profile-menu-open && profile-row.switchable && root.profile-pending-operation == "none";
                                    focus-on-click: true;
                                    focus-on-tab-navigation: root.profile-menu-keyboard-open;
                                    accessible-role: button;
                                    accessible-label: profile.active ? profile.title + ", активная подписка" : "Активировать " + profile.title;
                                    accessible-enabled: self.enabled;
                                    accessible-action-default => { if (self.enabled) { if (profile.active) { root.close-profile-menu(); } else { root.activate-profile(profile.id); } } }
                                    init => { if (index == 0 && self.enabled && root.profile-menu-keyboard-open) { self.focus(); } }
                                    key-pressed(event) => {
                                        if ((event.text == " " || event.text == "\n") && self.enabled) {
                                            if (profile.active) { root.close-profile-menu(); } else { root.activate-profile(profile.id); }
                                            return accept;
                                        }
                                        return reject;
                                    }
                                    profile-row-touch := TouchArea { enabled: parent.enabled; clicked => { if (profile.active) { root.close-profile-menu(); } else { root.activate-profile(profile.id); } } }
                                    Rectangle { x: 2px; y: 2px; width: parent.width - 4px; height: parent.height - 4px; border-radius: 12px; border-width: parent.has-focus && root.profile-menu-keyboard-open ? 1px : 0px; border-color: Theme.focus; background: transparent; }
                                }
                            }
                        }
                    }
                }
            }

            if root.announcement-open && root.subscription-announcement-text != "": TouchArea {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                clicked => { root.announcement-open = false; }
            }

            announcement-popover := Rectangle {
                property <bool> shown: root.announcement-open && root.subscription-announcement-text != "";
                x: -8px;
                y: self.shown ? 8px : 0px;
                width: Math.min(420px, parent.width - 16px);
                height: announcement-copy.preferred-height + 28px;
                visible: self.opacity > 0;
                opacity: self.shown ? 1 : 0;
                background: Theme.elevated;
                border-color: root.subscription-announcement-tone == "danger" ? #f06a6a66 : root.subscription-announcement-tone == "success" ? #3ccb7f66 : #4c9dff66;
                border-width: 1px;
                border-radius: 12px;
                drop-shadow-blur: 24px;
                drop-shadow-offset-y: 8px;
                drop-shadow-color: #00000080;
                animate opacity { duration: 160ms; easing: ease-out; }
                animate y { duration: 160ms; easing: ease-out; }

                Image {
                    x: 14px;
                    y: 14px;
                    width: 18px;
                    height: 18px;
                    source: root.subscription-announcement-tone == "danger" ? @image-url("../assets/announcement-danger.svg")
                        : root.subscription-announcement-tone == "success" ? @image-url("../assets/announcement-success.svg")
                        : @image-url("../assets/announcement-info.svg");
                    image-fit: contain;
                    accessible-role: none;
                }
                announcement-copy := Text {
                    x: 42px;
                    y: 14px;
                    width: parent.width - 56px;
                    text: root.subscription-announcement-text;
                    color: Theme.text-secondary;
                    font-size: Theme.type-metadata-size;
                    wrap: word-wrap;
                    accessible-role: text;
                    accessible-description: root.subscription-announcement-text;
                }
            }
            }
        }
        }
    }

    if root.update-confirm-open && !root.deep-link-confirm-open: Rectangle {
        x: root.resize-border;
        y: root.resize-border;
        width: parent.width - 2 * root.resize-border;
        height: parent.height - 2 * root.resize-border;
        background: #05070bc7;
        opacity: root.update-confirm-open ? 1 : 0;
        animate opacity { duration: 140ms; easing: ease-out; }
        TouchArea {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
        }

        update-confirm-card := Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: Math.min(420px, parent.width - 48px);
            height: 210px;
            background: Theme.elevated;
            border-color: Theme.line;
            border-width: 1px;
            border-radius: 16px;

            update-modal-focus := FocusScope {
                width: parent.width;
                height: parent.height;
                focus-on-tab-navigation: false;
                capture-key-pressed(event) => {
                    if (event.text == Key.Tab || event.text == Key.Backtab) {
                        if (update-cancel-action.action-has-focus) { update-confirm-action.focus-action(); }
                        else { update-cancel-action.focus-action(); }
                        return accept;
                    }
                    return reject;
                }
                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        root.update-confirm-open = false;
                        root.cancel-update-restart();
                        return accept;
                    }
                    return reject;
                }
            VerticalLayout {
                padding: 24px;
                spacing: 12px;
                Text {
                    height: 26px;
                    text: "Обновить MultiCore?";
                    color: Theme.text-primary;
                    font-family: Theme.font-family;
                    font-size: Theme.type-label-size;
                    font-weight: Theme.weight-semibold;
                    vertical-alignment: center;
                }
                Text {
                    height: 54px;
                    text: "Скачать обновление и перезапустить клиент?\nАктивный туннель будет корректно остановлен.";
                    color: Theme.text-secondary;
                    font-family: Theme.font-family;
                    font-size: Theme.type-metadata-size;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }
                Rectangle { vertical-stretch: 1; background: transparent; }
                HorizontalLayout {
                    height: 44px;
                    alignment: end;
                    spacing: 8px;
                    // Conditional creation does not fire changed focus-epoch.
                    update-cancel-action := SmallAction {
                        width: 88px;
                        label: "Отмена";
                        focus-epoch: root.update-confirm-focus-serial;
                        init => { self.focus-action(); }
                        activated => {
                            root.update-confirm-open = false;
                            root.cancel-update-restart();
                        }
                    }
                    update-confirm-action := SmallAction {
                        width: 200px;
                        label: "Обновить и перезапустить";
                        selected: true;
                        enabled: !root.update-runtime-busy;
                        activated => { root.confirm-update-restart(); }
                    }
                }
            }
            }
        }
    }

    if root.deep-link-confirm-open: Rectangle {
        x: root.resize-border;
        y: root.resize-border;
        width: parent.width - 2 * root.resize-border;
        height: parent.height - 2 * root.resize-border;
        background: #05070bc7;
        TouchArea { width: parent.width; height: parent.height; }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: Math.min(420px, parent.width - 48px);
            height: 232px;
            background: Theme.elevated;
            border-color: Theme.line;
            border-width: 1px;
            border-radius: 16px;

            deep-link-modal-focus := FocusScope {
                width: parent.width;
                height: parent.height;
                focus-on-tab-navigation: false;
                capture-key-pressed(event) => {
                    if (event.text == Key.Tab || event.text == Key.Backtab) {
                        if (no-action.action-has-focus) { yes-action.focus-action(); }
                        else { no-action.focus-action(); }
                        return accept;
                    }
                    return reject;
                }
                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        root.cancel-deep-link();
                        return accept;
                    }
                    return reject;
                }
                VerticalLayout {
                    padding: 24px;
                    spacing: 12px;
                    Text {
                        height: 26px;
                        text: "Добавить подписку?";
                        color: Theme.text-primary;
                        font-size: Theme.type-label-size;
                        font-weight: Theme.weight-semibold;
                    }
                    Text {
                        height: 36px;
                        text: "Получена ссылка. Загрузить подписку с домена:";
                        color: Theme.text-secondary;
                        font-size: Theme.type-metadata-size;
                        wrap: word-wrap;
                    }
                    Text {
                        height: 26px;
                        text: root.deep-link-confirm-host;
                        color: Theme.text-primary;
                        font-size: Theme.type-label-size;
                        font-weight: Theme.weight-semibold;
                        overflow: elide;
                        accessible-role: text;
                    }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                    HorizontalLayout {
                        height: 44px;
                        alignment: end;
                        spacing: 8px;
                        // Conditional creation does not fire changed focus-epoch.
                        no-action := SmallAction { width: 88px; label: "Отмена"; focus-epoch: root.deep-link-focus-serial; init => { self.focus-action(); } activated => { root.cancel-deep-link(); } }
                        yes-action := SmallAction { width: 104px; label: "Добавить"; selected: true; activated => { root.confirm-deep-link(); } }
                    }
                }
            }
        }
    }

    // A taskbar restore has no application callback; the native minimized property
    // supplies the matching resume edge without waking a tray-hidden window.
    changed minimized => {
        root.shell-active = !root.minimized;
    }

    TouchArea {
        x: root.resize-border; y: 0px; width: parent.width - 2 * root.resize-border; height: root.resize-border;
        mouse-cursor: ns-resize;
        pointer-event(event) => { if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) { root.window-resize("n"); } }
    }
    TouchArea {
        x: parent.width - root.resize-border; y: root.resize-border; width: root.resize-border; height: parent.height - 2 * root.resize-border;
        mouse-cursor: ew-resize;
        pointer-event(event) => { if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) { root.window-resize("e"); } }
    }
    TouchArea {
        x: root.resize-border; y: parent.height - root.resize-border; width: parent.width - 2 * root.resize-border; height: root.resize-border;
        mouse-cursor: ns-resize;
        pointer-event(event) => { if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) { root.window-resize("s"); } }
    }
    TouchArea {
        x: 0px; y: root.resize-border; width: root.resize-border; height: parent.height - 2 * root.resize-border;
        mouse-cursor: ew-resize;
        pointer-event(event) => { if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) { root.window-resize("w"); } }
    }
    TouchArea {
        x: 0px; y: 0px; width: root.resize-border; height: root.resize-border;
        mouse-cursor: nwse-resize;
        pointer-event(event) => { if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) { root.window-resize("nw"); } }
    }
    TouchArea {
        x: parent.width - root.resize-border; y: 0px; width: root.resize-border; height: root.resize-border;
        mouse-cursor: nesw-resize;
        pointer-event(event) => { if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) { root.window-resize("ne"); } }
    }
    TouchArea {
        x: parent.width - root.resize-border; y: parent.height - root.resize-border; width: root.resize-border; height: root.resize-border;
        mouse-cursor: nwse-resize;
        pointer-event(event) => { if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) { root.window-resize("se"); } }
    }
    TouchArea {
        x: 0px; y: parent.height - root.resize-border; width: root.resize-border; height: root.resize-border;
        mouse-cursor: nesw-resize;
        pointer-event(event) => { if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) { root.window-resize("sw"); } }
    }
}
