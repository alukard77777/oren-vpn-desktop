import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import "../assets/fonts/Twemoji.Mozilla.ttf";

export struct TrayMenuRow {
    id: string,
    group-id: string,
    icon: string,
    icon-image: image,
    label: string,
    detail: string,
    selected: bool,
    enabled: bool,
    expanded: bool,
    node-count: int,
}

component PopupAction inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <image> icon-image;
    in property <string> icon-kind;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    callback activated();

    height: 40px;
    border-radius: Theme.radius-small;
    background: root.selected ? #4c9dff16 : action-touch.has-hover ? #ffffff0b : transparent;
    opacity: root.enabled ? 1 : 0.42;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.activated(); } }

    if root.icon-image.width > 0: Image {
        x: 12px;
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        source: root.icon-image;
        image-fit: contain;
    }

    if root.icon != "" && root.icon-image.width == 0: Text {
        x: 10px;
        width: 22px;
        height: parent.height;
        text: root.icon;
        color: Theme.text-secondary;
        font-family: Theme.emoji-font-family;
        font-size: 15px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if root.icon-kind == "window": Path {
        x: 12px;
        y: 11px;
        width: 18px;
        height: 18px;
        viewbox-width: 18;
        viewbox-height: 18;
        commands: "M 2.5 4.5 L 15.5 4.5 L 15.5 15.5 L 2.5 15.5 Z M 10 2.5 L 15.5 2.5 L 15.5 8 M 15 3 L 9 9";
        stroke: Theme.text-secondary;
        stroke-width: 1.5px;
        fill: transparent;
    }

    if root.icon-kind == "exit": Path {
        x: 12px;
        y: 11px;
        width: 18px;
        height: 18px;
        viewbox-width: 18;
        viewbox-height: 18;
        commands: "M 8 3 L 3 3 L 3 15 L 8 15 M 10 6 L 14 9 L 10 12 M 14 9 L 7 9";
        stroke: Theme.text-muted;
        stroke-width: 1.5px;
        fill: transparent;
    }

    Text {
        x: root.icon != "" || root.icon-kind != "" ? 40px : 12px;
        width: parent.width - self.x - (root.selected ? 36px : 12px);
        height: parent.height;
        text: root.label;
        color: root.selected ? Theme.text-primary : Theme.text-secondary;
        font-family: Theme.font-family;
        font-size: 13px;
        font-weight: root.selected ? Theme.weight-semibold : Theme.weight-regular;
        vertical-alignment: center;
        overflow: elide;
    }

    if root.selected: Path {
        x: parent.width - 25px;
        y: 14px;
        width: 12px;
        height: 10px;
        viewbox-width: 12;
        viewbox-height: 10;
        commands: "M 1 5 L 4.5 8.5 L 11 1.5";
        stroke: Theme.accent-blue;
        stroke-width: 1.6px;
        fill: transparent;
    }

    action-focus := FocusScope {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        focus-on-click: true;
        focus-on-tab-navigation: true;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.activated();
                return accept;
            }
            return reject;
        }
        Rectangle {
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            height: parent.height - 2px;
            border-radius: Theme.radius-small;
            border-width: parent.has-focus ? 1px : 0px;
            border-color: Theme.focus;
            background: transparent;
        }
        action-touch := TouchArea {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            enabled: root.enabled;
            clicked => { root.activated(); }
        }
    }
}

component TrayConnectAction inherits Rectangle {
    in property <string> label;
    in property <bool> connected: false;
    in property <bool> enabled: true;
    callback activated();

    height: 56px;
    border-radius: Theme.radius-large;
    border-width: connect-focus.has-focus ? Theme.focus-width : 1px;
    border-color: connect-focus.has-focus ? Theme.focus : root.connected ? #3ccb7f80 : #4c9dff80;
    background: root.connected ? #101a16 : #101721;
    clip: true;
    opacity: root.enabled ? 1 : 0.46;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.activated(); } }

    connect-mesh-field := Rectangle {
        property <bool> active: connect-touch.has-hover || connect-focus.has-focus;
        property <length> cursor-x: connect-touch.has-hover ? connect-touch.mouse-x : 28px;
        property <length> cursor-y: connect-touch.has-hover ? connect-touch.mouse-y : 28px;
        property <color> glow-strong: root.connected ? #22c55e32 : #0091ff3d;
        property <color> glow-medium: root.connected ? #22c55e1d : #0091ff24;
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: @radial-gradient(
            circle 108px at cursor-x cursor-y,
            glow-strong 0%,
            glow-medium 36%,
            #00000000 76%
        );
        opacity: self.active ? 1 : 0;
        animate opacity { duration: 150ms; easing: ease-out; }

        for _[grid-x] in 48: Rectangle {
            x: grid-x * 6px;
            y: 0px;
            width: 6px;
            height: parent.height;
            background: transparent;
            for _[grid-y] in 10: Rectangle {
                property <float> dx: (grid-x * 6px + 3px - connect-mesh-field.cursor-x) / 112px;
                property <float> dy: (grid-y * 6px + 3px - connect-mesh-field.cursor-y) / 48px;
                property <float> distance: Math.sqrt(self.dx * self.dx + self.dy * self.dy);
                x: 0px;
                y: grid-y * 6px;
                width: 6px;
                height: 6px;
                background: transparent;
                border-width: 0.5px;
                border-color: root.connected ? #8ea39758 : #8f9eae58;
                opacity: connect-mesh-field.active ? Math.max(0, 1 - self.distance) : 0;
            }
        }
    }

    Rectangle {
        x: 12px;
        y: 10px;
        width: 36px;
        height: 36px;
        border-radius: 18px;
        background: root.connected ? #0d1814e8 : #101722e8;
        border-color: root.connected ? Theme.accent-green : Theme.accent-blue;
        border-width: 1px;
        Image {
            x: 8px;
            y: 8px;
            width: 20px;
            height: 20px;
            source: @image-url("../assets/power.svg");
            image-fit: contain;
            accessible-role: none;
        }
    }

    Text {
        x: 60px;
        width: parent.width - 76px;
        height: parent.height;
        text: root.label;
        color: Theme.text-primary;
        font-size: 14px;
        font-weight: Theme.weight-semibold;
        vertical-alignment: center;
        overflow: elide;
    }

    connect-focus := FocusScope {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        focus-on-click: true;
        focus-on-tab-navigation: true;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.activated();
                return accept;
            }
            return reject;
        }
        connect-touch := TouchArea {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            enabled: root.enabled;
            clicked => { root.activated(); }
        }
    }
}

component RouteGroupAction inherits Rectangle {
    in property <string> icon;
    in property <image> icon-image;
    in property <string> label;
    in property <string> detail;
    in property <bool> expanded: false;
    in property <bool> enabled: true;
    callback activated();

    height: 48px;
    border-radius: Theme.radius-small;
    background: root.expanded ? #4c9dff14 : route-group-touch.has-hover ? #ffffff0b : transparent;
    opacity: root.enabled ? 1 : 0.42;
    accessible-role: button;
    accessible-label: root.label + ": " + root.detail;
    accessible-description: root.expanded ? "Список серверов открыт" : "Открыть список серверов";
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.activated(); } }

    VerticalLayout {
        x: 44px;
        y: 7px;
        width: parent.width - 76px;
        height: 34px;
        spacing: 1px;
        Text {
            text: root.label;
            color: Theme.text-primary;
            font-size: 13px;
            font-weight: Theme.weight-semibold;
            overflow: elide;
        }
        Text {
            text: root.detail;
            color: root.expanded ? Theme.accent-blue : Theme.text-muted;
            font-size: Theme.type-metadata-size;
            overflow: elide;
        }
    }

    if root.icon-image.width > 0: Image {
        x: 14px;
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        source: root.icon-image;
        image-fit: contain;
    }

    if root.icon-image.width == 0: Text {
        x: 12px;
        width: 22px;
        height: parent.height;
        text: root.icon;
        color: Theme.text-secondary;
        font-family: Theme.emoji-font-family;
        font-size: 15px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Path {
        x: parent.width - 24px;
        y: 20px;
        width: 10px;
        height: 7px;
        viewbox-width: 10;
        viewbox-height: 7;
        commands: root.expanded ? "M 1 6 L 5 2 L 9 6" : "M 1 1 L 5 5 L 9 1";
        stroke: root.expanded ? Theme.accent-blue : Theme.text-muted;
        stroke-width: 1.5px;
        fill: transparent;
    }

    route-group-focus := FocusScope {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        focus-on-click: true;
        focus-on-tab-navigation: true;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.activated();
                return accept;
            }
            return reject;
        }
        Rectangle {
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            height: parent.height - 2px;
            border-radius: Theme.radius-small;
            border-width: parent.has-focus ? 1px : 0px;
            border-color: Theme.focus;
            background: transparent;
        }
        route-group-touch := TouchArea {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            enabled: root.enabled;
            clicked => { root.activated(); }
        }
    }
}

export component TrayPopup inherits Window {
    width: 304px;
    height: 460px;
    no-frame: true;
    always-on-top: true;
    background: #15181d;
    default-font-family: Theme.font-family;

    in property <string> status-text: "Готово";
    in property <string> connection-label: "Подключиться";
    in property <bool> connection-enabled: true;
    in property <bool> connected: false;
    in property <bool> has-profile: true;
    in property <[TrayMenuRow]> group-rows;
    in property <[TrayMenuRow]> node-rows;

    callback toggle-connection();
    callback toggle-group(string);
    callback select-node(string, string);
    callback open-main();
    callback add-subscription();
    callback exit-app();
    callback dismiss();

    popup-focus := FocusScope {
        width: parent.width;
        height: parent.height;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.dismiss();
                return accept;
            }
            return reject;
        }

        Rectangle {
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            height: parent.height - 2px;
            background: #15181dfa;
            border-color: #343a43;
            border-width: 1px;
            border-radius: Theme.radius-large;

            VerticalLayout {
                padding: 14px;
                spacing: 10px;

                HorizontalLayout {
                    height: 34px;
                    vertical-stretch: 0;
                    spacing: 10px;
                    Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: Theme.radius-small;
                        background: #4c9dff18;
                        Text {
                            text: "∞";
                            color: Theme.accent-blue;
                            font-size: 15px;
                            font-weight: Theme.weight-semibold;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    VerticalLayout {
                        spacing: 1px;
                        Text { text: "MULTICORE"; color: Theme.text-primary; font-size: 12px; font-weight: Theme.weight-bold; letter-spacing: 1px; }
                        Text { text: root.status-text; color: Theme.text-muted; font-size: Theme.type-metadata-size; overflow: elide; }
                    }
                }

                if root.has-profile: connect-action := TrayConnectAction {
                    label: root.connection-label;
                    enabled: root.connection-enabled;
                    connected: root.connected;
                    activated => { root.toggle-connection(); }
                }

                if !root.has-profile: PopupAction {
                    height: 44px;
                    vertical-stretch: 0;
                    label: "Добавить подписку";
                    icon-kind: "window";
                    activated => { root.add-subscription(); }
                }

                Rectangle { height: 1px; vertical-stretch: 0; background: Theme.line; }

                Text {
                    height: 18px;
                    vertical-stretch: 0;
                    text: "Маршруты";
                    color: Theme.text-muted;
                    font-size: Theme.type-metadata-size;
                    font-weight: Theme.weight-semibold;
                    vertical-alignment: center;
                }

                route-scroll := ScrollView {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    viewport-width: self.width;
                    VerticalLayout {
                        width: route-scroll.viewport-width;
                        spacing: 2px;
                        for group in root.group-rows: Rectangle {
                            height: 48px + (group.expanded ? group.node-count * 42px : 0px);
                            background: transparent;
                            route-group := RouteGroupAction {
                                x: 0px;
                                y: 0px;
                                width: parent.width;
                                icon: group.icon;
                                icon-image: group.icon-image;
                                label: group.label;
                                detail: group.detail;
                                expanded: group.expanded;
                                enabled: group.enabled;
                                activated => { root.toggle-group(group.id); }
                            }
                            if group.expanded: VerticalLayout {
                                x: 12px;
                                y: 48px;
                                width: parent.width - 12px;
                                spacing: 0px;
                                for node in root.node-rows: Rectangle {
                                    height: node.group-id == group.id ? 42px : 0px;
                                    background: transparent;
                                    PopupAction {
                                        x: 0px;
                                        y: 2px;
                                        width: parent.width;
                                        height: 40px;
                                        visible: parent.height > 0px;
                                        label: node.label;
                                        icon: node.icon;
                                        icon-image: node.icon-image;
                                        selected: node.selected;
                                        enabled: node.enabled;
                                        activated => { root.select-node(node.group-id, node.id); }
                                    }
                                }
                            }
                        }
                        if root.group-rows.length == 0: Text {
                            height: 48px;
                            text: "Маршруты пока недоступны";
                            color: Theme.text-muted;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle { height: 1px; vertical-stretch: 0; background: Theme.line; }

                HorizontalLayout {
                    height: 40px;
                    vertical-stretch: 0;
                    spacing: 4px;
                    PopupAction { horizontal-stretch: 1; label: "Открыть"; icon-kind: "window"; activated => { root.open-main(); } }
                    PopupAction { width: 104px; horizontal-stretch: 0; label: "Выйти"; icon-kind: "exit"; activated => { root.exit-app(); } }
                }
            }
        }
    }
}
