// OREN VPN Desktop Control Center: Cyber Crimson & Obsidian Dark surfaces.
export global Theme {
    out property <color> void: #0b0b0f;
    out property <color> canvas: #0b0b0f;
    out property <color> surface: #12121a;
    out property <color> elevated: #161622;
    out property <color> line: #232332;

    out property <color> text-primary: #f3f5f7;
    out property <color> text-secondary: #d5dbe2;
    out property <color> text-muted: #8f8f9e;

    out property <color> accent-blue: #ff2a4d;
    out property <color> accent-blue-hover: #ff4767;
    out property <color> accent-blue-pressed: #d60027;
    out property <color> accent-green: #00e699;
    out property <color> warning: #e7aa45;
    out property <color> error: #f06a6a;
    out property <color> focus: #ff6b82;

    out property <string> font-family: "Segoe UI Variable Text";
    out property <string> emoji-font-family: "Twemoji Mozilla";
    out property <length> type-metadata-size: 13px;
    out property <length> type-value-size: 16px;
    out property <length> type-label-size: 15px;
    out property <length> type-title-size: 22px;
    out property <int> weight-regular: 400;
    out property <int> weight-medium: 500;
    out property <int> weight-semibold: 600;
    out property <int> weight-title: 650;
    out property <int> weight-bold: 700;

    out property <length> radius-small: 8px;
    out property <length> radius-medium: 8px;
    out property <length> radius-large: 12px;
    out property <length> radius-panel: 12px;

    out property <length> space-1: 4px;
    out property <length> space-2: 8px;
    out property <length> space-3: 12px;
    out property <length> space-4: 16px;
    out property <length> space-6: 24px;
    out property <length> space-8: 32px;

    out property <length> interactive-min: 44px;
    out property <length> focus-width: 2px;
