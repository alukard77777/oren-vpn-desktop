#!/bin/sh
# Enable and (re)start the always-ready MultiCore service on install and upgrade.
set -e
case "$1" in
    configure|abort-upgrade|abort-remove|abort-deconfigure)
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload >/dev/null 2>&1 || true
            systemctl enable multicore.service >/dev/null 2>&1 || true
            systemctl restart multicore.service >/dev/null 2>&1 || true
        fi
        ;;
esac
exit 0
