#!/bin/sh
# Stop the MultiCore service before its files go away; removal also disables it.
set -e
if [ -d /run/systemd/system ]; then
    case "$1" in
        remove|deconfigure) systemctl disable --now multicore.service >/dev/null 2>&1 || true ;;
        upgrade) systemctl stop multicore.service >/dev/null 2>&1 || true ;;
    esac
fi
exit 0
