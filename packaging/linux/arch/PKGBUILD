pkgname=multicore
pkgver=@VERSION@
pkgrel=1
pkgdesc='Native network client combining Mihomo routing with Xray transports'
arch=('x86_64')
url='https://github.com/fatyzzz/multicore'
license=('GPL-3.0-only' 'MPL-2.0')
depends=('gtk3' 'libayatana-appindicator' 'polkit' 'fontconfig' 'freetype2' 'gcc-libs' 'libxkbcommon' 'libglvnd' 'iproute2' 'hicolor-icon-theme')
optdepends=('gnome-shell-extension-appindicator: tray icon in GNOME')
options=('!strip' '!debug')
source=("multicore-${pkgver}-stage.tar.zst")
sha256sums=('@SHA256@')
install=multicore.install

package() {
    cp -a "$srcdir/stage/." "$pkgdir/"
}
