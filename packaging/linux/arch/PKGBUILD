pkgname=multicore
pkgver=@VERSION@
pkgrel=1
pkgdesc='Native network client combining Mihomo routing with Xray transports'
arch=('x86_64')
url='https://github.com/fatyzzz/multicore'
license=('MIT OR Apache-2.0' 'MPL-2.0' 'GPL-3.0-only')
depends=('gtk3' 'libayatana-appindicator' 'polkit' 'fontconfig' 'libxkbcommon' 'libglvnd' 'iproute2' 'hicolor-icon-theme')
optdepends=('gnome-shell-extension-appindicator: tray icon in GNOME')
options=('!strip' '!debug')
source=("multicore-${pkgver}-stage.tar.zst")
sha256sums=('@SHA256@')

package() {
    cp -a "$srcdir/stage/." "$pkgdir/"
}
