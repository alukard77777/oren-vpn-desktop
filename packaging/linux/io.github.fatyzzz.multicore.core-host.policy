<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>MultiCore</vendor>
  <action id="io.github.fatyzzz.multicore.core-host">
    <description>Start the MultiCore network cores</description>
    <description xml:lang="ru">Запуск сетевых ядер MultiCore</description>
    <message>MultiCore needs administrator access to create the VPN network interface</message>
    <message xml:lang="ru">MultiCore нужны права администратора, чтобы создать сетевой интерфейс VPN</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/multicore/runtime/multicore-core-host</annotate>
  </action>
</policyconfig>
