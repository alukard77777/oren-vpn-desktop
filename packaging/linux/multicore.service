[Unit]
Description=MultiCore always-ready cores service
Documentation=https://github.com/fatyzzz/multicore
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/lib/multicore/runtime/multicore-core-host --service
Restart=on-failure
RestartSec=2
# SIGTERM goes to the service only: it switches TUN off and stops Mihomo and Xray itself;
# whatever is left after TimeoutStopSec is killed.
KillMode=mixed
TimeoutStopSec=15
# /run/multicore/service.sock lives here; the socket itself is 0666, every peer is checked.
RuntimeDirectory=multicore
RuntimeDirectoryMode=0755
# /var/lib/multicore: sanitised generations, provider caches, Mihomo home, core logs.
StateDirectory=multicore
StateDirectoryMode=0700
ProtectHome=read-only
ProtectSystem=strict
PrivateTmp=yes
NoNewPrivileges=yes
# CAP_DAC_READ_SEARCH lets root read the user's 0700 ~/.local/share/multicore/runtime.
# CAP_SYS_PTRACE lets root read a peer daemon's /proc/<pid>/exe and environ (ptrace read access);
# Mihomo keeps it too, for PROCESS-NAME/PROCESS-PATH rules. CAP_SETPCAP lets the service shrink
# each core's set before exec: Xray keeps CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW, Mihomo
# those plus CAP_SYS_PTRACE; neither gets CAP_DAC_READ_SEARCH or CAP_SETPCAP.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_DAC_READ_SEARCH CAP_SYS_PTRACE CAP_SETPCAP

[Install]
WantedBy=multi-user.target
